@model PetAdoption.Web.Models.Account.LoginVm

@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card overflow-hidden border-0">
            <div class="row g-0">
                <div class="col-lg-5 d-none d-lg-flex">
                    <div class="w-100 p-5 text-white d-flex flex-column justify-content-between"
                         style="background: linear-gradient(145deg, #172554 0%, #1d4ed8 55%, #16a34a 130%); min-height: 620px;">

                        <div>
                            <div class="d-inline-flex align-items-center gap-2 mb-5">
                                <span class="fs-3">🐾</span>
                                <span class="fw-bold fs-5">
                                    Pet Adoption
                                </span>
                            </div>

                            <h1 class="display-6 fw-bold text-white mb-4">
                                Welcome back.
                            </h1>

                            <p class="fs-5 text-white-50">
                                Continue your journey of connecting
                                wonderful pets with loving homes.
                            </p>
                        </div>

                        <div>
                            <div class="d-flex gap-3 mb-4">
                                <div class="fs-4">✓</div>
                                <div>
                                    <div class="fw-semibold">
                                        Secure accounts
                                    </div>

                                    <div class="small text-white-50">
                                        Protected with ASP.NET Core Identity.
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-3">
                                <div class="fs-4">✓</div>
                                <div>
                                    <div class="fw-semibold">
                                        Role-based experience
                                    </div>

                                    <div class="small text-white-50">
                                        Dedicated workflows for adopters,
                                        shelters and administrators.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="p-4 p-md-5 p-xl-5">
                        <div class="mb-5">
                            <div class="text-primary fw-semibold text-uppercase small mb-2">
                                Account Access
                            </div>

                            <h2 class="section-title mb-2">
                                Sign in
                            </h2>

                            <p class="text-muted mb-0">
                                Enter your credentials to access your account.
                            </p>
                        </div>

                        <form asp-action="Login"
                              method="post"
                              novalidate>

                            <input type="hidden"
                                   asp-for="ReturnUrl" />

                            <div asp-validation-summary="All"
                                 class="text-danger mb-3">
                            </div>

                            <div class="mb-4">
                                <label asp-for="Email"
                                       class="form-label">
                                </label>

                                <input asp-for="Email"
                                       class="form-control form-control-lg"
                                       autocomplete="email"
                                       placeholder="you@example.com" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password"
                                       class="form-label">
                                </label>

                                <div class="input-group">
                                    <input asp-for="Password"
                                           id="loginPassword"
                                           class="form-control form-control-lg"
                                           autocomplete="current-password"
                                           placeholder="Enter your password" />

                                    <button class="btn btn-outline-secondary"
                                            type="button"
                                            id="toggleLoginPassword">
                                        Show
                                    </button>
                                </div>

                                <span asp-validation-for="Password"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input asp-for="RememberMe"
                                           class="form-check-input" />

                                    <label asp-for="RememberMe"
                                           class="form-check-label">
                                    </label>
                                </div>
                            </div>

                            <button type="submit"
                                    class="btn btn-primary btn-lg w-100 mb-4">
                                Sign In
                            </button>

                            <div class="text-center text-muted">
                                Don't have an account?

                                <a asp-controller="Account"
                                   asp-action="Register"
                                   asp-route-returnUrl="@Model.ReturnUrl"
                                   class="fw-semibold text-decoration-none">
                                    Create one
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const passwordInput =
            document.getElementById('loginPassword');

        const togglePassword =
            document.getElementById('toggleLoginPassword');

        togglePassword.addEventListener('click', function () {
            const hidden =
                passwordInput.type === 'password';

            passwordInput.type =
                hidden ? 'text' : 'password';

            togglePassword.textContent =
                hidden ? 'Hide' : 'Show';
        });
    </script>
}