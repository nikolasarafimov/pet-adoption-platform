@model PetAdoption.Web.Models.Account.RegisterVm

@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-xl-11">
        <div class="card overflow-hidden border-0">
            <div class="row g-0">
                <div class="col-lg-4 d-none d-lg-flex">
                    <div class="w-100 p-5 text-white d-flex flex-column justify-content-between"
                         style="background: linear-gradient(145deg, #064e3b 0%, #16a34a 55%, #2563eb 130%);">

                        <div>
                            <div class="d-inline-flex align-items-center gap-2 mb-5">
                                <span class="fs-3">🐾</span>
                                <span class="fw-bold fs-5">
                                    Pet Adoption
                                </span>
                            </div>

                            <h1 class="display-6 fw-bold text-white mb-4">
                                Join the community.
                            </h1>

                            <p class="fs-5 text-white-50">
                                Create an adopter account or register your shelter
                                and start using the platform in minutes.
                            </p>
                        </div>

                        <div class="small text-white-50">
                            <div class="mb-3">
                                ✓ Discover pets available for adoption
                            </div>

                            <div class="mb-3">
                                ✓ Track adoption requests
                            </div>

                            <div>
                                ✓ Manage pets and requests as a shelter
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="p-4 p-md-5">
                        <div class="mb-4">
                            <div class="text-success fw-semibold text-uppercase small mb-2">
                                Get Started
                            </div>

                            <h2 class="section-title mb-2">
                                Create your account
                            </h2>

                            <p class="text-muted mb-0">
                                Choose whether you are registering as an adopter
                                or representing a shelter.
                            </p>
                        </div>

                        <form asp-action="Register"
                              method="post"
                              novalidate>

                            <input type="hidden"
                                   asp-for="ReturnUrl" />

                            <div asp-validation-summary="All"
                                 class="text-danger mb-3">
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="FullName"
                                           class="form-label">
                                    </label>

                                    <input asp-for="FullName"
                                           class="form-control"
                                           autocomplete="name"
                                           placeholder="Your full name" />

                                    <span asp-validation-for="FullName"
                                          class="text-danger">
                                    </span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Email"
                                           class="form-label">
                                    </label>

                                    <input asp-for="Email"
                                           class="form-control"
                                           autocomplete="email"
                                           placeholder="you@example.com" />

                                    <span asp-validation-for="Email"
                                          class="text-danger">
                                    </span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Password"
                                           class="form-label">
                                    </label>

                                    <input asp-for="Password"
                                           id="registerPassword"
                                           class="form-control"
                                           autocomplete="new-password"
                                           placeholder="Create a password" />

                                    <span asp-validation-for="Password"
                                          class="text-danger">
                                    </span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="ConfirmPassword"
                                           class="form-label">
                                    </label>

                                    <input asp-for="ConfirmPassword"
                                           class="form-control"
                                           autocomplete="new-password"
                                           placeholder="Repeat your password" />

                                    <span asp-validation-for="ConfirmPassword"
                                          class="text-danger">
                                    </span>
                                </div>
                            </div>

                            <div class="bg-light rounded-4 p-3 mt-3 mb-4">
                                <div class="small fw-semibold mb-1">
                                    Password requirements
                                </div>

                                <div class="small text-muted">
                                    At least 8 characters with uppercase,
                                    lowercase, a number and a special character.
                                </div>
                            </div>

                            <div class="border rounded-4 p-3 p-md-4 mb-4">
                                <div class="form-check form-switch">
                                    <input asp-for="IsShelter"
                                           class="form-check-input"
                                           id="isShelter"
                                           role="switch" />

                                    <label asp-for="IsShelter"
                                           class="form-check-label fw-semibold">
                                    </label>
                                </div>

                                <p class="small text-muted mb-0 mt-2">
                                    Enable this option if you are creating an
                                    account on behalf of an animal shelter.
                                </p>
                            </div>

                            <div id="shelterFields"
                                 class="border rounded-4 p-3 p-md-4 mb-4"
                                 style="display: none;">

                                <div class="d-flex align-items-center gap-2 mb-4">
                                    <div class="fs-3">
                                        🏠
                                    </div>

                                    <div>
                                        <h5 class="mb-0">
                                            Shelter Information
                                        </h5>

                                        <div class="small text-muted">
                                            Tell us about your organization.
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="ShelterName"
                                               class="form-label">
                                        </label>

                                        <input asp-for="ShelterName"
                                               class="form-control"
                                               autocomplete="organization" />

                                        <span asp-validation-for="ShelterName"
                                              class="text-danger">
                                        </span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="ShelterCity"
                                               class="form-label">
                                        </label>

                                        <input asp-for="ShelterCity"
                                               class="form-control"
                                               autocomplete="address-level2" />

                                        <span asp-validation-for="ShelterCity"
                                              class="text-danger">
                                        </span>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="ShelterAddress"
                                               class="form-label">
                                        </label>

                                        <input asp-for="ShelterAddress"
                                               class="form-control"
                                               autocomplete="street-address" />

                                        <span asp-validation-for="ShelterAddress"
                                              class="text-danger">
                                        </span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="ShelterPhone"
                                               class="form-label">
                                        </label>

                                        <input asp-for="ShelterPhone"
                                               class="form-control"
                                               autocomplete="tel" />

                                        <span asp-validation-for="ShelterPhone"
                                              class="text-danger">
                                        </span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="ShelterEmail"
                                               class="form-label">
                                        </label>

                                        <input asp-for="ShelterEmail"
                                               class="form-control"
                                               autocomplete="email" />

                                        <span asp-validation-for="ShelterEmail"
                                              class="text-danger">
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <button type="submit"
                                    class="btn btn-success btn-lg w-100 mb-4">
                                Create Account
                            </button>

                            <div class="text-center text-muted">
                                Already have an account?

                                <a asp-controller="Account"
                                   asp-action="Login"
                                   asp-route-returnUrl="@Model.ReturnUrl"
                                   class="fw-semibold text-decoration-none">
                                    Sign in
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const isShelter =
            document.getElementById('isShelter');

        const shelterFields =
            document.getElementById('shelterFields');

        function toggleShelterFields() {
            if (isShelter.checked) {
                shelterFields.style.display = 'block';

                shelterFields.animate(
                    [
                        {
                            opacity: 0,
                            transform: 'translateY(-8px)'
                        },
                        {
                            opacity: 1,
                            transform: 'translateY(0)'
                        }
                    ],
                    {
                        duration: 250,
                        easing: 'ease-out'
                    }
                );
            } else {
                shelterFields.style.display = 'none';
            }
        }

        isShelter.addEventListener(
            'change',
            toggleShelterFields
        );

        toggleShelterFields();
    </script>
}