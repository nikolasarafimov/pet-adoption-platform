@model PetAdoption.Web.Models.Account.RegisterVm

@{
    ViewData["Title"] = "Create Account";
    ViewData["Description"] = "Join PetAdoption as an adopter or shelter and become part of a community connecting pets with loving homes.";
}

<section class="pa-register" aria-labelledby="registerTitle">

    <div class="pa-register__shell">

        <aside class="pa-register__visual">

            <img src="https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&amp;fit=crop&amp;w=1400&amp;q=85"
                 alt=""
                 class="pa-register__photo"
                 decoding="async" />

            <div class="pa-register__overlay"></div>

            <div class="pa-register__visual-top">
                <span class="pa-register__visual-badge">
                    <svg class="pa-register__icon"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
                    </svg>

                    A PLACE FOR SECOND CHANCES
                </span>
            </div>

            <div class="pa-register__visual-content">

                <div class="pa-register__visual-mark">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M3 10 12 3l9 7" />
                        <path d="M5 9v11h14V9" />
                        <path d="M9 20v-6h6v6" />
                        <path d="M12 11c-2-3-5-1-4 1 1 2 4 4 4 4s3-2 4-4c1-2-2-4-4-1Z" />
                    </svg>
                </div>

                <h2>
                    A new chapter
                    <em>starts with you.</em>
                </h2>

                <p>
                    Whether you're searching for a companion
                    or helping pets find their forever homes,
                    your journey begins here.
                </p>

                <div class="pa-register__visual-features">

                    <div class="pa-register__visual-feature">
                        <span class="pa-register__feature-check">✓</span>
                        Discover pets waiting for a home
                    </div>

                    <div class="pa-register__visual-feature">
                        <span class="pa-register__feature-check">✓</span>
                        Follow your adoption requests
                    </div>

                    <div class="pa-register__visual-feature">
                        <span class="pa-register__feature-check">✓</span>
                        Manage pets and requests as a shelter
                    </div>
                </div>
            </div>

            <div class="pa-register__visual-bottom">
                <span class="pa-register__visual-line"></span>
                ADOPT · LOVE · BELONG
            </div>

            <div class="pa-register__visual-glow"
                 aria-hidden="true">
            </div>
        </aside>

        <div class="pa-register__form-panel">

            <div class="pa-register__form-inner">

                <a asp-controller="Home"
                   asp-action="Welcome"
                   class="pa-register__brand"
                   aria-label="PetAdoption home">

                    <img src="~/images/logo.png"
                         asp-append-version="true"
                         alt="PetAdoption"
                         class="pa-register__logo" />
                </a>

                <div class="pa-register__heading">

                    <div class="pa-register__eyebrow">
                        <span class="pa-register__eyebrow-line"></span>
                        START SOMETHING WONDERFUL
                    </div>

                    <h1 id="registerTitle" class="pa-register__title">
                        Join our
                        <span>community.</span>
                    </h1>

                    <p class="pa-register__subtitle">
                        Create your account and take the first step
                        toward making a meaningful difference.
                    </p>
                </div>

                <form asp-controller="Account"
                      asp-action="Register"
                      method="post"
                      asp-antiforgery="true"
                      id="registerForm"
                      class="pa-register__form">

                    <input asp-for="ReturnUrl"
                           type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="pa-register__validation"
                         role="alert">
                    </div>

                    <fieldset class="pa-register__role-section">

                        <legend class="pa-register__section-label">
                            I want to join as
                        </legend>

                        <div class="pa-register__role-grid">

                            <div class="pa-register__role-option">

                                <input asp-for="IsShelter"
                                       type="radio"
                                       value="false"
                                       id="adopterRole"
                                       class="pa-register__role-input" />

                                <label for="adopterRole"
                                       class="pa-register__role-card">

                                    <span class="pa-register__role-icon">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
                                        </svg>
                                    </span>

                                    <span class="pa-register__role-details">
                                        <strong>Adopter</strong>
                                        <small>Find your companion</small>
                                    </span>

                                    <span class="pa-register__role-indicator"
                                          aria-hidden="true"></span>
                                </label>
                            </div>

                            <div class="pa-register__role-option">

                                <input asp-for="IsShelter"
                                       type="radio"
                                       value="true"
                                       id="shelterRole"
                                       class="pa-register__role-input" />

                                <label for="shelterRole"
                                       class="pa-register__role-card">

                                    <span class="pa-register__role-icon">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="m3 10 9-7 9 7" />
                                            <path d="M5 9v11h14V9" />
                                            <path d="M9 20v-7h6v7" />
                                        </svg>
                                    </span>

                                    <span class="pa-register__role-details">
                                        <strong>Shelter</strong>
                                        <small>Manage pet adoptions</small>
                                    </span>

                                    <span class="pa-register__role-indicator"
                                          aria-hidden="true"></span>
                                </label>
                            </div>
                        </div>
                    </fieldset>

                    <div class="pa-register__section-heading">
                        <span class="pa-register__section-number">01</span>

                        <div>
                            <h2>Account details</h2>
                            <p>Tell us a little about yourself.</p>
                        </div>
                    </div>

                    <div class="pa-register__fields">

                        <div class="pa-register__field">

                            <label asp-for="FullName"
                                   class="pa-register__label">
                            </label>

                            <div class="pa-register__input-wrap">

                                <span class="pa-register__input-icon"
                                      aria-hidden="true">
                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <circle cx="12" cy="8" r="4" />
                                        <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" />
                                    </svg>
                                </span>

                                <input asp-for="FullName"
                                       class="form-control pa-register__input"
                                       autocomplete="name"
                                       placeholder="Your full name"
                                       aria-describedby="fullNameHint" />
                            </div>

                            <span id="fullNameHint"
                                  class="pa-register__field-hint">
                                @(Model.IsShelter
                                                                ? "Optional for shelter accounts."
                                                                : "Required for adopter accounts.")
                            </span>

                            <span asp-validation-for="FullName"
                                  class="pa-register__field-error"></span>
                        </div>

                        <div class="pa-register__field">

                            <label asp-for="Email"
                                   class="pa-register__label">
                            </label>

                            <div class="pa-register__input-wrap">

                                <span class="pa-register__input-icon"
                                      aria-hidden="true">
                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <rect x="3" y="5" width="18" height="14" rx="3" />
                                        <path d="m4 7 8 6 8-6" />
                                    </svg>
                                </span>

                                <input asp-for="Email"
                                       type="email"
                                       maxlength="@(Model.IsShelter ? 256 : 128)"
                                       class="form-control pa-register__input"
                                       autocomplete="email"
                                       inputmode="email"
                                       placeholder="you@example.com" />
                            </div>

                            <span asp-validation-for="Email"
                                  class="pa-register__field-error"></span>
                        </div>

                        <div class="pa-register__field">

                            <label asp-for="Password"
                                   class="pa-register__label">
                            </label>

                            <div class="pa-register__input-wrap">

                                <span class="pa-register__input-icon"
                                      aria-hidden="true">
                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <rect x="5" y="10" width="14" height="11" rx="2" />
                                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                                    </svg>
                                </span>

                                <input asp-for="Password"
                                       id="registerPassword"
                                       type="password"
                                       class="form-control pa-register__input pa-register__input--password"
                                       autocomplete="new-password"
                                       placeholder="Create a password" />

                                <button type="button"
                                        class="pa-register__password-toggle"
                                        data-pa-password-toggle="registerPassword"
                                        aria-controls="registerPassword"
                                        aria-label="Show password"
                                        aria-pressed="false">
                                    Show
                                </button>
                            </div>

                            <span asp-validation-for="Password"
                                  class="pa-register__field-error"></span>
                        </div>

                        <div class="pa-register__field">

                            <label asp-for="ConfirmPassword"
                                   class="pa-register__label">
                            </label>

                            <div class="pa-register__input-wrap">

                                <span class="pa-register__input-icon"
                                      aria-hidden="true">
                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <rect x="5" y="10" width="14" height="11" rx="2" />
                                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                                    </svg>
                                </span>

                                <input asp-for="ConfirmPassword"
                                       id="registerConfirmPassword"
                                       type="password"
                                       class="form-control pa-register__input pa-register__input--password"
                                       autocomplete="new-password"
                                       placeholder="Repeat your password" />

                                <button type="button"
                                        class="pa-register__password-toggle"
                                        data-pa-password-toggle="registerConfirmPassword"
                                        aria-controls="registerConfirmPassword"
                                        aria-label="Show password"
                                        aria-pressed="false">
                                    Show
                                </button>
                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="pa-register__field-error"></span>
                        </div>
                    </div>

                    <div class="pa-register__password-help">

                        <div class="pa-register__password-help-icon"
                             aria-hidden="true">
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" />
                                <path d="m9 12 2 2 4-4" />
                            </svg>
                        </div>

                        <div>
                            <strong>Password requirements</strong>
                            <p>
                                At least 8 characters, including uppercase
                                and lowercase letters, a number, and a symbol.
                            </p>
                        </div>
                    </div>

                    <div id="shelterFields"
                         class="pa-register__shelter-fields"
                         hidden="@(!Model.IsShelter)">

                        <div class="pa-register__section-heading">
                            <span class="pa-register__section-number">02</span>

                            <div>
                                <h2>Shelter information</h2>
                                <p>Tell us about your organization.</p>
                            </div>
                        </div>

                        <div class="pa-register__fields">

                            <div class="pa-register__field">

                                <label asp-for="ShelterName"
                                       class="pa-register__label">
                                </label>

                                <input asp-for="ShelterName"
                                       class="form-control pa-register__input pa-register__input--plain"
                                       autocomplete="organization"
                                       placeholder="Organization name" />

                                <span asp-validation-for="ShelterName"
                                      class="pa-register__field-error"></span>
                            </div>

                            <div class="pa-register__field">

                                <label asp-for="ShelterCity"
                                       class="pa-register__label">
                                </label>

                                <input asp-for="ShelterCity"
                                       class="form-control pa-register__input pa-register__input--plain"
                                       autocomplete="address-level2"
                                       placeholder="City" />

                                <span asp-validation-for="ShelterCity"
                                      class="pa-register__field-error"></span>
                            </div>

                            <div class="pa-register__field pa-register__field--full">

                                <label asp-for="ShelterAddress"
                                       class="pa-register__label">
                                </label>

                                <input asp-for="ShelterAddress"
                                       class="form-control pa-register__input pa-register__input--plain"
                                       autocomplete="street-address"
                                       placeholder="Street address" />

                                <span asp-validation-for="ShelterAddress"
                                      class="pa-register__field-error"></span>
                            </div>

                            <div class="pa-register__field">

                                <label asp-for="ShelterPhone"
                                       class="pa-register__label">
                                </label>

                                <input asp-for="ShelterPhone"
                                       type="tel"
                                       class="form-control pa-register__input pa-register__input--plain"
                                       autocomplete="tel"
                                       placeholder="+1 234 567 890" />

                                <span asp-validation-for="ShelterPhone"
                                      class="pa-register__field-error"></span>
                            </div>

                            <div class="pa-register__field">

                                <label asp-for="ShelterEmail"
                                       class="pa-register__label">
                                </label>

                                <input asp-for="ShelterEmail"
                                       type="email"
                                       class="form-control pa-register__input pa-register__input--plain"
                                       autocomplete="email"
                                       placeholder="contact@example.com" />

                                <span asp-validation-for="ShelterEmail"
                                      class="pa-register__field-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="pa-register__submit-area">

                        <button type="submit"
                                class="pa-register__submit">

                            <span>Create Account</span>

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M5 12h14" />
                                <path d="m13 6 6 6-6 6" />
                            </svg>
                        </button>

                        <p class="pa-register__submit-note">
                            Your account will be created using
                            PetAdoption's secure sign-in system.
                        </p>
                    </div>

                    <div class="pa-register__divider">
                        <span></span>
                        <span>ALREADY PART OF OUR COMMUNITY?</span>
                        <span></span>
                    </div>

                    <div class="pa-register__login-link">

                        <a asp-controller="Account"
                           asp-action="Login"
                           asp-route-returnUrl="@Model.ReturnUrl">

                            Sign in to your account

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M5 12h14" />
                                <path d="m13 6 6 6-6 6" />
                            </svg>
                        </a>
                    </div>
                </form>

                <div class="pa-register__form-footer">

                    <span class="pa-register__footer-dot"></span>

                    Made for second chances.

                    <a asp-controller="Home"
                       asp-action="Welcome">
                        Back to home
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .pa-register {
            width: 100%;
            max-width: 1260px;
            margin: clamp(18px, 3vw, 52px) auto;
        }

        .pa-register__shell {
            display: grid;
            grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.16fr);
            overflow: hidden;
            border: 1px solid rgba(23, 61, 50, 0.08);
            border-radius: 32px;
            background: #fffefa;
            box-shadow: 0 36px 100px rgba(23, 61, 50, 0.09), 0 8px 28px rgba(23, 61, 50, 0.04);
        }

        .pa-register__visual {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 920px;
            padding: clamp(30px, 3.8vw, 58px);
            overflow: hidden;
            isolation: isolate;
            background: #173d32;
            color: #fff;
        }

        .pa-register__photo {
            position: absolute;
            inset: 0;
            z-index: -3;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            filter: saturate(0.88);
            transition: transform 1.2s ease;
        }

        .pa-register__visual:hover .pa-register__photo {
            transform: scale(1.045);
        }

        .pa-register__overlay {
            position: absolute;
            inset: 0;
            z-index: -2;
            background: linear-gradient( 180deg, rgba(10, 35, 27, 0.55) 0%, rgba(10, 35, 27, 0.08) 28%, rgba(10, 35, 27, 0.55) 58%, rgba(9, 31, 24, 0.98) 100% );
        }

        .pa-register__visual-top,
        .pa-register__visual-content,
        .pa-register__visual-bottom {
            position: relative;
            z-index: 1;
        }

        .pa-register__visual-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 11px 16px;
            border: 1px solid rgba(255, 255, 255, 0.27);
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.13);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            font-size: 0.66rem;
            font-weight: 800;
            letter-spacing: 0.13em;
        }

        .pa-register__icon {
            width: 17px;
            height: 17px;
            color: #f4c57a;
        }

        .pa-register__visual-content {
            margin-top: auto;
            animation: pa-register-enter 850ms ease both;
        }

        .pa-register__visual-mark {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 54px;
            height: 54px;
            margin-bottom: 25px;
            border: 1px solid rgba(244, 197, 122, 0.34);
            border-radius: 17px;
            background: rgba(244, 197, 122, 0.13);
            color: #f4c57a;
            backdrop-filter: blur(10px);
        }

            .pa-register__visual-mark svg {
                width: 29px;
                height: 29px;
            }

        .pa-register__visual-content h2 {
            max-width: 430px;
            margin: 0;
            color: #fff;
            font-family: "Fraunces", Georgia, serif;
            font-size: clamp(2.8rem, 4vw, 4.1rem);
            font-weight: 500;
            letter-spacing: -0.055em;
            line-height: 1.12;
        }

            .pa-register__visual-content h2 em {
                display: block;
                margin-top: 4px;
                color: #f4c57a;
                font-style: normal;
            }

        .pa-register__visual-content p {
            max-width: 385px;
            margin: 22px 0 0;
            color: rgba(255, 255, 255, 0.85);
            font-size: 0.94rem;
            line-height: 1.9;
        }

        .pa-register__visual-features {
            display: grid;
            gap: 17px;
            margin-top: 37px;
        }

        .pa-register__visual-feature {
            display: flex;
            align-items: center;
            gap: 12px;
            color: rgba(255, 255, 255, 0.92);
            font-size: 0.87rem;
            font-weight: 500;
        }

        .pa-register__feature-check {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 27px;
            height: 27px;
            flex-shrink: 0;
            border: 1px solid rgba(244, 197, 122, 0.35);
            border-radius: 50%;
            background: rgba(244, 197, 122, 0.16);
            color: #f4c57a;
            font-weight: 800;
        }

        .pa-register__visual-bottom {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 55px;
            color: rgba(255, 255, 255, 0.77);
            font-size: 0.66rem;
            font-weight: 800;
            letter-spacing: 0.14em;
        }

        .pa-register__visual-line {
            width: 30px;
            height: 2px;
            border-radius: 999px;
            background: #f4c57a;
        }

        .pa-register__visual-glow {
            position: absolute;
            right: -160px;
            bottom: -190px;
            z-index: -1;
            width: 460px;
            height: 460px;
            border-radius: 50%;
            background: rgba(200, 145, 78, 0.14);
            filter: blur(85px);
            pointer-events: none;
        }

        .pa-register__form-panel {
            display: flex;
            justify-content: center;
            min-width: 0;
            padding: clamp(30px, 4.5vw, 70px);
            background: radial-gradient( circle at 100% 0%, rgba(200, 145, 78, 0.055), transparent 35% ), #fffefa;
        }

        .pa-register__form-inner {
            width: 100%;
            max-width: 550px;
            animation: pa-register-enter 650ms ease both;
        }

        .pa-register__brand {
            display: inline-flex;
            max-width: 100%;
            margin-bottom: 35px;
        }

        .pa-register__logo {
            display: block;
            width: min(100%, 230px);
            max-height: 85px;
            object-fit: contain;
            object-position: left center;
        }

        .pa-register__eyebrow {
            display: flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 17px;
            color: #9b7742;
            font-size: 0.69rem;
            font-weight: 800;
            letter-spacing: 0.15em;
        }

        .pa-register__eyebrow-line {
            width: 25px;
            height: 2px;
            background: #c8914e;
            border-radius: 999px;
        }

        .pa-register__title {
            margin: 0;
            color: #173d32;
            font-family: "Fraunces", Georgia, serif;
            font-size: clamp(2.9rem, 4.5vw, 4rem);
            font-weight: 600;
            letter-spacing: -0.06em;
            line-height: 1.1;
        }

            .pa-register__title span {
                color: #c8914e;
            }

        .pa-register__subtitle {
            max-width: 460px;
            margin: 19px 0 0;
            color: #69766e;
            font-size: 0.94rem;
            line-height: 1.85;
        }

        .pa-register__form {
            margin-top: 32px;
        }

        .pa-register__validation {
            margin-bottom: 20px;
            padding: 14px 17px;
            border: 1px solid #f2c7be;
            border-radius: 12px;
            background: #fff3f0;
            color: #a8392e;
            font-size: 0.85rem;
        }

            .pa-register__validation.validation-summary-valid {
                display: none;
            }

            .pa-register__validation ul {
                margin: 0;
                padding-left: 18px;
            }

        .pa-register__section-label {
            margin-bottom: 15px;
