@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const form = document.getElementById("registerForm");
            const roleInputs = document.querySelectorAll(
                'input[name="IsShelter"]'
            );
            const shelterFields = document.getElementById("shelterFields");

            const fullName = document.getElementById("FullName");
            const fullNameHint = document.getElementById("fullNameHint");
            const email = document.getElementById("Email");

            const shelterName = document.getElementById("ShelterName");
            const shelterCity = document.getElementById("ShelterCity");
            const shelterAddress = document.getElementById("ShelterAddress");

            if (!form || !shelterFields) {
                return;
            }

            const getSelectedRole = () => {
                const selected = Array.from(roleInputs).find(
                    input => input.checked
                );

                return selected?.value === "true";
            };

            const updateRole = (animate = false) => {
                const isShelter = getSelectedRole();
                const wasHidden = shelterFields.hidden;

                shelterFields.hidden = !isShelter;

                if (fullName) {
                    fullName.required = !isShelter;
                }

                if (fullNameHint) {
                    fullNameHint.textContent = isShelter
                        ? "Optional for shelter accounts."
                        : "Required for adopter accounts.";
                }

                if (email) {
                    email.maxLength = isShelter ? 256 : 128;
                }

                [shelterName, shelterCity, shelterAddress].forEach(
                    field => {
                        if (field) {
                            field.required = isShelter;
                        }
                    }
                );

                if (isShelter && wasHidden && animate) {
                    shelterFields.classList.remove("is-entering");

                    void shelterFields.offsetWidth;

                    shelterFields.classList.add("is-entering");
                } else {
                    shelterFields.classList.remove("is-entering");
                }
            };

            roleInputs.forEach(input => {
                input.addEventListener("change", () => {
                    updateRole(true);
                });
            });

            document.querySelectorAll(
                "[data-pa-password-toggle]"
            ).forEach(button => {
                const input = document.getElementById(
                    button.dataset.paPasswordToggle
                );

                if (!input) {
                    return;
                }

                button.addEventListener("click", () => {
                    const isHidden = input.type === "password";

                    input.type = isHidden ? "text" : "password";

                    button.textContent = isHidden ? "Hide" : "Show";

                    button.setAttribute(
                        "aria-label",
                        isHidden ? "Hide password" : "Show password"
                    );

                    button.setAttribute(
                        "aria-pressed",
                        String(isHidden)
                    );
                });
            });

            form.addEventListener("submit", event => {
                updateRole();

                if (!form.checkValidity()) {
                    event.preventDefault();
                    form.reportValidity();
                }
            }, true);

            updateRole();
        })();
    </script>
}