@model ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card p-4 p-md-5 text-center">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 mx-auto mb-4"
                 style="width: 90px; height: 90px;">
                <span class="display-6">
                    !
                </span>
            </div>

            <div class="text-danger fw-semibold text-uppercase small mb-2">
                Something Went Wrong
            </div>

            <h1 class="section-title mb-3">
                We couldn't complete your request
            </h1>

            <p class="section-subtitle mx-auto mb-4"
               style="max-width: 560px;">
                An unexpected error occurred.
                Please try again or return to the home page.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="bg-light rounded-4 p-3 mb-4 mx-auto"
                     style="max-width: 500px;">
                    <div class="small text-muted">
                        Request ID
                    </div>

                    <code>
                        @Model.RequestId
                    </code>
                </div>
            }

            <a asp-controller="Home"
               asp-action="Welcome"
               class="btn btn-primary px-4">
                Return Home
            </a>
        </div>
    </div>
</div>