@using Microsoft.AspNetCore.Identity
@inject SignInManager<PetAdoption.Infrastructure.Data.ApplicationUser> SignInManager
@inject UserManager<PetAdoption.Infrastructure.Data.ApplicationUser> UserManager

@functions {
    bool IsActive(string? controller = null, string? action = null)
    {
        var route = Context.GetRouteData();
        var currentController = route.Values["controller"]?.ToString();
        var currentAction = route.Values["action"]?.ToString();

        bool controllerMatch = string.IsNullOrEmpty(controller) ||
                               string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        bool actionMatch = string.IsNullOrEmpty(action) ||
                           string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

        return controllerMatch && actionMatch;
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? $"{t} | Pet Adoption Platform" : "Pet Adoption Platform")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body {
            padding-top: 4.5rem;
            background-color: #f8fafc;
        }

        .brand {
            font-weight: 700;
            letter-spacing: .4px;
        }

        .navbar .nav-link.active {
            font-weight: 600;
            color: #fff !important;
        }

        .page-shell {
            min-height: calc(100vh - 140px);
        }

        footer {
            border-top: 1px solid #dee2e6;
            background: #fff;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow-sm">
        <div class="container">
            <a class="navbar-brand brand" asp-controller="Home" asp-action="Welcome">🐾 Pet Adoption Platform</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="nav" class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Home", "Welcome") || IsActive("Home", "Index") ? "active" : "")"
                           asp-controller="Home" asp-action="Welcome">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Pets") ? "active" : "")"
                           asp-controller="Pets" asp-action="Index">Pets</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Breeds") ? "active" : "")"
                           asp-controller="Breeds" asp-action="Index">Dog Breeds</a>
                    </li>

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Shelters") ? "active" : "")"
                               asp-controller="Shelters" asp-action="Index">Shelters</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("AdoptersAdmin") ? "active" : "")"
                               asp-controller="AdoptersAdmin" asp-action="Index">Adopters</a>
                        </li>
                    }

                    @if (User.IsInRole("Adopter"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("AdoptionRequests", "Index") ? "active" : "")"
                               asp-controller="AdoptionRequests" asp-action="Index">My Requests</a>
                        </li>
                    }

                    @if (User.IsInRole("Shelter") || User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("AdoptionRequests", "Manage") ? "active" : "")"
                               asp-controller="AdoptionRequests" asp-action="Manage">Review Requests</a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav ms-auto align-items-lg-center">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        var name = User.FindFirst("display_name")?.Value
                        ?? User.Identity?.Name
                        ?? "User";

                        <li class="nav-item">
                            <span class="nav-link text-light">Hello, @name!</span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="ms-lg-2">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm ms-lg-2" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container page-shell py-4">
        @RenderBody()
    </main>

    <footer class="py-3 mt-4">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center small text-muted">
            <div>© @DateTime.Now.Year Pet Adoption Platform</div>
            <div>Built with ASP.NET Core MVC, EF Core, Identity, and The Dog API</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>