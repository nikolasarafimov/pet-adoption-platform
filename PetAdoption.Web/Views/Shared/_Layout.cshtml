@using Microsoft.AspNetCore.Identity
@inject SignInManager<PetAdoption.Infrastructure.Data.ApplicationUser> SignInManager
@inject UserManager<PetAdoption.Infrastructure.Data.ApplicationUser> UserManager

@functions {
    bool IsActive(string? controller = null, string? action = null)
    {
        var route = Context.GetRouteData();
        var currentController = route.Values["controller"]?.ToString();
        var currentAction = route.Values["action"]?.ToString();

        bool controllerMatch = string.IsNullOrEmpty(controller) ||
                               string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);

        bool actionMatch = string.IsNullOrEmpty(action) ||
                           string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

        return controllerMatch && actionMatch;
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? $"{t} | Pet Adoption Platform" : "Pet Adoption Platform")</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar fixed-top">
            <div class="container">
                <a class="navbar-brand app-brand" asp-controller="Home" asp-action="Welcome">
                    <span class="brand-icon">🐾</span>
                    <span>Pet Adoption Platform</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNav" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto mb-3 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Home", "Welcome") || IsActive("Home", "Index") ? "active" : "")"
                               asp-controller="Home" asp-action="Welcome">
                                Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Pets") ? "active" : "")"
                               asp-controller="Pets" asp-action="Index">
                                Pets
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Breeds") ? "active" : "")"
                               asp-controller="Breeds" asp-action="Index">
                                Dog Breeds
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(IsActive("Shelters") ? "active" : "")"
                                   asp-controller="Shelters" asp-action="Index">
                                    Shelters
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsActive("AdoptersAdmin") ? "active" : "")"
                                   asp-controller="AdoptersAdmin" asp-action="Index">
                                    Adopters
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Adopter"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(IsActive("AdoptionRequests", "Index") ? "active" : "")"
                                   asp-controller="AdoptionRequests" asp-action="Index">
                                    My Requests
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Shelter") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(IsActive("AdoptionRequests", "Manage") ? "active" : "")"
                                   asp-controller="AdoptionRequests" asp-action="Manage">
                                    Review Requests
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            var name = User.FindFirst("display_name")?.Value
                            ?? User.Identity?.Name
                            ?? "User";

                            <li class="nav-item">
                                <span class="user-chip">
                                    <span class="user-chip-dot"></span>
                                    Hello, @name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light btn-sm app-btn-light">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">
                                    Register
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-light btn-sm app-btn-solid" asp-controller="Account" asp-action="Login">
                                    Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <main class="app-main">
            <div class="container py-4 py-lg-5">
                @if (TempData["Ok"] is string ok)
                {
                    <div class="alert alert-success alert-dismissible fade show app-alert" role="alert">
                        @ok
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["Err"] is string err)
                {
                    <div class="alert alert-danger alert-dismissible fade show app-alert" role="alert">
                        @err
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="page-enter">
                    @RenderBody()
                </div>
            </div>
        </main>

        <footer class="app-footer">
            <div class="container">
                <div class="footer-inner">
                    <div>
                        <div class="footer-brand">Pet Adoption Platform</div>
                        <div class="footer-text">
                            Modern adoption workflow for shelters and adopters.
                        </div>
                    </div>
                    <div class="footer-meta">
                        <div>© @DateTime.Now.Year Pet Adoption Platform</div>
                        <div>Built with ASP.NET Core MVC, EF Core and Identity</div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>