@model IReadOnlyList<PetAdoption.Application.DTOs.ShelterDto>

@{
    ViewData["Title"] = "Shelter Management";
    ViewData["Description"] = "Manage shelter organizations, contact information, and locations on PetAdoption.";

    var shelterCount = Model.Count;
    var cityOptions = Model
        .Select(shelter => shelter.City?.Trim())
        .Where(city => !string.IsNullOrWhiteSpace(city))
        .Select(city => city!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(city => city, StringComparer.OrdinalIgnoreCase)
        .ToList();
    var cityCount = cityOptions.Count;
    var contactCount = Model.Count(shelter =>
        !string.IsNullOrWhiteSpace(shelter.Email) ||
        !string.IsNullOrWhiteSpace(shelter.Phone));
}

<div class="pa-shelters-index">
    <nav class="pa-shelters-index__breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Welcome">Home</a>
        <span aria-hidden="true">/</span>
        <span>Administration</span>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Shelters</span>
    </nav>

    <header class="pa-shelters-index__hero">
        <div class="pa-shelters-index__hero-copy">
            <span class="pa-shelters-index__eyebrow">
                <span class="pa-shelters-index__eyebrow-dot" aria-hidden="true"></span>
                ADMINISTRATIVE WORKSPACE
            </span>

            <h1>
                Stronger shelters.
                <span>Better beginnings.</span>
            </h1>

            <p>
                Keep every partner organization organized, up to date,
                and ready to help more animals find a home.
            </p>

            <div class="pa-shelters-index__hero-actions">
                <a asp-controller="Shelters" asp-action="Create"
                   class="pa-shelters-index__hero-primary">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" />
                    </svg>
                    Add new shelter
                </a>

                <a href="#shelterDirectory" class="pa-shelters-index__hero-secondary">
                    View directory
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 4v16m-6-6 6 6 6-6" />
                    </svg>
                </a>
            </div>
        </div>

        <div class="pa-shelters-index__hero-art" aria-hidden="true">
            <div class="pa-shelters-index__art-circle"></div>
            <div class="pa-shelters-index__art-circle-inner"></div>
            <svg viewBox="0 0 120 120" fill="none" stroke="currentColor"
                 stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="m16 57 44-36 44 36" />
                <path d="M29 52v49h62V52" />
                <path d="M49 101V74h22v27" />
                <path d="M60 48c3.5-5.2 11-5.4 14.7-.8 3.5 4.5 2.4 10.3-2.2 14.6L60 74 47.5 61.8c-4.6-4.3-5.7-10.1-2.2-14.6 3.7-4.6 11.2-4.4 14.7.8Z" />
            </svg>
            <span class="pa-shelters-index__art-spark pa-shelters-index__art-spark--one"></span>
            <span class="pa-shelters-index__art-spark pa-shelters-index__art-spark--two"></span>
        </div>
    </header>

    <section class="pa-shelters-index__stats" aria-label="Shelter directory overview">
        <div class="pa-shelters-index__stat">
            <div class="pa-shelters-index__stat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z" />
                    <path d="M9 21v-8h6v8" />
                </svg>
            </div>
            <div>
                <span class="pa-shelters-index__stat-value">@shelterCount</span>
                <span class="pa-shelters-index__stat-label">Registered shelters</span>
            </div>
        </div>

        <div class="pa-shelters-index__stat">
            <div class="pa-shelters-index__stat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z" />
                    <circle cx="12" cy="10" r="2.5" />
                </svg>
            </div>
            <div>
                <span class="pa-shelters-index__stat-value">@cityCount</span>
                <span class="pa-shelters-index__stat-label">Cities represented</span>
            </div>
        </div>

        <div class="pa-shelters-index__stat">
            <div class="pa-shelters-index__stat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m4 7 8 6 8-6" />
                </svg>
            </div>
            <div>
                <span class="pa-shelters-index__stat-value">@contactCount</span>
                <span class="pa-shelters-index__stat-label">With contact details</span>
            </div>
        </div>
    </section>

    <section class="pa-shelters-index__directory" id="shelterDirectory" aria-labelledby="shelterDirectoryTitle">
        <div class="pa-shelters-index__section-heading">
            <div>
                <span class="pa-shelters-index__section-kicker">ORGANIZATION MANAGEMENT</span>
                <h2 id="shelterDirectoryTitle">Shelter directory.</h2>
                <p>Find, review, and update the organizations in your network.</p>
            </div>
            <a asp-controller="Shelters" asp-action="Create"
               class="pa-shelters-index__add-link">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                Add Shelter
            </a>
        </div>

        @if (shelterCount == 0)
        {
            <div class="pa-shelters-index__empty">
                <div class="pa-shelters-index__empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z" />
                        <path d="M9 21v-8h6v8" />
                    </svg>
                </div>
                <span class="pa-shelters-index__section-kicker">READY WHEN YOU ARE</span>
                <h3>Your shelter network starts here.</h3>
                <p>Add your first shelter to begin managing organizations and their adoption listings.</p>
                <a asp-controller="Shelters" asp-action="Create"
                   class="pa-shelters-index__empty-action">
                    Add the first shelter
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                </a>
            </div>
        }
        else
        {
            <div class="pa-shelters-index__directory-panel">
                <div class="pa-shelters-index__toolbar">
                    <div class="pa-shelters-index__toolbar-search">
                        <label for="shelterDirectorySearch">Search shelters</label>
                        <div class="pa-shelters-index__search-wrap">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="10.5" cy="10.5" r="6.5" />
                                <path d="m16 16 5 5" />
                            </svg>
                            <input id="shelterDirectorySearch"
                                   type="search"
                                   placeholder="Name, address, contact, ID..."
                                   autocomplete="off" />
                        </div>
                    </div>

                    <div class="pa-shelters-index__toolbar-select">
                        <label for="shelterDirectoryCity">City</label>
                        <select id="shelterDirectoryCity">
                            <option value="">All cities</option>
                            @foreach (var city in cityOptions)
                            {
                                <option value="@city">@city</option>
                            }
                        </select>
                    </div>

                    <div class="pa-shelters-index__toolbar-select">
                        <label for="shelterDirectorySort">Sort by</label>
                        <select id="shelterDirectorySort">
                            <option value="name-asc">Name: A to Z</option>
                            <option value="name-desc">Name: Z to A</option>
                            <option value="city-asc">City: A to Z</option>
                        </select>
                    </div>

                    <button type="button" class="pa-shelters-index__reset" id="shelterDirectoryReset" hidden>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 6 18 18M18 6 6 18" />
                        </svg>
                        Clear
                    </button>
                </div>

                <div class="pa-shelters-index__list-header">
                    <div>
                        <span class="pa-shelters-index__list-status-dot" aria-hidden="true"></span>
                        <strong id="shelterDirectoryCount" aria-live="polite">@shelterCount</strong>
                        <span id="shelterDirectoryCountLabel">
                            @(shelterCount == 1 ? "shelter in the directory" : "shelters in the directory")
                        </span>
                    </div>
                    <span>Manage your partner organizations</span>
                </div>

                <div class="pa-shelters-index__table-wrap">
                    <table class="pa-shelters-index__table">
                        <thead>
                            <tr>
                                <th scope="col">Organization</th>
                                <th scope="col">Location</th>
                                <th scope="col">Contact details</th>
                                <th scope="col" class="pa-shelters-index__actions-heading">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="shelterDirectoryRows">
                            @foreach (var shelter in Model)
                            {
                                var name = string.IsNullOrWhiteSpace(shelter.Name)
                                    ? "Unnamed shelter"
                                    : shelter.Name.Trim();
                                var city = string.IsNullOrWhiteSpace(shelter.City)
                                    ? "City not provided"
                                    : shelter.City.Trim();
                                var address = string.IsNullOrWhiteSpace(shelter.Address)
                                    ? "Address not provided"
                                    : shelter.Address.Trim();
                                var email = shelter.Email?.Trim();
                                var phone = shelter.Phone?.Trim();
                                var searchText = $"{name} {city} {address} {email} {phone} {shelter.Id}";

                                <tr data-shelter-row
                                    data-name="@name"
                                    data-city="@shelter.City"
                                    data-search="@searchText">
                                    <td>
                                        <div class="pa-shelters-index__organization">
                                            <div class="pa-shelters-index__organization-icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24">
                                                    <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z" />
                                                    <path d="M9 21v-8h6v8" />
                                                </svg>
                                            </div>
                                            <div class="pa-shelters-index__organization-info">
                                                <strong>@name</strong>
                                                <span>Shelter #@shelter.Id</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="pa-shelters-index__mobile-label">Location</div>
                                        <div class="pa-shelters-index__detail">
                                            <span class="pa-shelters-index__detail-main">@city</span>
                                            <span class="pa-shelters-index__detail-sub">@address</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="pa-shelters-index__mobile-label">Contact</div>
                                        <div class="pa-shelters-index__contact">
                                            @if (!string.IsNullOrWhiteSpace(email))
                                            {
                                                <a href="mailto:@email" title="Email @name">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                                        <rect x="3" y="5" width="18" height="14" rx="2" />
                                                        <path d="m4 7 8 6 8-6" />
                                                    </svg>
                                                    <span>@email</span>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="pa-shelters-index__contact-missing">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                                        <rect x="3" y="5" width="18" height="14" rx="2" />
                                                        <path d="m4 7 8 6 8-6" />
                                                    </svg>
                                                    No email provided
                                                </span>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(phone))
                                            {
                                                <a href="tel:@phone" title="Call @name">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                                        <path d="M21 16.4v3a2 2 0 0 1-2.2 2A18 18 0 0 1 3.6 6.2 2 2 0 0 1 5.6 4h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 1.8L9 12a14 14 0 0 0 3 3l1.5-1.5a2 2 0 0 1 1.8-.6l3 .5a2 2 0 0 1 1.7 2Z" />
                                                    </svg>
                                                    <span>@phone</span>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="pa-shelters-index__contact-missing">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                                        <path d="M21 16.4v3a2 2 0 0 1-2.2 2A18 18 0 0 1 3.6 6.2 2 2 0 0 1 5.6 4h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 1.8L9 12a14 14 0 0 0 3 3l1.5-1.5a2 2 0 0 1 1.8-.6l3 .5a2 2 0 0 1 1.7 2Z" />
                                                    </svg>
                                                    No phone provided
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="pa-shelters-index__mobile-label">Manage</div>
                                        <div class="pa-shelters-index__row-actions">
                                            <a asp-controller="Shelters"
                                               asp-action="Edit"
                                               asp-route-id="@shelter.Id"
                                               class="pa-shelters-index__edit"
                                               aria-label="Edit @name">
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="m15 5 4 4M4 20l4.5-1 11-11a2.1 2.1 0 0 0-3-3l-11 11L4 20Z" />
                                                </svg>
                                                Edit
                                            </a>
                                            <a asp-controller="Shelters"
                                               asp-action="Delete"
                                               asp-route-id="@shelter.Id"
                                               class="pa-shelters-index__delete"
                                               aria-label="Delete @name">
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M4 7h16M10 4h4m-8 3 1 13h10l1-13M10 11v5m4-5v5" />
                                                </svg>
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pa-shelters-index__no-results" id="shelterDirectoryNoResults" hidden>
                    <div class="pa-shelters-index__empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <circle cx="10.5" cy="10.5" r="6.5" />
                            <path d="m16 16 5 5" />
                        </svg>
                    </div>
                    <h3>No matching shelters.</h3>
                    <p>Try a different search term or choose another city.</p>
                    <button type="button" id="shelterDirectoryEmptyReset" class="pa-shelters-index__empty-action">
                        Clear filters
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                    </button>
                </div>

                <div class="pa-shelters-index__directory-footer">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 11v5m0-8h.01" />
                    </svg>
                    Shelters linked to pet listings or user accounts cannot be deleted until those links are resolved.
                </div>
            </div>
        }
    </section>
</div>

@section Styles {
    <style>
        .pa-shelters-index { --sh-forest: var(--pa-forest, #173d32); --sh-forest-deep: var(--pa-forest-deep, #0e2b23); --sh-gold: var(--pa-gold, #c8914e); --sh-muted: var(--pa-muted, #65716a); --sh-line: var(--pa-line, #e7e8df); color: var(--pa-ink, #202c26); }
        .pa-shelters-index svg { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
        .pa-shelters-index__breadcrumb { display: flex; align-items: center; flex-wrap: wrap; gap: 11px; margin-bottom: 25px; color: #8b968f; font-size: 0.78rem; font-weight: 700; }
        .pa-shelters-index__breadcrumb a { color: #65776d; text-decoration: none; }
        .pa-shelters-index__breadcrumb a:hover { color: var(--sh-forest); }
        .pa-shelters-index__breadcrumb [aria-current] { color: var(--sh-forest); }
        .pa-shelters-index__hero { position: relative; display: flex; align-items: center; isolation: isolate; overflow: hidden; min-height: 318px; border-radius: 32px; background: linear-gradient(115deg, #102e25 0%, #174637 63%, #285642 100%); box-shadow: 0 22px 52px rgba(17, 45, 34, 0.13); }
        .pa-shelters-index__hero::after { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 78% 23%, rgba(239, 199, 134, 0.12), transparent 29%), linear-gradient(90deg, transparent, rgba(255,255,255,0.02)); pointer-events: none; }
        .pa-shelters-index__hero-copy { position: relative; z-index: 2; width: min(100%, 790px); padding: clamp(32px, 5.2vw, 67px); }
        .pa-shelters-index__eyebrow { display: inline-flex; align-items: center; gap: 9px; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.19em; color: #f0c886; }
        .pa-shelters-index__eyebrow-dot { width: 7px; height: 7px; border-radius: 50%; background: #eabd73; box-shadow: 0 0 0 4px rgba(235,189,115,0.14); }
        .pa-shelters-index__hero h1 { margin: 20px 0 17px; color: #fffaf1; font-family: "Fraunces", Georgia, serif; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1.16; }
        .pa-shelters-index__hero h1 span { display: block; color: #e7c28b; }
        .pa-shelters-index__hero p { max-width: 600px; margin: 0; color: #d2dfd5; font-size: 0.96rem; line-height: 1.75; }
        .pa-shelters-index__hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 26px; }
        .pa-shelters-index__hero-primary, .pa-shelters-index__hero-secondary { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 45px; padding: 11px 18px; border: 1px solid transparent; border-radius: 11px; font-size: 0.83rem; font-weight: 800; text-decoration: none; transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease; }
        .pa-shelters-index__hero-primary { background: #f0c98f; color: #203c2f; }
        .pa-shelters-index__hero-primary:hover { background: #ffdda8; color: #183629; transform: translateY(-2px); }
        .pa-shelters-index__hero-secondary { border-color: rgba(255,255,255,0.26); color: #f5f4ec; }
        .pa-shelters-index__hero-secondary:hover { background: rgba(255,255,255,0.09); color: #fff; }
        .pa-shelters-index__hero-actions svg { width: 17px; height: 17px; }
        .pa-shelters-index__hero-art { position: absolute; right: -18px; top: 50%; z-index: 1; width: 320px; height: 320px; color: rgba(241,209,151,0.72); transform: translateY(-50%); }
        .pa-shelters-index__art-circle, .pa-shelters-index__art-circle-inner { position: absolute; inset: 18px; border: 1px solid rgba(255,255,255,0.12); border-radius: 50%; }
        .pa-shelters-index__art-circle-inner { inset: 48px; border-color: rgba(255,255,255,0.18); background: rgba(255,255,255,0.035); }
        .pa-shelters-index__hero-art > svg { position: absolute; left: 102px; top: 102px; width: 116px; height: 116px; }
        .pa-shelters-index__art-spark { position: absolute; width: 7px; height: 7px; border-radius: 50%; background: #d7a966; }
        .pa-shelters-index__art-spark--one { top: 65px; left: 86px; }
        .pa-shelters-index__art-spark--two { right: 41px; bottom: 65px; width: 5px; height: 5px; }
        .pa-shelters-index__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 17px; margin: 23px 0 53px; }
        .pa-shelters-index__stat { display: flex; align-items: center; gap: 17px; min-width: 0; padding: 23px 26px; border: 1px solid #e9ebe4; border-radius: 19px; background: #fffefa; box-shadow: 0 8px 23px rgba(26,51,39,0.035); }
        .pa-shelters-index__stat-icon { display: grid; flex: 0 0 48px; width: 48px; height: 48px; place-items: center; border-radius: 15px; background: #eaf1e9; color: var(--sh-forest); }
        .pa-shelters-index__stat-icon svg { width: 23px; height: 23px; }
        .pa-shelters-index__stat > div:last-child { display: flex; flex-direction: column; min-width: 0; }
        .pa-shelters-index__stat-value { color: #213e31; font-size: 1.8rem; font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; }
        .pa-shelters-index__stat-label { margin-top: 6px; color: #68766d; font-size: 0.81rem; font-weight: 700; }
        .pa-shelters-index__section-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
        .pa-shelters-index__section-kicker { display: block; color: #b17a3b; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.17em; }
        .pa-shelters-index__section-heading h2 { margin: 9px 0 7px; color: #243b2e; font-family: "Fraunces", Georgia, serif; font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 600; letter-spacing: -0.04em; }
        .pa-shelters-index__section-heading p { margin: 0; color: #748077; font-size: 0.89rem; }
        .pa-shelters-index__add-link { display: inline-flex; align-items: center; gap: 9px; flex-shrink: 0; padding: 12px 17px; border-radius: 11px; background: var(--sh-forest); color: white; font-size: 0.82rem; font-weight: 800; text-decoration: none; }
        .pa-shelters-index__add-link:hover { background: #245847; color: white; }
        .pa-shelters-index__add-link svg { width: 16px; height: 16px; }
        .pa-shelters-index__directory-panel { overflow: hidden; border: 1px solid #e5e9e1; border-radius: 25px; background: #fffefa; box-shadow: 0 14px 42px rgba(22,53,39,0.045); }
        .pa-shelters-index__toolbar { display: grid; grid-template-columns: minmax(200px, 1.7fr) minmax(160px, 0.9fr) minmax(175px, 0.9fr) auto; align-items: end; gap: 13px; padding: 24px; }
        .pa-shelters-index__toolbar-search, .pa-shelters-index__toolbar-select { min-width: 0; }
        .pa-shelters-index__toolbar label { display: block; margin-bottom: 8px; color: #394e40; font-size: 0.78rem; font-weight: 800; }
        .pa-shelters-index__search-wrap { position: relative; }
        .pa-shelters-index__search-wrap svg { position: absolute; top: 50%; left: 15px; width: 18px; height: 18px; color: #83928a; transform: translateY(-50%); pointer-events: none; }
        .pa-shelters-index__toolbar input, .pa-shelters-index__toolbar select { width: 100%; height: 46px; padding: 0 13px; border: 1px solid #dce4da; border-radius: 11px; outline: none; background: #fff; color: #283b2e; font-size: 0.85rem; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
        .pa-shelters-index__toolbar input { padding-left: 44px; }
        .pa-shelters-index__toolbar input::placeholder { color: #9aa79d; }
        .pa-shelters-index__toolbar input:focus, .pa-shelters-index__toolbar select:focus { border-color: #41715a; box-shadow: 0 0 0 3px rgba(36,88,71,0.11); }
