@section Scripts {
    @if (shelterCount > 0)
    {
        <script>
            (() => {
                "use strict";

                const searchInput = document.getElementById("shelterDirectorySearch");
                const citySelect = document.getElementById("shelterDirectoryCity");
                const sortSelect = document.getElementById("shelterDirectorySort");
                const resetButton = document.getElementById("shelterDirectoryReset");
                const emptyReset = document.getElementById("shelterDirectoryEmptyReset");
                const resultCount = document.getElementById("shelterDirectoryCount");
                const resultLabel = document.getElementById("shelterDirectoryCountLabel");
                const noResults = document.getElementById("shelterDirectoryNoResults");
                const tbody = document.getElementById("shelterDirectoryRows");
                const rows = Array.from(tbody.querySelectorAll("[data-shelter-row]"));
                const normalize = (value) => (value || "").trim().toLocaleLowerCase();

                const updateDirectory = () => {
                    const query = normalize(searchInput.value);
                    const selectedCity = normalize(citySelect.value);
                    const sortMode = sortSelect.value;
                    let visibleCount = 0;

                    const sorted = [...rows].sort((first, second) => {
                        const firstName = first.dataset.name || "";
                        const secondName = second.dataset.name || "";
                        const firstCity = first.dataset.city || "";
                        const secondCity = second.dataset.city || "";

                        if (sortMode === "name-desc") {
                            return secondName.localeCompare(firstName, undefined, { sensitivity: "base" });
                        }

                        if (sortMode === "city-asc") {
                            return firstCity.localeCompare(secondCity, undefined, { sensitivity: "base" })
                                || firstName.localeCompare(secondName, undefined, { sensitivity: "base" });
                        }

                        return firstName.localeCompare(secondName, undefined, { sensitivity: "base" });
                    });

                    sorted.forEach((row) => {
                        const matchesSearch = normalize(row.dataset.search).includes(query);
                        const matchesCity = !selectedCity || normalize(row.dataset.city) === selectedCity;
                        const isVisible = matchesSearch && matchesCity;

                        row.hidden = !isVisible;
                        if (isVisible) visibleCount += 1;
                        tbody.appendChild(row);
                    });

                    resultCount.textContent = String(visibleCount);
                    resultLabel.textContent = visibleCount === 1
                        ? "shelter found"
                        : "shelters found";
                    noResults.hidden = visibleCount !== 0;
                    resetButton.hidden = !query && !selectedCity && sortMode === "name-asc";
                };

                const resetDirectory = () => {
                    searchInput.value = "";
                    citySelect.value = "";
                    sortSelect.value = "name-asc";
                    updateDirectory();
                    searchInput.focus();
                };

                searchInput.addEventListener("input", updateDirectory);
                citySelect.addEventListener("change", updateDirectory);
                sortSelect.addEventListener("change", updateDirectory);
                resetButton.addEventListener("click", resetDirectory);
                emptyReset.addEventListener("click", resetDirectory);
                updateDirectory();
            })();
        </script>
    }
}