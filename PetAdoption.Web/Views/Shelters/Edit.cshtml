@model PetAdoption.Web.Models.Shelters.ShelterFormVm

@{
    ViewData["Title"] = "Edit Shelter";
    ViewData["Description"] = "Update the shelter organization profile and contact information.";
}

<div class="pa-shelter-edit">
    <nav class="pa-shelter-edit__breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Welcome">Home</a>
        <span aria-hidden="true">/</span>
        <span>Administration</span>
        <span aria-hidden="true">/</span>
        <a asp-controller="Shelters" asp-action="Index">Shelters</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Edit Shelter</span>
    </nav>

    <header class="pa-shelter-edit__hero">
        <div class="pa-shelter-edit__hero-copy">
            <span class="pa-shelter-edit__eyebrow">
                <span class="pa-shelter-edit__eyebrow-dot" aria-hidden="true"></span>
                SHELTER MANAGEMENT WORKSPACE
            </span>

            <h1>
                Keep every detail.
                <span>Up to date.</span>
            </h1>

            <p>
                Keep this shelter’s public information accurate, helpful, and easy to find.
                A few thoughtful updates can make every adoption journey smoother.
            </p>

            <a asp-controller="Shelters" asp-action="Index"
               class="pa-shelter-edit__hero-back">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 12H5m6-6-6 6 6 6" />
                </svg>
                Back to Shelter Directory
            </a>
        </div>

        <div class="pa-shelter-edit__hero-art" aria-hidden="true">
            <div class="pa-shelter-edit__art-circle"></div>
            <div class="pa-shelter-edit__art-circle-inner"></div>
            <svg viewBox="0 0 120 120" fill="none" stroke="currentColor"
                 stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="m16 57 44-36 44 36" />
                <path d="M29 52v49h62V52" />
                <path d="M49 101V74h22v27" />
                <path d="M60 48c3.5-5.2 11-5.4 14.7-.8 3.5 4.5 2.4 10.3-2.2 14.6L60 74 47.5 61.8c-4.6-4.3-5.7-10.1-2.2-14.6 3.7-4.6 11.2-4.4 14.7.8Z" />
            </svg>
            <span class="pa-shelter-edit__spark pa-shelter-edit__spark--one"></span>
            <span class="pa-shelter-edit__spark pa-shelter-edit__spark--two"></span>
        </div>
    </header>

    <div class="pa-shelter-edit__layout">
        <div class="pa-shelter-edit__main">
            <form asp-controller="Shelters"
                  asp-action="Edit"
                  method="post"
                  asp-antiforgery="true"
                  novalidate
                  id="shelterEditForm">
                <input asp-for="Id" type="hidden" />
                <section class="pa-shelter-edit__panel" aria-labelledby="shelterEditHeading">
                    <div class="pa-shelter-edit__panel-top">
                        <div class="pa-shelter-edit__panel-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z" />
                                <path d="M9 21v-8h6v8" />
                            </svg>
                        </div>
                        <div>
                            <span class="pa-shelter-edit__section-kicker">SECTION 01 · UPDATE ORGANIZATION</span>
                            <h2 id="shelterEditHeading">Refine the shelter profile.</h2>
                            <p>Review the existing information and make any necessary updates.</p>
                        </div>
                    </div>

                    <div class="pa-shelter-edit__form-content">
                        <partial name="_ShelterForm" model="Model" />
                    </div>

                    <div class="pa-shelter-edit__form-note">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 11v5m0-8h.01" />
                        </svg>
                        <p>
                            <strong>Before you continue:</strong>
                            Review the name and location carefully. Changes are saved only after
                            you select Save Changes. Linked pets and accounts remain associated
                            with the same shelter.
                        </p>
                    </div>

                    <div class="pa-shelter-edit__form-actions">
                        <button type="submit" class="pa-shelter-edit__submit" id="shelterEditSubmit">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m5 12 4 4L19 6" />
                            </svg>
                            Save Changes
                        </button>
                        <a asp-controller="Shelters" asp-action="Index"
                           class="pa-shelter-edit__cancel">Cancel</a>
                    </div>
                </section>
            </form>
        </div>

        <aside class="pa-shelter-edit__aside" aria-label="Shelter preview and guidance">
            <section class="pa-shelter-edit__preview" aria-labelledby="shelterPreviewHeading">
                <div class="pa-shelter-edit__preview-heading">
                    <div>
                        <span class="pa-shelter-edit__section-kicker">LIVE PREVIEW</span>
                        <h2 id="shelterPreviewHeading">Live directory preview.</h2>
                    </div>
                    <span class="pa-shelter-edit__preview-indicator" id="shelterEditState" aria-live="polite">
                        <span aria-hidden="true"></span>
                        <span id="shelterEditStateLabel">Loaded profile</span>
                    </span>
                </div>

                <div class="pa-shelter-edit__preview-cover" aria-hidden="true">
                    <div class="pa-shelter-edit__preview-cover-circle"></div>
                    <svg viewBox="0 0 100 100" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m12 48 38-32 38 32" />
                        <path d="M23 43v43h54V43" />
                        <path d="M41 86V63h18v23" />
                        <path d="M50 39c2.7-4 8.6-4.1 11.6-.7 3.2 3.7 2.1 8.3-1.7 11.9L50 60l-9.9-9.8c-3.8-3.6-4.9-8.2-1.7-11.9 3-3.4 8.9-3.3 11.6.7Z" />
                    </svg>
                </div>

                <div class="pa-shelter-edit__preview-body">
                    <div class="pa-shelter-edit__preview-identity">
                        <span class="pa-shelter-edit__preview-avatar" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z" />
                                <path d="M9 21v-8h6v8" />
                            </svg>
                        </span>
                        <div>
                            <h3 id="previewShelterName">@Model.Name</h3>
                            <span>Shelter #@Model.Id</span>
                        </div>
                    </div>

                    <div class="pa-shelter-edit__preview-details">
                        <div class="pa-shelter-edit__preview-detail">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z" />
                                <circle cx="12" cy="10" r="2.5" />
                            </svg>
                            <div>
                                <span>Location</span>
                                <strong id="previewShelterCity">@Model.City</strong>
                                <small id="previewShelterAddress">@Model.Address</small>
                            </div>
                        </div>

                        <div class="pa-shelter-edit__preview-detail">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M20 16.5v2.6a2 2 0 0 1-2.2 2A17.8 17.8 0 0 1 2.9 6.2 2 2 0 0 1 4.9 4h2.6a2 2 0 0 1 2 1.7l.5 2.5a2 2 0 0 1-.6 1.9L7.8 11.7a14 14 0 0 0 4.5 4.5l1.6-1.6a2 2 0 0 1 1.9-.6l2.5.5a2 2 0 0 1 1.7 2Z" />
                            </svg>
                            <div>
                                <span>Phone</span>
                                <strong id="previewShelterPhone">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Not provided" : Model.Phone)</strong>
                            </div>
                        </div>

                        <div class="pa-shelter-edit__preview-detail">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="3" y="5" width="18" height="14" rx="2" />
                                <path d="m4 7 8 6 8-6" />
                            </svg>
                            <div>
                                <span>Email</span>
                                <strong id="previewShelterEmail">@(string.IsNullOrWhiteSpace(Model.Email) ? "Not provided" : Model.Email)</strong>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="pa-shelter-edit__preview-footer">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" />
                    </svg>
                    Changes appear here as you type
                </div>
            </section>

            <section class="pa-shelter-edit__progress-card" aria-labelledby="shelterProgressHeading">
                <div class="pa-shelter-edit__progress-top">
                    <div>
                        <span class="pa-shelter-edit__section-kicker">PROFILE CHECKLIST</span>
                        <h2 id="shelterProgressHeading">Profile essentials.</h2>
                    </div>
                    <span class="pa-shelter-edit__progress-count" id="shelterRequiredCount">0 / 3</span>
                </div>

                <div class="pa-shelter-edit__progress-track"
                     role="progressbar" aria-label="Required shelter fields completed"
                     aria-valuemin="0" aria-valuemax="3" aria-valuenow="0"
                     id="shelterRequiredProgress">
                    <span id="shelterRequiredBar"></span>
                </div>

                <ul class="pa-shelter-edit__checklist">
                    <li data-required-field="Name">
                        <span class="pa-shelter-edit__check" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg>
                        </span>
                        Shelter name
                    </li>
                    <li data-required-field="City">
                        <span class="pa-shelter-edit__check" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg>
                        </span>
                        City
                    </li>
                    <li data-required-field="Address">
                        <span class="pa-shelter-edit__check" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg>
                        </span>
                        Street address
                    </li>
                </ul>

                <p class="pa-shelter-edit__progress-help" id="shelterProgressMessage">
                    Review the required fields before saving your changes.
                </p>
            </section>
        </aside>
    </div>
</div>

@section Styles {
    <style>
        .pa-shelter-edit { --sh-forest: var(--pa-forest, #173d32); --sh-forest-deep: var(--pa-forest-deep, #0e2b23); --sh-gold: var(--pa-gold, #c8914e); --sh-muted: var(--pa-muted, #65716a); --sh-line: var(--pa-line, #e7e8df); color: var(--pa-ink, #202c26); }
        .pa-shelter-edit svg { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
        .pa-shelter-edit__breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 11px; margin-bottom: 25px; color: #89968e; font-size: .78rem; font-weight: 700; }
        .pa-shelter-edit__breadcrumb a { color: #65776d; text-decoration: none; }
        .pa-shelter-edit__breadcrumb a:hover, .pa-shelter-edit__breadcrumb [aria-current] { color: var(--sh-forest); }
        .pa-shelter-edit__hero { position: relative; display: flex; align-items: center; isolation: isolate; overflow: hidden; min-height: 320px; border-radius: 32px; background: linear-gradient(115deg, #102e25 0%, #174637 63%, #285642 100%); box-shadow: 0 22px 52px rgba(17,45,34,.13); }
        .pa-shelter-edit__hero::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at 78% 23%, rgba(239,199,134,.12), transparent 29%); }
        .pa-shelter-edit__hero-copy { position: relative; z-index: 2; padding: clamp(32px, 5.2vw, 67px); width: min(100%, 790px); }
        .pa-shelter-edit__eyebrow { display: inline-flex; align-items: center; gap: 9px; color: #f0c886; font-size: .7rem; font-weight: 800; letter-spacing: .18em; }
        .pa-shelter-edit__eyebrow-dot { width: 7px; height: 7px; border-radius: 50%; background: #eabd73; box-shadow: 0 0 0 4px rgba(235,189,115,.14); }
        .pa-shelter-edit__hero h1 { margin: 20px 0 17px; color: #fffaf1; font-family: "Fraunces", Georgia, serif; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 600; letter-spacing: -.04em; line-height: 1.16; }
        .pa-shelter-edit__hero h1 span { display: block; color: #e7c28b; }
        .pa-shelter-edit__hero p { max-width: 600px; margin: 0; color: #d2dfd5; font-size: .96rem; line-height: 1.75; }
        .pa-shelter-edit__hero-back { display: inline-flex; align-items: center; gap: 10px; margin-top: 26px; padding: 11px 16px; min-height: 44px; color: #fff6e7; font-size: .84rem; font-weight: 750; text-decoration: none; border: 1px solid rgba(255,255,255,.27); border-radius: 11px; transition: background .2s ease, transform .2s ease; }
        .pa-shelter-edit__hero-back:hover { color: #fff; background: rgba(255,255,255,.09); transform: translateY(-2px); }
        .pa-shelter-edit__hero-back svg { width: 17px; height: 17px; }
        .pa-shelter-edit__hero-art { position: absolute; z-index: 1; top: 0; right: 2%; width: 35%; height: 100%; display: grid; place-items: center; color: #ebcb98; pointer-events: none; }
        .pa-shelter-edit__art-circle { position: absolute; width: min(26vw, 290px); aspect-ratio: 1; border-radius: 50%; border: 1px solid rgba(239,209,160,.19); box-shadow: 0 0 0 30px rgba(255,255,255,.018), 0 0 0 75px rgba(255,255,255,.014); }
        .pa-shelter-edit__art-circle-inner { position: absolute; width: min(19vw, 216px); aspect-ratio: 1; border-radius: 50%; background: rgba(236,199,140,.085); }
        .pa-shelter-edit__hero-art > svg { z-index: 2; width: min(11vw, 140px); height: auto; opacity: .85; }
        .pa-shelter-edit__spark { position: absolute; z-index: 3; width: 8px; height: 8px; border-radius: 2px; transform: rotate(45deg); background: #e5ba78; }
        .pa-shelter-edit__spark--one { top: 19%; right: 16%; }
        .pa-shelter-edit__spark--two { bottom: 19%; left: 18%; width: 5px; height: 5px; opacity: .7; }
        .pa-shelter-edit__layout { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(300px, 1fr); align-items: start; gap: 25px; margin-top: 30px; }
        .pa-shelter-edit__main, .pa-shelter-edit__aside { min-width: 0; }
        .pa-shelter-edit__aside { display: grid; gap: 20px; position: sticky; top: 100px; }
        .pa-shelter-edit__panel, .pa-shelter-edit__preview, .pa-shelter-edit__progress-card { background: #fff; border: 1px solid var(--sh-line); border-radius: 23px; box-shadow: 0 12px 36px rgba(25,54,40,.045); overflow: hidden; }
        .pa-shelter-edit__panel { padding: clamp(23px, 3.2vw, 40px); }
        .pa-shelter-edit__panel-top { display: flex; align-items: flex-start; gap: 17px; padding-bottom: 25px; border-bottom: 1px solid #edf0e9; }
        .pa-shelter-edit__panel-icon { display: grid; place-items: center; width: 51px; height: 51px; border: 1px solid #d9e9dc; border-radius: 15px; background: #edf5ed; color: #32604c; }
        .pa-shelter-edit__panel-icon svg { width: 25px; height: 25px; }
        .pa-shelter-edit__section-kicker { color: #aa7b40; font-size: .68rem; line-height: 1.5; font-weight: 800; letter-spacing: .15em; }
        .pa-shelter-edit__panel h2, .pa-shelter-edit__preview h2, .pa-shelter-edit__progress-card h2 { margin: 7px 0 7px; font-family: "Fraunces", Georgia, serif; font-size: clamp(1.25rem, 2.1vw, 1.62rem); font-weight: 600; letter-spacing: -.027em; }
        .pa-shelter-edit__panel-top p { margin: 0; color: var(--sh-muted); font-size: .86rem; line-height: 1.65; }
        .pa-shelter-edit__form-content { padding-top: 26px; }
        .pa-shelter-edit__form-content > .mb-4 { margin-bottom: 24px !important; }
        .pa-shelter-edit__form-content > .mb-4 h5 { margin-bottom: 6px !important; font-size: 1rem; font-weight: 800; letter-spacing: -.025em; }
        .pa-shelter-edit__form-content > .mb-4 p { color: var(--sh-muted); font-size: .82rem; line-height: 1.6; }
        .pa-shelter-edit__form-content .row { --bs-gutter-x: 18px; --bs-gutter-y: 25px; }
        .pa-shelter-edit__form-content .form-label { display: inline-block; margin-bottom: 9px; color: #304339; font-size: .82rem; font-weight: 800; }
        .pa-shelter-edit__form-content .form-control { width: 100%; min-height: 51px; padding: 13px 15px; color: #24382d; background: #fcfdf9; border: 1px solid #dce5db; border-radius: 12px; font-size: .89rem; box-shadow: none; transition: border-color .2s ease, box-shadow .2s ease, background .2s ease; }
        .pa-shelter-edit__form-content .form-control::placeholder { color: #99a49c; }
        .pa-shelter-edit__form-content .form-control:hover { border-color: #b8cab9; }
        .pa-shelter-edit__form-content .form-control:focus { color: #24382d; background: #fff; border-color: #729b7c; box-shadow: 0 0 0 4px rgba(86,139,99,.12); }
        .pa-shelter-edit__form-content .form-control.input-validation-error { border-color: #cb6a6a; background: #fffafa; }
        .pa-shelter-edit__form-content .field-validation-error { display: block; margin-top: 7px; color: #b84747 !important; font-size: .75rem; line-height: 1.55; }
        .pa-shelter-edit__form-content .validation-summary-valid { display: none; }
        .pa-shelter-edit__form-content .validation-summary-errors { padding: 14px 17px; border: 1px solid #f2c8c8; border-radius: 12px; background: #fff5f5; color: #a03939; font-size: .84rem; }
        .pa-shelter-edit__form-content .validation-summary-errors ul { margin: 0; padding-left: 19px; }
        .pa-shelter-edit__form-note { display: flex; align-items: flex-start; gap: 12px; padding: 17px 18px; margin-top: 34px; border: 1px solid #dcebdc; border-radius: 14px; background: #f4f9f3; }
        .pa-shelter-edit__form-note svg { width: 19px; height: 19px; margin-top: 2px; color: #416f51; }
        .pa-shelter-edit__form-note p { margin: 0; color: #5c7261; font-size: .8rem; line-height: 1.7; }
        .pa-shelter-edit__form-note strong { color: #30503b; }
        .pa-shelter-edit__form-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 30px; padding-top: 27px; border-top: 1px solid #ebeee7; }
        .pa-shelter-edit__submit, .pa-shelter-edit__cancel { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 49px; padding: 13px 21px; border-radius: 12px; font-size: .85rem; font-weight: 800; text-decoration: none; transition: transform .2s ease, background .2s ease, box-shadow .2s ease; }
        .pa-shelter-edit__submit { color: #fff; background: var(--sh-forest); border: 1px solid var(--sh-forest); box-shadow: 0 7px 18px rgba(23,61,50,.14); }
        .pa-shelter-edit__submit:hover { color: #fff; background: #285845; border-color: #285845; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(23,61,50,.18); }
        .pa-shelter-edit__submit svg { width: 18px; height: 18px; }
        .pa-shelter-edit__cancel { border: 1px solid #dce4d9; background: #fff; color: #4d6355; }
        .pa-shelter-edit__cancel:hover { color: #234736; background: #f4f8f2; }
        .pa-shelter-edit__preview-heading, .pa-shelter-edit__progress-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; padding: 22px 24px 20px; }
        .pa-shelter-edit__preview-heading h2, .pa-shelter-edit__progress-card h2 { font-size: 1.35rem; margin-bottom: 0; }
        .pa-shelter-edit__preview-indicator { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border-radius: 100px; background: #f5efe5; color: #98713f; font-size: .7rem; font-weight: 800; white-space: nowrap; }
        .pa-shelter-edit__preview-indicator span { width: 6px; height: 6px; border-radius: 50%; background: #c8914e; }
        .pa-shelter-edit__preview-indicator #shelterEditStateLabel { width: auto; height: auto; border-radius: 0; background: transparent; }
        .pa-shelter-edit__preview-indicator.is-modified { color: #7a5630; background: #fff0d6; }
        .pa-shelter-edit__preview-cover { position: relative; display: grid; place-items: center; height: 128px; overflow: hidden; background: linear-gradient(125deg, #1b4838, #35644c); color: #f0d19b; }
        .pa-shelter-edit__preview-cover-circle { position: absolute; width: 190px; aspect-ratio: 1; border-radius: 50%; background: rgba(235,202,150,.1); box-shadow: 0 0 0 25px rgba(255,255,255,.025), 0 0 0 52px rgba(255,255,255,.02); }
        .pa-shelter-edit__preview-cover svg { position: relative; width: 74px; height: 74px; }
        .pa-shelter-edit__preview-body { padding: 22px 24px 12px; }
        .pa-shelter-edit__preview-identity { display: flex; align-items: center; gap: 12px; padding-bottom: 20px; border-bottom: 1px solid #e9eee7; }
        .pa-shelter-edit__preview-avatar { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 13px; background: #edf4eb; color: #2b6545; }
        .pa-shelter-edit__preview-identity h3 { margin: 0 0 4px; overflow-wrap: anywhere; font-size: 1rem; font-weight: 800; }
        .pa-shelter-edit__preview-identity div > span { color: #7a8c7d; font-size: .73rem; font-weight: 650; }
        .pa-shelter-edit__preview-details { display: grid; gap: 18px; padding: 22px 0 12px; }
        .pa-shelter-edit__preview-detail { display: flex; align-items: flex-start; gap: 12px; min-width: 0; }
        .pa-shelter-edit__preview-detail > svg { width: 18px; height: 18px; margin-top: 2px; color: #64816c; }
        .pa-shelter-edit__preview-detail div { min-width: 0; }
        .pa-shelter-edit__preview-detail span { display: block; margin-bottom: 3px; color: #89968d; font-size: .71rem; font-weight: 700; }
        .pa-shelter-edit__preview-detail strong { display: block; color: #314638; font-size: .82rem; line-height: 1.5; overflow-wrap: anywhere; }
        .pa-shelter-edit__preview-detail small { display: block; color: #89968d; font-size: .74rem; line-height: 1.55; overflow-wrap: anywhere; }
        .pa-shelter-edit__preview-footer { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 14px; border-top: 1px solid #edf0eb; background: #fbfcf9; color: #7c8b7d; font-size: .75rem; font-weight: 700; }
        .pa-shelter-edit__preview-footer svg { width: 15px; height: 15px; }
        .pa-shelter-edit__progress-top { padding-bottom: 13px; }
        .pa-shelter-edit__progress-count { color: #2d6545; font-size: .8rem; font-weight: 800; white-space: nowrap; }
        .pa-shelter-edit__progress-track { height: 7px; margin: 0 24px 22px; overflow: hidden; border-radius: 30px; background: #eaf0e9; }
        .pa-shelter-edit__progress-track span { display: block; width: 0; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #32744d, #8cbb85); transition: width .25s ease; }
        .pa-shelter-edit__checklist { display: grid; gap: 13px; margin: 0; padding: 0 24px 21px; list-style: none; }
