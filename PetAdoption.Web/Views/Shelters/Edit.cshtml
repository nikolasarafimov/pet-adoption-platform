        .pa-shelter-edit__check { display: grid; place-items: center; width: 22px; height: 22px; border: 1px solid #dbe4da; border-radius: 50%; background: #f6f8f5; color: #b0c0af; transition: background .2s ease, border-color .2s ease, color .2s ease; }
        .pa-shelter-edit__check svg { width: 13px; height: 13px; }
        .pa-shelter-edit__checklist li.is-complete { color: #2b6142; }
        .pa-shelter-edit__checklist li.is-complete .pa-shelter-edit__check { border-color: #397a51; background: #397a51; color: #fff; }
        .pa-shelter-edit__progress-help { margin: 0; padding: 14px 24px 20px; border-top: 1px solid #edf0e9; color: #7e8b80; font-size: .76rem; line-height: 1.6; }
        .pa-shelter-edit :is(a, button, input):focus-visible { outline: 3px solid #c8914e; outline-offset: 3px; }
        @@media (max-width: 1100px) { .pa-shelter-edit__layout { grid-template-columns: minmax(0, 1.35fr) minmax(275px, 1fr); gap: 18px; } .pa-shelter-edit__hero-art { right: -3%; } }
        @@media (max-width: 880px) { .pa-shelter-edit__layout { grid-template-columns: 1fr; } .pa-shelter-edit__aside { position: static; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; } .pa-shelter-edit__hero-art { opacity: .45; right: -4%; } .pa-shelter-edit__hero-copy { width: min(100%, 700px); } }
        @@media (max-width: 610px) { .pa-shelter-edit__hero { min-height: 0; border-radius: 22px; } .pa-shelter-edit__hero-copy { padding: 34px 25px 38px; } .pa-shelter-edit__hero-art { opacity: .2; right: -12%; width: 60%; } .pa-shelter-edit__hero-art > svg { width: 100px; } .pa-shelter-edit__hero h1 { font-size: 2.1rem; } .pa-shelter-edit__panel { padding: 22px 18px; } .pa-shelter-edit__panel-top { gap: 12px; } .pa-shelter-edit__panel-icon { width: 43px; height: 43px; } .pa-shelter-edit__panel-icon svg { width: 22px; height: 22px; } .pa-shelter-edit__aside { grid-template-columns: 1fr; } .pa-shelter-edit__form-actions { flex-direction: column; align-items: stretch; } .pa-shelter-edit__submit, .pa-shelter-edit__cancel { width: 100%; } .pa-shelter-edit__preview-heading, .pa-shelter-edit__progress-top { padding-inline: 19px; } .pa-shelter-edit__preview-body { padding-inline: 19px; } .pa-shelter-edit__progress-track { margin-inline: 19px; } .pa-shelter-edit__checklist { padding-inline: 19px; } .pa-shelter-edit__progress-help { padding-inline: 19px; } }
        @@media (prefers-reduced-motion: reduce) { .pa-shelter-edit *, .pa-shelter-edit *::before, .pa-shelter-edit *::after { scroll-behavior: auto !important; transition-duration: 0s !important; animation-duration: 0s !important; } }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById('shelterEditForm');
            if (!form) return;

            const fields = {
                Name: form.querySelector('[name="Name"]'),
                City: form.querySelector('[name="City"]'),
                Address: form.querySelector('[name="Address"]'),
                Phone: form.querySelector('[name="Phone"]'),
                Email: form.querySelector('[name="Email"]')
            };

            const initialValues = Object.fromEntries(
                Object.entries(fields).map(([name, input]) => [name, input?.value ?? ''])
            );

            const previewFields = {
                Name: document.getElementById('previewShelterName'),
                City: document.getElementById('previewShelterCity'),
                Address: document.getElementById('previewShelterAddress'),
                Phone: document.getElementById('previewShelterPhone'),
                Email: document.getElementById('previewShelterEmail')
            };

            const placeholders = {
                Name: 'Shelter name',
                City: 'City not provided',
                Address: 'Address not provided',
                Phone: 'Not provided',
                Email: 'Not provided'
            };

            const requiredFields = ['Name', 'City', 'Address'];
            const progress = document.getElementById('shelterRequiredProgress');
            const progressBar = document.getElementById('shelterRequiredBar');
            const progressCount = document.getElementById('shelterRequiredCount');
            const progressMessage = document.getElementById('shelterProgressMessage');
            const stateIndicator = document.getElementById('shelterEditState');
            const stateLabel = document.getElementById('shelterEditStateLabel');

            function updatePreview() {
                Object.entries(fields).forEach(([name, input]) => {
                    if (!input || !previewFields[name]) return;
                    previewFields[name].textContent = input.value.trim() || placeholders[name];
                });

                let completed = 0;
                requiredFields.forEach(name => {
                    const complete = Boolean(fields[name]?.value.trim());
                    if (complete) completed++;
                    const checklistItem = document.querySelector(`[data-required-field="${name}"]`);
                    checklistItem?.classList.toggle('is-complete', complete);
                });

                const dirty = Object.entries(fields).some(([name, input]) =>
                    Boolean(input && input.value !== initialValues[name])
                );

                progress?.setAttribute('aria-valuenow', String(completed));
                if (progressBar) progressBar.style.width = `${(completed / requiredFields.length) * 100}%`;
                if (progressCount) progressCount.textContent = `${completed} / ${requiredFields.length}`;
                if (progressMessage) {
                    progressMessage.textContent = completed === requiredFields.length
                        ? 'All required details are complete. Review any updates before saving.'
                        : 'Fill in all required fields before saving your changes.';
                }
                stateIndicator?.classList.toggle('is-modified', dirty);
                if (stateLabel) stateLabel.textContent = dirty ? 'Unsaved edits' : 'Loaded profile';
            }

            Object.values(fields).forEach(input => {
                if (!input) return;
                input.addEventListener('input', updatePreview);
                input.addEventListener('change', updatePreview);
            });

            form.addEventListener('reset', () => requestAnimationFrame(updatePreview));
            updatePreview();
        })();
    </script>
}