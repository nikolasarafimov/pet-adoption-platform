@model PetAdoption.Web.Models.Shelters.ShelterFormVm

@{
    ViewData["Title"] = "Add Shelter";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <section class="mb-4">
            <a asp-action="Index"
               class="btn btn-sm btn-outline-secondary mb-4">
                ← Back to Shelters
            </a>

            <div class="text-primary fw-semibold text-uppercase small mb-2">
                Administration
            </div>

            <h1 class="section-title mb-2">
                Add Shelter
            </h1>

            <p class="section-subtitle mb-0">
                Register a new shelter on the platform.
            </p>
        </section>

        <div class="card p-4 p-md-5">
            <form asp-action="Create"
                  method="post">

                <partial name="_ShelterForm"
                         for="@Model" />

                <div class="d-flex flex-column flex-sm-row gap-2 mt-5">
                    <button type="submit"
                            class="btn btn-success px-4">
                        Create Shelter
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}