@model PetAdoption.Application.DTOs.ShelterDto
@{
    ViewData["Title"] = "Delete Shelter";
}
<h3 class="mb-3 text-danger">Delete Shelter</h3>

<div class="alert alert-warning">
    <strong>Are you sure?</strong> Deleting <em>@Model.Name</em> is permanent.
    If the shelter has pets, deletion will fail.
</div>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Address</dt>
    <dd class="col-sm-10">@Model.Address</dd>
    <dt class="col-sm-2">City</dt>
    <dd class="col-sm-10">@Model.City</dd>
    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@Model.Phone</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button class="btn btn-danger" type="submit">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
