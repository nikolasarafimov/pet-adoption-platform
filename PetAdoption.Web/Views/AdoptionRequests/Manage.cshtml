                padding: 19px;
            }

            .pa-manage__request-identity {
                gap: 11px;
            }

            .pa-manage__pet-icon {
                width: 51px;
                height: 51px;
                border-radius: 15px;
            }

                .pa-manage__pet-icon svg {
                    width: 28px;
                    height: 28px;
                }

            .pa-manage__request-top {
                flex-direction: column;
                align-items: flex-start;
            }

            .pa-manage__adopter,
            .pa-manage__message {
                padding: 17px;
            }

            .pa-manage__request-meta {
                flex-direction: column;
                gap: 16px;
            }

            .pa-manage__decision-actions {
                width: 100%;
                flex-direction: column;
            }

            .pa-manage__decision-form,
            .pa-manage__approve,
            .pa-manage__reject {
                width: 100%;
            }

            .pa-manage__guidance {
                padding: 22px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .pa-manage__hero-content,
            .pa-manage__hero-art {
                animation: none;
            }

            .pa-manage__stat,
            .pa-manage__request,
            .pa-manage__approve,
            .pa-manage__reject {
                transition: none;
            }

                .pa-manage__stat:hover,
                .pa-manage__request:hover,
                .pa-manage__approve:hover,
                .pa-manage__reject:hover {
                    transform: none;
                }
        }
    </style>
}

@section Scripts {
    <script>
        (() => {
            const filters = document.getElementById("manageFilters");
            const results = document.getElementById("manageResults");
            const emptyState = document.getElementById("manageEmptyFilter");
            const showAllButton = document.getElementById("manageShowAll");

            const buttons = Array.from(
                document.querySelectorAll("[data-pa-manage-filter]")
            );

            const items = Array.from(
                document.querySelectorAll("[data-pa-manage-item]")
            );

            if (filters && results && emptyState && buttons.length) {
                filters.hidden = false;
                results.hidden = false;

                const applyFilter = status => {
                    let visibleCount = 0;

                    items.forEach(item => {
                        const matches =
                            status === "all" ||
                            item.dataset.paStatus === status;

                        item.hidden = !matches;

                        if (matches) {
                            visibleCount++;
                        }
                    });

                    buttons.forEach(button => {
                        const active =
                            button.dataset.paManageFilter === status;

                        button.classList.toggle("is-active", active);
                        button.setAttribute("aria-pressed", String(active));
                    });

                    emptyState.hidden = visibleCount !== 0;

                    results.textContent =
                        `Showing ${visibleCount} of ${items.length} ` +
                        (items.length === 1 ? "request" : "requests");
                };

                buttons.forEach(button => {
                    button.addEventListener("click", () => {
                        applyFilter(button.dataset.paManageFilter);
                    });
                });

                showAllButton?.addEventListener("click", () => {
                    applyFilter("all");
                    buttons[0]?.focus();
                });

                applyFilter("all");
            }

            document.querySelectorAll(
                ".pa-manage__decision-form"
            ).forEach(form => {
                form.addEventListener("submit", event => {
                    const decision = form.dataset.paDecision;
                    const petName = form.dataset.paPet || "this pet";
                    const adopterName =
                        form.dataset.paAdopter || "this adopter";

                    const verb = decision === "approve"
                        ? "approve"
                        : "reject";

                    const confirmed = window.confirm(
                        `Are you sure you want to ${verb} the adoption ` +
                        `request for "${petName}" submitted by ` +
                        `"${adopterName}"?`
                    );

                    if (!confirmed) {
                        event.preventDefault();
                        return;
                    }

                    form.querySelectorAll(
                        'button[type="submit"]'
                    ).forEach(button => {
                        button.disabled = true;
                    });
                });
            });
        })();
    </script>
}