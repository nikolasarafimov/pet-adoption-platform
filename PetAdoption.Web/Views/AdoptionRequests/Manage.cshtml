@using PetAdoption.Domain.Enums
@model IReadOnlyList<PetAdoption.Application.DTOs.AdoptionRequestDto>

@{
    ViewData["Title"] = "Manage Adoption Requests";
    ViewData["Description"] = "Review adoption requests and manage shelter decisions.";

    var isAdmin = User.IsInRole("Admin");

    var totalCount = Model.Count;

    var pendingCount = Model.Count(r =>
        r.Status == AdoptionRequestStatus.Pending);

    var approvedCount = Model.Count(r =>
        r.Status == AdoptionRequestStatus.Approved);

    var rejectedCount = Model.Count(r =>
        r.Status == AdoptionRequestStatus.Rejected);

    var cancelledCount = Model.Count(r =>
        r.Status == AdoptionRequestStatus.Cancelled);

    var successMessage = TempData["ok"]?.ToString();
    var errorMessage = TempData["err"]?.ToString();
}

<div class="pa-manage">

    <nav class="pa-manage__breadcrumb"
         aria-label="Breadcrumb">

        <a asp-controller="Home"
           asp-action="Welcome">
            Home
        </a>

        <span aria-hidden="true">/</span>

        <span>
            @(isAdmin ? "Administration" : "Shelter Workspace")
        </span>

        <span aria-hidden="true">/</span>

        <span aria-current="page">
            Adoption Requests
        </span>
    </nav>

    <header class="pa-manage__hero">

        <div class="pa-manage__hero-glow"
             aria-hidden="true"></div>

        <div class="pa-manage__hero-content">

            <div class="pa-manage__eyebrow">

                <span class="pa-manage__eyebrow-dot"></span>

                @(isAdmin ? "ADMINISTRATION WORKSPACE" : "SHELTER WORKSPACE")
            </div>

            <h1>
                Adoption
                <span>Management.</span>
            </h1>

            <p class="pa-manage__hero-description">
                @if (isAdmin)
                {
                    <text>
                        Review adoption requests, monitor their
                        progress, and manage pending decisions
                        across the platform.
                    </text>
                }
                else
                {
                    <text>
                        Every adoption begins with a connection.
                        Review the requests received by your shelter
                        and help pets find their next home.
                    </text>
                }
            </p>

            <div class="pa-manage__hero-meta">

                <span class="pa-manage__hero-pill">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <rect x="4" y="3" width="16" height="18" rx="3" />
                        <path d="M8 8h8M8 12h8M8 16h5" />
                    </svg>

                    @totalCount total
                    @(totalCount == 1 ? "request" : "requests")
                </span>

                <span class="pa-manage__hero-pill
                             pa-manage__hero-pill--pending">

                    <span class="pa-manage__pending-dot"></span>

                    @pendingCount awaiting review
                </span>
            </div>
        </div>

        <div class="pa-manage__hero-art"
             aria-hidden="true">

            <div class="pa-manage__art-ring
                        pa-manage__art-ring--outer"></div>

            <div class="pa-manage__art-ring
                        pa-manage__art-ring--inner"></div>

            <div class="pa-manage__art-center">

                <svg viewBox="0 0 80 80"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.3"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <rect x="17" y="13"
                          width="46" height="56" rx="7" />

                    <path d="M28 29h24" />
                    <path d="M28 40h13" />

                    <path d="M49 45c-4-6-12-2-10 4 2 5 10 10 10 10s8-5 10-10c2-6-6-10-10-4Z" />
                </svg>
            </div>

            <span class="pa-manage__art-spark
                         pa-manage__art-spark--one"></span>

            <span class="pa-manage__art-spark
                         pa-manage__art-spark--two"></span>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="pa-manage__alert pa-manage__alert--success"
             role="status">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="m8 12 3 3 5-6" />
            </svg>

            <span>@successMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="pa-manage__alert pa-manage__alert--error"
             role="alert">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v6" />
                <path d="M12 17h.01" />
            </svg>

            <span>@errorMessage</span>
        </div>
    }

    <section class="pa-manage__overview"
             aria-labelledby="manageOverviewTitle">

        <div class="pa-manage__section-heading">

            <div>
                <span class="pa-manage__section-eyebrow">
                    REQUEST ACTIVITY
                </span>

                <h2 id="manageOverviewTitle">
                    Overview
                </h2>

                <p>
                    A current breakdown of the requests
                    available in your workspace.
                </p>
            </div>
        </div>

        <div class="pa-manage__stats">

            <div class="pa-manage__stat">

                <span class="pa-manage__stat-icon
                             pa-manage__stat-icon--total">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <rect x="4" y="3" width="16" height="18" rx="3" />
                        <path d="M8 8h8M8 12h8M8 16h5" />
                    </svg>
                </span>

                <span class="pa-manage__stat-label">
                    Total Requests
                </span>

                <strong class="pa-manage__stat-value">
                    @totalCount
                </strong>

                <span class="pa-manage__stat-caption">
                    All recorded requests
                </span>
            </div>

            <div class="pa-manage__stat">

                <span class="pa-manage__stat-icon
                             pa-manage__stat-icon--pending">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7v5l3 2" />
                    </svg>
                </span>

                <span class="pa-manage__stat-label">
                    Awaiting Review
                </span>

                <strong class="pa-manage__stat-value
                               pa-manage__stat-value--pending">
                    @pendingCount
                </strong>

                <span class="pa-manage__stat-caption">
                    Pending decisions
                </span>
            </div>

            <div class="pa-manage__stat">

                <span class="pa-manage__stat-icon
                             pa-manage__stat-icon--approved">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="m8 12 3 3 5-6" />
                    </svg>
                </span>

                <span class="pa-manage__stat-label">
                    Approved
                </span>

                <strong class="pa-manage__stat-value
                               pa-manage__stat-value--approved">
                    @approvedCount
                </strong>

                <span class="pa-manage__stat-caption">
                    Approved requests
                </span>
            </div>

            <div class="pa-manage__stat">

                <span class="pa-manage__stat-icon
                             pa-manage__stat-icon--rejected">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M8.5 8.5 15.5 15.5" />
                        <path d="M15.5 8.5 8.5 15.5" />
                    </svg>
                </span>

                <span class="pa-manage__stat-label">
                    Rejected
                </span>

                <strong class="pa-manage__stat-value
                               pa-manage__stat-value--rejected">
                    @rejectedCount
                </strong>

                <span class="pa-manage__stat-caption">
                    Declined requests
                </span>
            </div>
        </div>
    </section>

    <section class="pa-manage__directory"
             aria-labelledby="manageRequestsTitle">

        <div class="pa-manage__directory-heading">

            <div>
                <span class="pa-manage__section-eyebrow">
                    ADOPTION APPLICATIONS
                </span>

                <h2 id="manageRequestsTitle">
                    @(isAdmin ? "All Adoption Requests" : "Shelter Requests")
                </h2>

                <p>
                    Review adopter information, messages
                    and application statuses.
                </p>
            </div>

            <span class="pa-manage__directory-total">
                @totalCount
                @(totalCount == 1 ? "request" : "requests")
            </span>
        </div>

        @if (totalCount == 0)
        {
            <div class="pa-manage__empty">

                <div class="pa-manage__empty-icon"
                     aria-hidden="true">

                    <svg viewBox="0 0 64 64"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2.1"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <rect x="13" y="8"
                              width="38" height="49" rx="6" />
                        <path d="M23 23h18" />
                        <path d="M23 32h18" />
                        <path d="M23 41h11" />
                    </svg>
                </div>

                <span class="pa-manage__empty-eyebrow">
                    NO APPLICATIONS YET
                </span>

                <h3>No adoption requests</h3>

                <p>
                    When adopters submit requests for
                    eligible pets, the requests available
                    to your workspace will appear here.
                </p>
            </div>
        }
        else
        {
            <div id="manageFilters"
                 class="pa-manage__filters"
                 role="group"
                 aria-label="Filter adoption requests by status"
                 hidden>

                <button type="button"
                        class="pa-manage__filter is-active"
                        data-pa-manage-filter="all"
                        aria-pressed="true">

                    All
                    <span>@totalCount</span>
                </button>

                <button type="button"
                        class="pa-manage__filter"
                        data-pa-manage-filter="pending"
                        aria-pressed="false">

                    Pending
                    <span>@pendingCount</span>
                </button>

                <button type="button"
                        class="pa-manage__filter"
                        data-pa-manage-filter="approved"
                        aria-pressed="false">

                    Approved
                    <span>@approvedCount</span>
                </button>

                <button type="button"
                        class="pa-manage__filter"
                        data-pa-manage-filter="rejected"
                        aria-pressed="false">

                    Rejected
                    <span>@rejectedCount</span>
                </button>

                <button type="button"
                        class="pa-manage__filter"
                        data-pa-manage-filter="cancelled"
                        aria-pressed="false">

                    Cancelled
                    <span>@cancelledCount</span>
                </button>
            </div>

            <div id="manageResults"
                 class="pa-manage__results"
                 aria-live="polite"
                 aria-atomic="true"
                 hidden>

                Showing @totalCount of @totalCount requests
            </div>

            <div class="pa-manage__list"
                 id="manageRequestList">

                @foreach (var request in Model)
                {
                    var statusClass = request.Status switch
                    {
                        AdoptionRequestStatus.Pending => "pending",
                        AdoptionRequestStatus.Approved => "approved",
                        AdoptionRequestStatus.Rejected => "rejected",
                        AdoptionRequestStatus.Cancelled => "cancelled",
                        _ => "unknown"
                    };

                    var statusDescription = request.Status switch
                    {
                        AdoptionRequestStatus.Pending =>
                        "Awaiting a decision.",

                        AdoptionRequestStatus.Approved =>
                        "This adoption request has been approved.",

                        AdoptionRequestStatus.Rejected =>
                        "This adoption request has been rejected.",

                        AdoptionRequestStatus.Cancelled =>
                        "This adoption request was cancelled.",

                        _ => "Request status is unavailable."
                    };

                    var petName = string.IsNullOrWhiteSpace(request.PetName)
                    ? "Unnamed Pet"
                    : request.PetName.Trim();

                    var adopterName = string.IsNullOrWhiteSpace(request.AdopterName)
                    ? "Unnamed Adopter"
                    : request.AdopterName.Trim();

                    var adopterInitial = adopterName[0]
                    .ToString()
                    .ToUpperInvariant();

                    <article class="pa-manage__request"
                             data-pa-manage-item
                             data-pa-status="@statusClass">

                        <div class="pa-manage__request-top">

                            <div class="pa-manage__request-identity">

                                <div class="pa-manage__pet-icon"
                                     aria-hidden="true">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <circle cx="7" cy="8" r="1" />
                                        <circle cx="12" cy="5" r="1" />
                                        <circle cx="17" cy="8" r="1" />
                                        <circle cx="20" cy="12" r="1" />
                                        <path d="M12 12c-2.2 0-3.4 2-5 3.5-1.4 1.4-.8 4.5 1.8 4.5 1.4 0 2.2-.8 3.2-.8s1.8.8 3.2.8c2.6 0 3.2-3.1 1.8-4.5C15.4 14 14.2 12 12Z" />
                                    </svg>
                                </div>

                                <div class="pa-manage__request-name">

                                    <span class="pa-manage__request-eyebrow">
                                        ADOPTION REQUEST #@request.Id
                                    </span>

                                    <h3>@petName</h3>

                                    <span class="pa-manage__request-subtitle">
                                        Adoption application
                                    </span>
                                </div>
                            </div>

                            <span class="pa-manage__status
                                                 pa-manage__status--@statusClass">

                                <span class="pa-manage__status-dot"></span>

                                @request.Status
                            </span>
                        </div>

                        <div class="pa-manage__request-grid">

                            <section class="pa-manage__adopter"
                                     aria-label="Adopter information">

                                <span class="pa-manage__field-heading">
                                    SUBMITTED BY
                                </span>

                                <div class="pa-manage__adopter-profile">

                                    <div class="pa-manage__adopter-avatar"
                                         aria-hidden="true">

                                        @adopterInitial
                                    </div>

                                    <div>
                                        <strong>@adopterName</strong>

                                        <span>Adoption applicant</span>
                                    </div>
                                </div>
                            </section>

                            <section class="pa-manage__message"
                                     aria-label="Adopter message">

                                <span class="pa-manage__field-heading">
                                    MESSAGE FROM ADOPTER
                                </span>

                                @if (!string.IsNullOrWhiteSpace(request.Message))
                                {
                                    <p>@request.Message</p>
                                }
                                else
                                {
                                    <p class="pa-manage__message-empty">
                                        No message was provided.
                                    </p>
                                }
                            </section>
                        </div>

                        <div class="pa-manage__request-footer">

                            <div class="pa-manage__request-meta">

                                <div class="pa-manage__meta-item">

                                    <span class="pa-manage__meta-icon"
                                          aria-hidden="true">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <rect x="3" y="5" width="18" height="16" rx="2" />
                                            <path d="M7 3v4M17 3v4M3 10h18" />
                                        </svg>
                                    </span>

                                    <div>
                                        <small>Submitted</small>

                                        <time datetime="@request.CreatedAt.ToUniversalTime().ToString("o")">
                                            @request.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                        </time>
                                    </div>
                                </div>

                                @if (request.DecisionAt.HasValue)
                                {
                                    <div class="pa-manage__meta-item">

                                        <span class="pa-manage__meta-icon"
                                              aria-hidden="true">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <circle cx="12" cy="12" r="9" />
                                                <path d="M12 7v5l3 2" />
                                            </svg>
                                        </span>

                                        <div>
                                            <small>Decision recorded</small>

                                            <time datetime="@request.DecisionAt.Value.ToUniversalTime().ToString("o")">
                                                @request.DecisionAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                            </time>
                                        </div>
                                    </div>
                                }
                                else if (request.Status == AdoptionRequestStatus.Pending)
                                {
                                    <div class="pa-manage__meta-item">

                                        <span class="pa-manage__meta-icon"
                                              aria-hidden="true">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <circle cx="12" cy="12" r="9" />
                                                <path d="M12 7v5l3 2" />
                                            </svg>
                                        </span>

                                        <div>
                                            <small>Decision</small>
                                            <span>Awaiting review</span>
                                        </div>
                                    </div>
                                }
                            </div>

                            @if (request.Status == AdoptionRequestStatus.Pending)
                            {
                                <div class="pa-manage__decision-actions">

                                    <form asp-controller="AdoptionRequests"
                                          asp-action="Decide"
                                          method="post"
                                          asp-antiforgery="true"
                                          class="pa-manage__decision-form"
                                          data-pa-decision="approve"
                                          data-pa-pet="@petName"
                                          data-pa-adopter="@adopterName">

                                        <input type="hidden"
                                               name="id"
                                               value="@request.Id" />

                                        <input type="hidden"
                                               name="status"
                                               value="@AdoptionRequestStatus.Approved" />

                                        <button type="submit"
                                                class="pa-manage__approve">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.9"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round"
                                                 aria-hidden="true">

                                                <path d="m5 12 4 4L19 6" />
                                            </svg>

                                            Approve
                                        </button>
                                    </form>

                                    <form asp-controller="AdoptionRequests"
                                          asp-action="Decide"
                                          method="post"
                                          asp-antiforgery="true"
                                          class="pa-manage__decision-form"
                                          data-pa-decision="reject"
                                          data-pa-pet="@petName"
                                          data-pa-adopter="@adopterName">

                                        <input type="hidden"
                                               name="id"
                                               value="@request.Id" />

                                        <input type="hidden"
                                               name="status"
                                               value="@AdoptionRequestStatus.Rejected" />

                                        <button type="submit"
                                                class="pa-manage__reject">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.9"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round"
                                                 aria-hidden="true">

                                                <path d="M6 6l12 12" />
                                                <path d="M18 6 6 18" />
                                            </svg>

                                            Reject
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="pa-manage__completed-note">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         aria-hidden="true">

                                        <circle cx="12" cy="12" r="9" />
                                        <path d="M8 12h8" />
                                    </svg>

                                    @statusDescription
                                </span>
                            }
                        </div>
                    </article>
                }
            </div>

            <div id="manageEmptyFilter"
                 class="pa-manage__filter-empty"
                 hidden>

                <div class="pa-manage__filter-empty-icon"
                     aria-hidden="true">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12" cy="12" r="9" />
                        <path d="M8 12h8" />
                    </svg>
                </div>

                <h3>No matching requests</h3>

                <p>
                    There are no adoption requests
                    with the selected status.
                </p>

                <button type="button"
                        id="manageShowAll"
                        class="pa-manage__show-all">

                    View All Requests
                </button>
            </div>
        }
    </section>

    <section class="pa-manage__guidance"
             aria-labelledby="manageGuidanceTitle">

        <div class="pa-manage__guidance-icon"
             aria-hidden="true">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" />
                <path d="m9 12 2 2 4-4" />
            </svg>
        </div>

        <div>
            <h2 id="manageGuidanceTitle">
                Thoughtful decisions matter.
            </h2>

            <p>
                Review each applicant's information before
                approving or rejecting a pending request.
                Decisions are processed by the server,
                which checks permissions and the current
                request status.
            </p>
        </div>
    </section>
</div>

@section Styles {
    <style>
        .pa-manage {
            width: 100%;
            max-width: 1350px;
            margin: 0 auto 55px;
            color: #173d32;
        }

            .pa-manage [hidden] {
                display: none !important;
            }

        .pa-manage__breadcrumb {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            margin-bottom: 24px;
            color: #89968b;
            font-size: 0.82rem;
        }

            .pa-manage__breadcrumb a {
                color: #637a69;
                text-decoration: none;
            }

                .pa-manage__breadcrumb a:hover {
                    color: #c8914e;
                }

            .pa-manage__breadcrumb [aria-current="page"] {
                color: #173d32;
                font-weight: 700;
            }

        .pa-manage__hero {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            min-height: 310px;
            margin-bottom: 31px;
            padding: clamp(32px, 4.5vw, 60px);
            overflow: hidden;
            isolation: isolate;
            border-radius: 28px;
            background: radial-gradient( circle at 85% 45%, rgba(244, 197, 122, 0.16), transparent 36% ), linear-gradient( 125deg, #173d32, #245847 );
            box-shadow: 0 22px 48px rgba(23, 61, 50, 0.15);
        }

        .pa-manage__hero-glow {
            position: absolute;
            right: -100px;
            bottom: -190px;
            z-index: -1;
            width: 450px;
            height: 450px;
            border-radius: 50%;
            background: rgba(244, 197, 122, 0.12);
            filter: blur(65px);
            pointer-events: none;
        }

        .pa-manage__hero-content {
            position: relative;
            z-index: 2;
            max-width: 700px;
            animation: pa-manage-enter 650ms ease both;
        }

        .pa-manage__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 21px;
            color: #f4c57a;
            font-size: 0.71rem;
            font-weight: 800;
            letter-spacing: 0.14em;
        }

        .pa-manage__eyebrow-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #f4c57a;
            box-shadow: 0 0 0 5px rgba(244, 197, 122, 0.13);
        }

        .pa-manage__hero h1 {
            margin: 0;
            color: #fff;
            font-family: "Fraunces", Georgia, serif;
            font-size: clamp(2.7rem, 4.8vw, 4.4rem);
