            const showAllButton = document.getElementById("showAllRequests");

            const buttons = Array.from(
                document.querySelectorAll("[data-pa-request-filter]")
            );

            const items = Array.from(
                document.querySelectorAll("[data-pa-request-item]")
            );

            const cancelForms = document.querySelectorAll(
                ".pa-requests__cancel-form"
            );

            if (filters && results && emptyState && buttons.length) {
                filters.hidden = false;
                results.hidden = false;

                const applyFilter = status => {
                    let visibleCount = 0;

                    items.forEach(item => {
                        const matches =
                            status === "all" ||
                            item.dataset.paStatus === status;

                        item.hidden = !matches;

                        if (matches) {
                            visibleCount++;
                        }
                    });

                    buttons.forEach(button => {
                        const selected =
                            button.dataset.paRequestFilter === status;

                        button.classList.toggle("is-active", selected);
                        button.setAttribute("aria-pressed", String(selected));
                    });

                    emptyState.hidden = visibleCount !== 0;

                    results.textContent =
                        `Showing ${visibleCount} of ${items.length} ` +
                        (items.length === 1 ? "request" : "requests");
                };

                buttons.forEach(button => {
                    button.addEventListener("click", () => {
                        applyFilter(button.dataset.paRequestFilter);
                    });
                });

                showAllButton?.addEventListener("click", () => {
                    applyFilter("all");
                    buttons[0]?.focus();
                });

                applyFilter("all");
            }

            cancelForms.forEach(form => {
                form.addEventListener("submit", event => {
                    const confirmed = window.confirm(
                        "Are you sure you want to cancel this adoption request?"
                    );

                    if (!confirmed) {
                        event.preventDefault();
                    }
                });
            });
        })();
    </script>
}