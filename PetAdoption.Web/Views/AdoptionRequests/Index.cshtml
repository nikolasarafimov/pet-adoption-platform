@using PetAdoption.Domain.Enums
@model IReadOnlyList<PetAdoption.Application.DTOs.AdoptionRequestDto>

@{
    ViewData["Title"] = "My Adoption Requests";
    ViewData["Description"] = "Track and manage your adoption requests on PetAdoption.";

    var totalCount = Model.Count;

    var pendingCount = Model.Count(r =>
        r.Status == AdoptionRequestStatus.Pending);

    var approvedCount = Model.Count(r =>
        r.Status == AdoptionRequestStatus.Approved);

    var rejectedCount = Model.Count(r =>
        r.Status == AdoptionRequestStatus.Rejected);

    var cancelledCount = Model.Count(r =>
        r.Status == AdoptionRequestStatus.Cancelled);

    var successMessage = TempData["ok"] as string;
    var errorMessage = TempData["err"] as string;
}

<div class="pa-requests">

    <nav class="pa-requests__breadcrumb"
         aria-label="Breadcrumb">

        <a asp-controller="Home"
           asp-action="Welcome">
            Home
        </a>

        <span aria-hidden="true">/</span>

        <span aria-current="page">
            My Requests
        </span>
    </nav>

    <header class="pa-requests__hero">

        <div class="pa-requests__hero-glow"
             aria-hidden="true"></div>

        <div class="pa-requests__hero-content">

            <div class="pa-requests__eyebrow">
                <span class="pa-requests__eyebrow-dot"></span>
                YOUR ADOPTION JOURNEY
            </div>

            <h1>
                Every journey
                <span>has a story.</span>
            </h1>

            <p class="pa-requests__hero-description">
                Stay connected to your adoption journey.
                Review your requests, follow shelter decisions,
                and keep track of the pets you've applied to adopt.
            </p>

            <div class="pa-requests__hero-actions">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="pa-requests__explore-btn">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" />
                        <path d="m9 12 2 2 4-4" />
                    </svg>

                    Explore Available Pets

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M5 12h14" />
                        <path d="m13 6 6 6-6 6" />
                    </svg>
                </a>

                <span class="pa-requests__hero-caption">
                    YOUR REQUESTS, ALL IN ONE PLACE
                </span>
            </div>
        </div>

        <div class="pa-requests__hero-art"
             aria-hidden="true">

            <div class="pa-requests__art-ring
                        pa-requests__art-ring--outer"></div>

            <div class="pa-requests__art-ring
                        pa-requests__art-ring--inner"></div>

            <div class="pa-requests__art-center">

                <svg viewBox="0 0 80 80"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.4"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M14 35 40 14l26 21" />
                    <path d="M21 31v37h38V31" />
                    <path d="M32 68V48h16v20" />
                    <path d="M40 34c-4.5-6-12-2-10 4 1.5 5 10 10 10 10s8.5-5 10-10c2-6-5.5-10-10-4Z" />
                </svg>
            </div>

            <span class="pa-requests__art-spark
                         pa-requests__art-spark--one"></span>

            <span class="pa-requests__art-spark
                         pa-requests__art-spark--two"></span>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="pa-requests__alert pa-requests__alert--success"
             role="status">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="m8 12 3 3 5-6" />
            </svg>

            <span>@successMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="pa-requests__alert pa-requests__alert--error"
             role="alert">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v6" />
                <path d="M12 17h.01" />
            </svg>

            <span>@errorMessage</span>
        </div>
    }

    <section class="pa-requests__overview"
             aria-labelledby="requestsOverviewTitle">

        <div class="pa-requests__section-intro">

            <div>
                <span class="pa-requests__section-eyebrow">
                    YOUR ACTIVITY
                </span>

                <h2 id="requestsOverviewTitle">
                    Request Overview
                </h2>

                <p>
                    A snapshot of your adoption request activity.
                </p>
            </div>
        </div>

        <div class="pa-requests__stats">

            <div class="pa-requests__stat">

                <div class="pa-requests__stat-top">

                    <span class="pa-requests__stat-icon
                                 pa-requests__stat-icon--total">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <rect x="4" y="3" width="16" height="18" rx="3" />
                            <path d="M8 8h8M8 12h8M8 16h5" />
                        </svg>
                    </span>

                    <span class="pa-requests__stat-label">
                        Total Requests
                    </span>
                </div>

                <div class="pa-requests__stat-value">
                    @totalCount
                </div>

                <div class="pa-requests__stat-bottom">
                    All submitted requests
                </div>
            </div>

            <div class="pa-requests__stat">

                <div class="pa-requests__stat-top">

                    <span class="pa-requests__stat-icon
                                 pa-requests__stat-icon--pending">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 7v5l3 2" />
                        </svg>
                    </span>

                    <span class="pa-requests__stat-label">
                        Pending Review
                    </span>
                </div>

                <div class="pa-requests__stat-value
                            pa-requests__stat-value--pending">
                    @pendingCount
                </div>

                <div class="pa-requests__stat-bottom">
                    Awaiting a decision
                </div>
            </div>

            <div class="pa-requests__stat">

                <div class="pa-requests__stat-top">

                    <span class="pa-requests__stat-icon
                                 pa-requests__stat-icon--approved">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="m8 12 3 3 5-6" />
                        </svg>
                    </span>

                    <span class="pa-requests__stat-label">
                        Approved
                    </span>
                </div>

                <div class="pa-requests__stat-value
                            pa-requests__stat-value--approved">
                    @approvedCount
                </div>

                <div class="pa-requests__stat-bottom">
                    Approved by a shelter
                </div>
            </div>
        </div>
    </section>

    <section class="pa-requests__directory"
             aria-labelledby="requestsDirectoryTitle">

        <div class="pa-requests__directory-heading">

            <div>
                <span class="pa-requests__section-eyebrow">
                    REQUEST HISTORY
                </span>

                <h2 id="requestsDirectoryTitle">
                    My Applications
                </h2>

                <p>
                    Review the status and details
                    of your adoption requests.
                </p>
            </div>

            <span class="pa-requests__directory-count">
                @totalCount
                @(totalCount == 1 ? "request" : "requests")
            </span>
        </div>

        @if (totalCount == 0)
        {
            <div class="pa-requests__empty">

                <div class="pa-requests__empty-art"
                     aria-hidden="true">

                    <span class="pa-requests__empty-ring"></span>

                    <svg viewBox="0 0 64 64"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2.1"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M10 14h44v35H24L10 58V14Z" />
                        <path d="M20 25h24" />
                        <path d="M20 33h17" />
                        <path d="M20 41h10" />
                    </svg>
                </div>

                <span class="pa-requests__empty-eyebrow">
                    YOUR JOURNEY STARTS HERE
                </span>

                <h3>No adoption requests yet.</h3>

                <p>
                    You haven't submitted an adoption request.
                    Discover available pets and take the first
                    step toward finding your new companion.
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="pa-requests__empty-button">

                    Browse Available Pets

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M5 12h14" />
                        <path d="m13 6 6 6-6 6" />
                    </svg>
                </a>
            </div>
        }
        else
        {
            <div id="requestFilters"
                 class="pa-requests__filters"
                 role="group"
                 aria-label="Filter requests by status"
                 hidden>

                <button type="button"
                        class="pa-requests__filter is-active"
                        data-pa-request-filter="all"
                        aria-pressed="true">

                    All
                    <span>@totalCount</span>
                </button>

                <button type="button"
                        class="pa-requests__filter"
                        data-pa-request-filter="pending"
                        aria-pressed="false">

                    Pending
                    <span>@pendingCount</span>
                </button>

                <button type="button"
                        class="pa-requests__filter"
                        data-pa-request-filter="approved"
                        aria-pressed="false">

                    Approved
                    <span>@approvedCount</span>
                </button>

                <button type="button"
                        class="pa-requests__filter"
                        data-pa-request-filter="rejected"
                        aria-pressed="false">

                    Rejected
                    <span>@rejectedCount</span>
                </button>

                <button type="button"
                        class="pa-requests__filter"
                        data-pa-request-filter="cancelled"
                        aria-pressed="false">

                    Cancelled
                    <span>@cancelledCount</span>
                </button>
            </div>

            <div id="requestResults"
                 class="pa-requests__results"
                 aria-live="polite"
                 aria-atomic="true"
                 hidden>

                Showing @totalCount of @totalCount requests
            </div>

            <div id="requestList"
                 class="pa-requests__list">

                @foreach (var request in Model)
                {
                    var statusName = request.Status.ToString();

                    var statusClass = request.Status switch
                    {
                        AdoptionRequestStatus.Pending => "pending",
                        AdoptionRequestStatus.Approved => "approved",
                        AdoptionRequestStatus.Rejected => "rejected",
                        AdoptionRequestStatus.Cancelled => "cancelled",
                        _ => "unknown"
                    };

                    var statusDescription = request.Status switch
                    {
                        AdoptionRequestStatus.Pending =>
                            "Your request is awaiting review by the shelter.",

                        AdoptionRequestStatus.Approved =>
                            "The shelter has approved your adoption request.",

                        AdoptionRequestStatus.Rejected =>
                            "The shelter has declined your adoption request.",

                        AdoptionRequestStatus.Cancelled =>
                            "This adoption request has been cancelled.",

                        _ => "Review the current request status."
                    };

                    var displayPetName =
                        string.IsNullOrWhiteSpace(request.PetName)
                            ? "Pet"
                            : request.PetName;

                    <article class="pa-requests__item"
                             data-pa-request-item
                             data-pa-status="@statusClass">

                        <div class="pa-requests__item-top">

                            <div class="pa-requests__pet">

                                <div class="pa-requests__pet-avatar"
                                     aria-hidden="true">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <circle cx="7" cy="8" r="1" />
                                        <circle cx="12" cy="5.5" r="1" />
                                        <circle cx="17" cy="8" r="1" />
                                        <circle cx="20" cy="12" r="1" />
                                        <path d="M12 12c-2.2 0-3.4 2-5 3.5-1.4 1.4-.8 4.5 1.8 4.5 1.4 0 2.2-.8 3.2-.8s1.8.8 3.2.8c2.6 0 3.2-3.1 1.8-4.5C15.4 14 14.2 12 12 12Z" />
                                    </svg>
                                </div>

                                <div class="pa-requests__pet-info">

                                    <span class="pa-requests__item-eyebrow">
                                        ADOPTION REQUEST
                                    </span>

                                    <h3>@displayPetName</h3>

                                    <span class="pa-requests__request-id">
                                        Request #@request.Id
                                    </span>
                                </div>
                            </div>

                            <span class="pa-requests__status
                                         pa-requests__status--@statusClass">

                                <span class="pa-requests__status-dot"></span>

                                @statusName
                            </span>
                        </div>

                        <div class="pa-requests__status-note
                                    pa-requests__status-note--@statusClass">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">

                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 11v5" />
                                <path d="M12 8h.01" />
                            </svg>

                            <span>@statusDescription</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(request.Message))
                        {
                            <div class="pa-requests__message">

                                <div class="pa-requests__message-heading">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         aria-hidden="true">

                                        <path d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8l-5 3V7a2 2 0 0 1 1-2Z" />
                                        <path d="M8 10h8" />
                                        <path d="M8 14h5" />
                                    </svg>

                                    Your message to the shelter
                                </div>

                                <p>@request.Message</p>
                            </div>
                        }

                        <div class="pa-requests__item-footer">

                            <div class="pa-requests__dates">

                                <div class="pa-requests__date">

                                    <span class="pa-requests__date-icon"
                                          aria-hidden="true">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <rect x="3" y="5" width="18" height="16" rx="2" />
                                            <path d="M7 3v4M17 3v4M3 10h18" />
                                        </svg>
                                    </span>

                                    <span>
                                        <small>Submitted</small>

                                        <time datetime="@request.CreatedAt.ToUniversalTime().ToString("o")">
                                            @request.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                        </time>
                                    </span>
                                </div>

                                <div class="pa-requests__date">

                                    <span class="pa-requests__date-icon"
                                          aria-hidden="true">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <circle cx="12" cy="12" r="9" />
                                            <path d="M12 7v5l3 2" />
                                        </svg>
                                    </span>

                                    <span>
                                        <small>
                                            @(request.Status == AdoptionRequestStatus.Cancelled
                                                ? "Status updated"
                                                : "Decision")
                                        </small>

                                        @if (request.DecisionAt.HasValue)
                                        {
                                            <time datetime="@request.DecisionAt.Value.ToUniversalTime().ToString("o")">
                                                @request.DecisionAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                            </time>
                                        }
                                        else
                                        {
                                            <span class="pa-requests__date-pending">
                                                @(request.Status == AdoptionRequestStatus.Pending
                                                    ? "Awaiting review"
                                                    : "Not recorded")
                                            </span>
                                        }
                                    </span>
                                </div>
                            </div>

                            @if (request.Status == AdoptionRequestStatus.Pending)
                            {
                                <form asp-controller="AdoptionRequests"
                                      asp-action="Cancel"
                                      method="post"
                                      asp-antiforgery="true"
                                      class="pa-requests__cancel-form">

                                    <input type="hidden"
                                           name="id"
                                           value="@request.Id" />

                                    <button type="submit"
                                            class="pa-requests__cancel"
                                            aria-label="Cancel adoption request for @displayPetName">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round"
                                             aria-hidden="true">

                                            <path d="M6 6l12 12" />
                                            <path d="M18 6 6 18" />
                                        </svg>

                                        Cancel Request
                                    </button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </div>

            <div id="requestFilterEmpty"
                 class="pa-requests__filter-empty"
                 hidden>

                <div class="pa-requests__filter-empty-icon"
                     aria-hidden="true">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12" cy="12" r="9" />
                        <path d="M8 12h8" />
                    </svg>
                </div>

                <h3>No requests with this status</h3>

                <p>
                    You don't currently have any adoption
                    requests in this category.
                </p>

                <button type="button"
                        id="showAllRequests"
                        class="pa-requests__show-all">

                    View All Requests
                </button>
            </div>
        }
    </section>

    <section class="pa-requests__bottom-cta">

        <div class="pa-requests__bottom-cta-icon"
             aria-hidden="true">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
            </svg>
        </div>

        <div>
            <h2>There's always another story waiting.</h2>

            <p>
                Continue exploring pets looking for loving homes.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index">

            Explore Pets

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">

                <path d="M5 12h14" />
                <path d="m13 6 6 6-6 6" />
            </svg>
        </a>
    </section>
</div>

@section Styles {
    <style>
        .pa-requests {
            width: 100%;
            max-width: 1320px;
            margin: 0 auto 55px;
        }

        .pa-requests [hidden] {
            display: none !important;
        }

        .pa-requests__breadcrumb {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            margin-bottom: 24px;
            color: #89968b;
            font-size: 0.82rem;
        }

        .pa-requests__breadcrumb a {
            color: #637a69;
            text-decoration: none;
        }

        .pa-requests__breadcrumb a:hover {
            color: #c8914e;
        }

        .pa-requests__breadcrumb [aria-current="page"] {
            color: #173d32;
            font-weight: 700;
        }

        .pa-requests__hero {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            min-height: 330px;
            margin-bottom: 32px;
            padding: clamp(32px, 4.5vw, 60px);
            overflow: hidden;
            isolation: isolate;
            border-radius: 28px;
            background:
                radial-gradient(
                    circle at 85% 45%,
                    rgba(244, 197, 122, 0.16),
                    transparent 36%
                ),
                linear-gradient(125deg, #173d32, #245847);
            box-shadow: 0 22px 48px rgba(23, 61, 50, 0.15);
        }

        .pa-requests__hero-glow {
            position: absolute;
            right: -100px;
            bottom: -190px;
            z-index: -1;
            width: 450px;
            height: 450px;
            border-radius: 50%;
            background: rgba(244, 197, 122, 0.12);
            filter: blur(65px);
            pointer-events: none;
        }

        .pa-requests__hero-content {
            position: relative;
            z-index: 2;
            max-width: 720px;
            animation: pa-requests-enter 650ms ease both;
        }

        .pa-requests__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 21px;
            color: #f4c57a;
            font-size: 0.71rem;
            font-weight: 800;
            letter-spacing: 0.14em;
        }

        .pa-requests__eyebrow-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #f4c57a;
            box-shadow: 0 0 0 5px rgba(244, 197, 122, 0.13);
        }

        .pa-requests__hero h1 {
            margin: 0;
            color: #fff;
            font-family: "Fraunces", Georgia, serif;
            font-size: clamp(2.7rem, 4.8vw, 4.4rem);
            font-weight: 600;
            letter-spacing: -0.06em;
            line-height: 1.1;
        }

        .pa-requests__hero h1 span {
            display: block;
            color: #f4c57a;
        }

        .pa-requests__hero-description {
            max-width: 560px;
            margin: 22px 0 28px;
            color: rgba(255, 255, 255, 0.83);
            font-size: 0.95rem;
            line-height: 1.85;
        }

        .pa-requests__hero-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 15px 23px;
        }

        .pa-requests__explore-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 11px;
            min-height: 53px;
            padding: 13px 22px;
            border: 1px solid #f4c57a;
            border-radius: 13px;
            background: #f4c57a;
            color: #173d32;
            font-size: 0.86rem;
            font-weight: 800;
            text-decoration: none;
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.1);
            transition:
                transform 220ms ease,
                box-shadow 220ms ease;
        }

        .pa-requests__explore-btn:hover {
            transform: translateY(-2px);
            color: #173d32;
            box-shadow: 0 16px 30px rgba(0, 0, 0, 0.15);
        }

        .pa-requests__explore-btn svg {
            width: 19px;
            height: 19px;
        }

        .pa-requests__hero-caption {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.69rem;
            font-weight: 800;
            letter-spacing: 0.1em;
        }

        .pa-requests__hero-art {
            position: relative;
            display: grid;
            width: 250px;
            height: 250px;
            flex-shrink: 0;
