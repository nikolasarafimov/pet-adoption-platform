            justify-content: center;
            gap: 9px;
            min-height: 46px;
            padding: 12px 18px;
            border: 1px solid #245847;
            border-radius: 11px;
            background: #245847;
            color: #fff;
            font-size: 0.82rem;
            font-weight: 800;
            text-decoration: none;
        }

        .pa-breeds__bottom-cta > a:hover {
            background: #173d32;
            color: #fff;
        }

        .pa-breeds__bottom-cta > a svg {
            width: 18px;
            height: 18px;
        }

        .pa-breeds a:focus-visible,
        .pa-breeds button:focus-visible {
            outline: 3px solid #c8914e;
            outline-offset: 3px;
        }

        @@keyframes pa-breeds-enter {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes pa-breeds-float {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        @@media (max-width: 1199.98px) {
            .pa-breeds__grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .pa-breeds__hero-art {
                width: 220px;
                height: 220px;
                margin-right: 0;
            }

            .pa-breeds__art-center {
                width: 120px;
                height: 120px;
                border-radius: 34px;
            }

            .pa-breeds__art-center svg {
                width: 77px;
                height: 77px;
            }
        }

        @@media (max-width: 991.98px) {
            .pa-breeds__hero-art {
                position: absolute;
                right: -45px;
                opacity: 0.2;
                pointer-events: none;
            }

            .pa-breeds__hero-content {
                max-width: 650px;
            }

            .pa-breeds__search-form {
                grid-template-columns: minmax(0, 1fr) 170px;
            }

            .pa-breeds__search-button {
                grid-column: 1 / -1;
            }
        }

        @@media (max-width: 767.98px) {
            .pa-breeds {
                margin-bottom: 30px;
            }

            .pa-breeds__hero {
                min-height: auto;
                padding: 33px;
                border-radius: 22px;
            }

            .pa-breeds__hero-art {
                right: -85px;
                opacity: 0.13;
            }

            .pa-breeds__search-panel {
                border-radius: 21px;
            }

            .pa-breeds__grid {
                gap: 17px;
            }

            .pa-breeds__media {
                height: 215px;
            }

            .pa-breeds__card-body {
                padding: 22px 19px;
            }

            .pa-breeds__attribute {
                padding: 11px;
            }

            .pa-breeds__attribute-top {
                flex-wrap: wrap;
            }

            .pa-breeds__card-footer {
                padding: 14px 19px;
            }
        }

        @@media (max-width: 620px) {
            .pa-breeds__grid {
                grid-template-columns: 1fr;
                max-width: 460px;
                margin-inline: auto;
            }

            .pa-breeds__media {
                height: 255px;
            }

            .pa-breeds__search-form {
                grid-template-columns: 1fr;
            }

            .pa-breeds__search-button {
                grid-column: auto;
            }

            .pa-breeds__page-arrow span {
                display: none;
            }

            .pa-breeds__page-arrow {
                min-width: 43px;
                padding: 10px;
            }
        }

        @@media (max-width: 480px) {
            .pa-breeds__breadcrumb {
                font-size: 0.75rem;
            }

            .pa-breeds__hero {
                padding: 29px 23px;
            }

            .pa-breeds__hero h1 {
                font-size: clamp(2.35rem, 9vw, 3.1rem);
            }

            .pa-breeds__hero-description {
                font-size: 0.87rem;
            }

            .pa-breeds__hero-meta {
                gap: 8px;
            }

            .pa-breeds__hero-pill {
                font-size: 0.69rem;
            }

            .pa-breeds__search-panel {
                padding: 23px 19px;
            }

            .pa-breeds__search-decoration {
                display: none;
            }

            .pa-breeds__media {
                height: 220px;
            }

            .pa-breeds__page-numbers {
                gap: 4px;
            }

            .pa-breeds__page-number {
                min-width: 35px;
                min-height: 40px;
                padding: 8px;
            }

            .pa-breeds__pagination-controls {
                gap: 6px;
            }

            .pa-breeds__bottom-cta {
                padding: 22px;
            }

            .pa-breeds__bottom-cta > a {
                width: 100%;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .pa-breeds__hero-content,
            .pa-breeds__hero-art {
                animation: none;
            }

            .pa-breeds__card,
            .pa-breeds__image,
            .pa-breeds__search-button,
            .pa-breeds__page-number,
            .pa-breeds__page-arrow {
                transition: none;
            }

            .pa-breeds__card:hover,
            .pa-breeds__card:hover .pa-breeds__image,
            .pa-breeds__search-button:hover {
                transform: none;
            }
        }
    </style>
}

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("breedSearchForm");
            const pageSize = document.getElementById("pageSize");

            if (form && pageSize) {
                pageSize.addEventListener("change", () => {
                    form.requestSubmit();
                });
            }

            document.querySelectorAll(
                "[data-pa-breed-image]"
            ).forEach(image => {
                const media = image.closest(".pa-breeds__media");
                const fallback = media?.querySelector(
                    ".pa-breeds__image-fallback"
                );

                const showFallback = () => {
                    image.hidden = true;

                    if (fallback) {
                        fallback.hidden = false;
                    }
                };

                image.addEventListener("error", showFallback, {
                    once: true
                });

                if (image.complete && image.naturalWidth === 0) {
                    showFallback();
                }
            });
        })();
    </script>
}