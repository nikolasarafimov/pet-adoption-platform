@using System.Linq
@model IReadOnlyList<PetAdoption.Application.DTOs.BreedDto>

@{
    ViewData["Title"] = "Explore Dog Breeds";
    ViewData["Description"] = "Discover dog breeds, their temperaments, lifespan, and average weight.";

    int page = Math.Max(1, ViewBag.Page ?? 1);
    int pageSize = ViewBag.PageSize ?? 12;
    int total = Math.Max(0, ViewBag.Total ?? Model.Count);
    int totalPages = Math.Max(1, ViewBag.TotalPages ?? 1);

    string query = ViewBag.Query as string ?? string.Empty;

    bool apiUnavailable = ViewBag.ApiUnavailable == true;
    bool hasQuery = !string.IsNullOrWhiteSpace(query);

    int firstPage = Math.Max(1, page - 2);
    int lastPage = Math.Min(totalPages, page + 2);

    string BuildUrl(int targetPage)
    {
        return Url.Action(
            "Index",
            "Breeds",
            new
            {
                q = query,
                page = targetPage,
                pageSize
            }
        ) ?? "#";
    }
}

<div class="pa-breeds">

    <nav class="pa-breeds__breadcrumb"
         aria-label="Breadcrumb">

        <a asp-controller="Home"
           asp-action="Welcome">
            Home
        </a>

        <span aria-hidden="true">/</span>

        <span aria-current="page">
            Breed Explorer
        </span>
    </nav>

    <header class="pa-breeds__hero">

        <div class="pa-breeds__hero-glow"
             aria-hidden="true"></div>

        <div class="pa-breeds__hero-content">

            <div class="pa-breeds__eyebrow">

                <span class="pa-breeds__eyebrow-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <circle cx="7" cy="8" r="1" />
                        <circle cx="12" cy="5" r="1" />
                        <circle cx="17" cy="8" r="1" />
                        <circle cx="20" cy="12" r="1" />

                        <path d="M12 12c-2.2 0-3.4 2-5 3.5-1.4 1.4-.8 4.5 1.8 4.5 1.4 0 2.2-.8 3.2-.8s1.8.8 3.2.8c2.6 0 3.2-3.1 1.8-4.5C15.4 14 14.2 12 12Z" />
                    </svg>
                </span>

                THE BREED EXPLORER
            </div>

            <h1>
                Every breed has
                <span>a story.</span>
            </h1>

            <p class="pa-breeds__hero-description">
                Explore the wonderful diversity of dogs.
                Learn about different breeds, their
                temperaments, typical lifespan, and
                average weight—all in one place.
            </p>

            <div class="pa-breeds__hero-meta">

                <span class="pa-breeds__hero-pill">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="M8 4h9a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8Z" />
                        <path d="M8 4v4H4" />
                        <path d="M8 13h8" />
                        <path d="M8 17h6" />
                    </svg>

                    Breed characteristics
                </span>

                <span class="pa-breeds__hero-pill">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <circle cx="12" cy="12" r="9" />
                        <path d="m8 12 3 3 5-6" />
                    </svg>

                    Data from The Dog API
                </span>
            </div>
        </div>

        <div class="pa-breeds__hero-art"
             aria-hidden="true">

            <div class="pa-breeds__art-orbit
                        pa-breeds__art-orbit--outer"></div>

            <div class="pa-breeds__art-orbit
                        pa-breeds__art-orbit--inner"></div>

            <div class="pa-breeds__art-center">

                <svg viewBox="0 0 96 96"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.3"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M28 35 16 25l-7 18 12 13" />
                    <path d="m68 35 12-10 7 18-12 13" />

                    <path d="M23 43c0-19 10-30 25-30s25 11 25 30v14c0 17-11 28-25 28S23 74 23 57V43Z" />

                    <path d="M33 49h3" />
                    <path d="M60 49h3" />

                    <path d="m42 63 6 5 6-5-6-4Z" />
                    <path d="M48 68v5" />
                    <path d="M48 73c-4 4-8 4-11 0" />
                    <path d="M48 73c4 4 8 4 11 0" />
                </svg>
            </div>

            <span class="pa-breeds__art-spark
                         pa-breeds__art-spark--one"></span>

            <span class="pa-breeds__art-spark
                         pa-breeds__art-spark--two"></span>
        </div>
    </header>

    <section class="pa-breeds__search-panel"
             aria-labelledby="breedSearchTitle">

        <div class="pa-breeds__search-heading">

            <div>
                <span class="pa-breeds__section-eyebrow">
                    FIND YOUR BREED
                </span>

                <h2 id="breedSearchTitle">
                    Discover something new.
                </h2>

                <p>
                    Search by breed name or explore
                    the complete directory.
                </p>
            </div>

            <div class="pa-breeds__search-decoration"
                 aria-hidden="true">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="11" cy="11" r="7" />
                    <path d="m16 16 5 5" />
                </svg>
            </div>
        </div>

        <form asp-controller="Breeds"
              asp-action="Index"
              method="get"
              id="breedSearchForm"
              class="pa-breeds__search-form">

            <div class="pa-breeds__search-field">

                <label for="q">
                    Search breeds
                </label>

                <div class="pa-breeds__input-wrap">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <circle cx="11" cy="11" r="7" />
                        <path d="m16 16 5 5" />
                    </svg>

                    <input id="q"
                           type="search"
                           name="q"
                           value="@query"
                           class="pa-breeds__search-input"
                           placeholder="Labrador, Husky, Poodle..."
                           autocomplete="off" />
                </div>
            </div>

            <div class="pa-breeds__size-field">

                <label for="pageSize">
                    Results per page
                </label>

                <div class="pa-breeds__select-wrap">

                    <select id="pageSize"
                            name="pageSize"
                            class="pa-breeds__select">

                        @foreach (var size in new[] { 6, 12, 18, 24, 36 })
                        {
                            if (pageSize == size)
                            {
                                <option value="@size" selected>
                                    @size
                                </option>
                            }
                            else
                            {
                                <option value="@size">
                                    @size
                                </option>
                            }
                        }
                    </select>

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="m6 9 6 6 6-6" />
                    </svg>
                </div>
            </div>

            <button type="submit"
                    class="pa-breeds__search-button">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <circle cx="11" cy="11" r="7" />
                    <path d="m16 16 5 5" />
                </svg>

                Search Breeds
            </button>
        </form>

        @if (hasQuery)
        {
            <div class="pa-breeds__active-search">

                <span>
                    Searching for:
                    <strong>@query</strong>
                </span>

                <a asp-controller="Breeds"
                   asp-action="Index"
                   asp-route-pageSize="@pageSize">

                    Clear Search

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="M6 6l12 12" />
                        <path d="M18 6 6 18" />
                    </svg>
                </a>
            </div>
        }
    </section>

    @if (apiUnavailable)
    {
        <section class="pa-breeds__empty"
                 aria-labelledby="breedUnavailableTitle"
                 role="alert">

            <div class="pa-breeds__empty-icon
                        pa-breeds__empty-icon--warning"
                 aria-hidden="true">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M10.3 3.9 2.2 18a2 2 0 0 0 1.7 3h16.2a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
                    <path d="M12 9v5" />
                    <path d="M12 18h.01" />
                </svg>
            </div>

            <span class="pa-breeds__empty-eyebrow">
                TEMPORARILY UNAVAILABLE
            </span>

            <h2 id="breedUnavailableTitle">
                We couldn't load the breeds.
            </h2>

            <p>
                Breed information could not be retrieved
                from The Dog API. This doesn't necessarily
                mean that your search has no results.
                Please try again.
            </p>

            <a href="@BuildUrl(page)"
               class="pa-breeds__empty-action">

                Try Again

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <path d="M20 11a8 8 0 1 0-2 6" />
                    <path d="M20 4v7h-7" />
                </svg>
            </a>
        </section>
    }
    else if (Model.Count == 0)
    {
        <section class="pa-breeds__empty"
                 aria-labelledby="breedEmptyTitle">

            <div class="pa-breeds__empty-icon"
                 aria-hidden="true">

                <svg viewBox="0 0 64 64"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="27" cy="27" r="15" />
                    <path d="m39 39 16 16" />
                    <path d="M21 27h12" />
                </svg>
            </div>

            <span class="pa-breeds__empty-eyebrow">
                NO RESULTS FOUND
            </span>

            <h2 id="breedEmptyTitle">
                @(hasQuery
                    ? "No matching breeds found."
                    : "No breeds to display.")
            </h2>

            <p>
                @if (hasQuery)
                {
                    <text>
                        We couldn't find any breeds matching
                        your search. Try another name or
                        explore the full directory.
                    </text>
                }
                else
                {
                    <text>
                        There are no breed records available
                        to display right now.
                    </text>
                }
            </p>

            <a asp-controller="Breeds"
               asp-action="Index"
               asp-route-pageSize="@pageSize"
               class="pa-breeds__empty-action">

                Show All Breeds

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                </svg>
            </a>
        </section>
    }
    else
    {
        <section class="pa-breeds__catalog"
                 aria-labelledby="breedCatalogTitle">

            <div class="pa-breeds__catalog-heading">

                <div>
                    <span class="pa-breeds__section-eyebrow">
                        EXPLORE THE DIRECTORY
                    </span>

                    <h2 id="breedCatalogTitle">
                        @(hasQuery ? "Search Results" : "Meet the Breeds")
                    </h2>

                    <p>
                        @if (hasQuery)
                        {
                            <text>
                                Breeds matching your search.
                            </text>
                        }
                        else
                        {
                            <text>
                                Discover the characteristics
                                that make each breed unique.
                            </text>
                        }
                    </p>
                </div>

                <div class="pa-breeds__catalog-count">

                    <strong>@total</strong>

                    <span>
                        @(total == 1 ? "breed found" : "breeds found")
                    </span>
                </div>
            </div>

            <div class="pa-breeds__grid">

                @foreach (var breed in Model)
                {
                    var hasImage =
                        Uri.TryCreate(
                            breed.ImageUrl,
                            UriKind.Absolute,
                            out var imageUri
                        )
                        && (imageUri.Scheme == Uri.UriSchemeHttps
                            || imageUri.Scheme == Uri.UriSchemeHttp);

                    string lifeSpan;

                    if (breed.LifeSpanMinYears.HasValue &&
                        breed.LifeSpanMaxYears.HasValue)
                    {
                        lifeSpan =
                            $"{breed.LifeSpanMinYears.Value}–{breed.LifeSpanMaxYears.Value} years";
                    }
                    else if (breed.LifeSpanMinYears.HasValue)
                    {
                        lifeSpan =
                            $"From {breed.LifeSpanMinYears.Value} years";
                    }
                    else if (breed.LifeSpanMaxYears.HasValue)
                    {
                        lifeSpan =
                            $"Up to {breed.LifeSpanMaxYears.Value} years";
                    }
                    else
                    {
                        lifeSpan = "Not available";
                    }

                    var weight = breed.WeightKgAverage.HasValue
                        ? $"{breed.WeightKgAverage.Value:0.#} kg"
                        : "Not available";

                    var temperaments =
                        (breed.Temperaments ?? Array.Empty<string>())
                        .Where(t => !string.IsNullOrWhiteSpace(t))
                        .ToArray();

                    <article class="pa-breeds__card">

                        <div class="pa-breeds__media">

                            @if (hasImage)
                            {
                                <img src="@breed.ImageUrl"
                                     alt="@breed.Name dog"
                                     class="pa-breeds__image"
                                     data-pa-breed-image
                                     loading="lazy"
                                     decoding="async" />
                            }

                            <div class="pa-breeds__image-fallback"
                                 hidden="@hasImage"
                                 aria-hidden="true">

                                <svg viewBox="0 0 96 96"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2.2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <path d="M26 35 14 25l-7 18 12 13" />
                                    <path d="m70 35 12-10 7 18-12 13" />

                                    <path d="M21 43c0-19 11-30 27-30s27 11 27 30v14c0 17-11 28-27 28S21 74 21 57V43Z" />

                                    <path d="M34 49h3M59 49h3" />
                                    <path d="m42 62 6 5 6-5-6-4Z" />
                                    <path d="M48 67v6" />
                                </svg>
                            </div>

                            <span class="pa-breeds__media-badge">
                                DOG BREED
                            </span>
                        </div>

                        <div class="pa-breeds__card-body">

                            <div class="pa-breeds__card-heading">

                                <span class="pa-breeds__card-eyebrow">
                                    BREED PROFILE
                                </span>

                                <h3>@breed.Name</h3>
                            </div>

                            <div class="pa-breeds__attributes">

                                <div class="pa-breeds__attribute">

                                    <div class="pa-breeds__attribute-top">

                                        <span class="pa-breeds__attribute-icon">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round"
                                                 aria-hidden="true">

                                                <circle cx="12" cy="12" r="9" />
                                                <path d="M12 7v5l3 2" />
                                            </svg>
                                        </span>

                                        <span>Lifespan</span>
                                    </div>

                                    <strong>@lifeSpan</strong>
                                </div>

                                <div class="pa-breeds__attribute">

                                    <div class="pa-breeds__attribute-top">

                                        <span class="pa-breeds__attribute-icon">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round"
                                                 aria-hidden="true">

                                                <path d="M4 20h16" />
                                                <path d="m6 20 3-12h6l3 12" />
                                                <path d="M9 8a3 3 0 0 1 6 0" />
                                            </svg>
                                        </span>

                                        <span>Average weight</span>
                                    </div>

                                    <strong>@weight</strong>
                                </div>
                            </div>

                            <div class="pa-breeds__temperament">

                                <div class="pa-breeds__temperament-heading">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         aria-hidden="true">

                                        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
                                    </svg>

                                    Temperament
                                </div>

                                @if (temperaments.Length == 0)
                                {
                                    <p class="pa-breeds__temperament-empty">
                                        No temperament information available.
                                    </p>
                                }
                                else
                                {
                                    <div class="pa-breeds__tags">

                                        @foreach (var temperament in temperaments.Take(5))
                                        {
                                            <span class="pa-breeds__tag">
                                                @temperament
                                            </span>
                                        }

                                        @if (temperaments.Length > 5)
                                        {
                                            <span class="pa-breeds__tag
                                                         pa-breeds__tag--more"
                                                  title="@string.Join(", ", temperaments.Skip(5))">

                                                +@(temperaments.Length - 5) more
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="pa-breeds__card-footer">

                            <span class="pa-breeds__footer-icon"
                                  aria-hidden="true">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <circle cx="12" cy="12" r="9" />
                                    <path d="M12 11v5" />
                                    <path d="M12 8h.01" />
                                </svg>
                            </span>

                            Breed information from The Dog API
                        </div>
                    </article>
                }
            </div>

            @if (totalPages > 1)
            {
                <nav class="pa-breeds__pagination"
                     aria-label="Breed pagination">

                    <div class="pa-breeds__pagination-controls">

                        @if (page > 1)
                        {
                            <a href="@BuildUrl(page - 1)"
                               class="pa-breeds__page-arrow"
                               aria-label="Previous page">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">

                                    <path d="M19 12H5" />
                                    <path d="m11 18-6-6 6-6" />
                                </svg>

                                <span>Previous</span>
                            </a>
                        }
                        else
                        {
                            <span class="pa-breeds__page-arrow
                                         is-disabled"
                                  aria-disabled="true">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">

                                    <path d="M19 12H5" />
                                    <path d="m11 18-6-6 6-6" />
                                </svg>

                                <span>Previous</span>
                            </span>
                        }

                        <div class="pa-breeds__page-numbers">

                            @if (firstPage > 1)
                            {
                                <a href="@BuildUrl(1)"
                                   class="pa-breeds__page-number">
                                    1
                                </a>

                                @if (firstPage > 2)
                                {
                                    <span class="pa-breeds__page-ellipsis"
                                          aria-hidden="true">…</span>
                                }
                            }

                            @for (int i = firstPage; i <= lastPage; i++)
                            {
                                if (i == page)
                                {
                                    <span class="pa-breeds__page-number
                                                 is-current"
                                          aria-current="page">
                                        @i
                                    </span>
                                }
                                else
                                {
                                    <a href="@BuildUrl(i)"
                                       class="pa-breeds__page-number">
                                        @i
                                    </a>
                                }
                            }

                            @if (lastPage < totalPages)
                            {
                                @if (lastPage < totalPages - 1)
                                {
                                    <span class="pa-breeds__page-ellipsis"
                                          aria-hidden="true">…</span>
                                }

                                <a href="@BuildUrl(totalPages)"
                                   class="pa-breeds__page-number">
                                    @totalPages
                                </a>
                            }
                        </div>

                        @if (page < totalPages)
                        {
                            <a href="@BuildUrl(page + 1)"
                               class="pa-breeds__page-arrow"
                               aria-label="Next page">

                                <span>Next</span>

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">

                                    <path d="M5 12h14" />
                                    <path d="m13 6 6 6-6 6" />
                                </svg>
                            </a>
                        }
                        else
                        {
                            <span class="pa-breeds__page-arrow
                                         is-disabled"
                                  aria-disabled="true">

                                <span>Next</span>

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">

                                    <path d="M5 12h14" />
                                    <path d="m13 6 6 6-6 6" />
                                </svg>
                            </span>
                        }
                    </div>

                    <p class="pa-breeds__page-description">
                        Page @(page) of @totalPages
                    </p>
                </nav>
            }
        </section>
    }

    <section class="pa-breeds__bottom-cta">

        <div class="pa-breeds__bottom-icon"
             aria-hidden="true">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
            </svg>
        </div>

        <div>
            <h2>Looking for a companion?</h2>

            <p>
                Explore pets currently listed for adoption
                on PetAdoption.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index">

            Explore Pets

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">

                <path d="M5 12h14" />
                <path d="m13 6 6 6-6 6" />
            </svg>
        </a>
    </section>
</div>

@section Styles {
    <style>
        .pa-breeds {
            width: 100%;
            max-width: 1350px;
            margin: 0 auto 55px;
            color: #173d32;
        }

        .pa-breeds [hidden] {
