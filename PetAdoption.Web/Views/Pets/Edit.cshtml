@using Microsoft.AspNetCore.Mvc.Rendering
@using PetAdoption.Application.DTOs
@using PetAdoption.Domain.Enums
@model PetAdoption.Web.Models.Pets.PetFormVm

@{
    ViewData["Title"] = "Edit Pet";
    ViewData["Description"] = "Update the details of an existing pet adoption profile.";

    var shelters = ViewBag.Shelters as IReadOnlyList<ShelterDto>
        ?? Array.Empty<ShelterDto>();

    var selectedShelter = shelters.FirstOrDefault(s => s.Id == Model.ShelterId);
    var shelterOptions = new SelectList(
        shelters,
        nameof(ShelterDto.Id),
        nameof(ShelterDto.Name),
        Model.ShelterId);

    var isAdmin = User.IsInRole("Admin");
    var isWorkflowStatus = Model.Status == PetStatus.Reserved
        || Model.Status == PetStatus.Adopted;
}

<div class="pa-pet-edit">
    <nav class="pa-pet-edit__breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Welcome">Home</a>
        <span aria-hidden="true">/</span>
        <a asp-controller="Pets" asp-action="Index">Pet Management</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Edit Pet</span>
    </nav>

    <header class="pa-pet-edit__hero">
        <div class="pa-pet-edit__hero-content">
            <div class="pa-pet-edit__eyebrow">
                <span class="pa-pet-edit__eyebrow-dot"></span>
                PET MANAGEMENT WORKSPACE
            </div>
            <h1>
                Every detail matters.
                <span>Keep their story current.</span>
            </h1>
            <p>
                Update @(Model.Name)'s adoption profile with the latest information,
                so potential adopters can understand who they are and what they need.
            </p>
            <a asp-controller="Pets" asp-action="Index"
               class="pa-pet-edit__hero-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <path d="M19 12H5" />
                    <path d="m11 18-6-6 6-6" />
                </svg>
                Back to Pet Management
            </a>
        </div>
        <div class="pa-pet-edit__hero-art" aria-hidden="true">
            <div class="pa-pet-edit__art-circle"></div>
            <div class="pa-pet-edit__art-circle-inner"></div>
            <svg viewBox="0 0 100 100" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="25" cy="31" r="7" />
                <circle cx="44" cy="19" r="7" />
                <circle cx="64" cy="25" r="7" />
                <circle cx="78" cy="43" r="7" />
                <path d="M48 43c-12 0-18 12-27 23-7 9-2 22 8 22 8 0 12-5 19-5s11 5 19 5c10 0 15-13 8-22-9-11-15-23-27-23Z" />
            </svg>
        </div>
    </header>

    <div class="pa-pet-edit__layout">
        <main class="pa-pet-edit__main">
            <form asp-controller="Pets" asp-action="Edit"
                  method="post" asp-antiforgery="true"
                  novalidate id="petEditForm">
                <input type="hidden" asp-for="Id" />

                <section class="pa-pet-edit__panel" aria-labelledby="editBasicInfoTitle">
                    <div class="pa-pet-edit__panel-header">
                        <div class="pa-pet-edit__panel-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <circle cx="12" cy="8" r="4" />
                                <path d="M4 21v-2a8 8 0 0 1 16 0v2" />
                            </svg>
                        </div>
                        <div>
                            <span class="pa-pet-edit__section-label">SECTION 01</span>
                            <h2 id="editBasicInfoTitle">Basic Information</h2>
                            <p>Keep the pet's identity and personality details accurate.</p>
                        </div>
                    </div>

                    <div asp-validation-summary="ModelOnly"
                         class="pa-pet-edit__validation text-danger"
                         role="alert"></div>

                    <div class="pa-pet-edit__fields">
                        <div class="pa-pet-edit__field">
                            <label asp-for="Name" class="pa-pet-edit__label">Pet Name</label>
                            <input asp-for="Name" class="pa-pet-edit__input form-control"
                                   maxlength="128" placeholder="e.g. Buddy" />
                            <span asp-validation-for="Name"
                                  class="pa-pet-edit__field-error"></span>
                        </div>

                        <div class="pa-pet-edit__field">
                            <label asp-for="Species" class="pa-pet-edit__label">Species</label>
                            <select asp-for="Species" asp-items="Html.GetEnumSelectList<Species>()"
                                    class="pa-pet-edit__input pa-pet-edit__select form-select"></select>
                            <span asp-validation-for="Species"
                                  class="pa-pet-edit__field-error"></span>
                        </div>

                        <div class="pa-pet-edit__field">
                            <label asp-for="Breed" class="pa-pet-edit__label">Breed</label>
                            <input asp-for="Breed" maxlength="128"
                                   class="pa-pet-edit__input form-control"
                                   placeholder="e.g. Labrador Retriever" />
                            <span asp-validation-for="Breed"
                                  class="pa-pet-edit__field-error"></span>
                        </div>

                        <div class="pa-pet-edit__field">
                            <label asp-for="AgeYears" class="pa-pet-edit__label">Age</label>
                            <div class="pa-pet-edit__age-input">
                                <input asp-for="AgeYears" type="number" min="0" max="200"
                                       class="pa-pet-edit__input form-control"
                                       aria-describedby="petEditAgeUnit" />
                                <span id="petEditAgeUnit">years</span>
                            </div>
                            <span asp-validation-for="AgeYears"
                                  class="pa-pet-edit__field-error"></span>
                        </div>

                        <div class="pa-pet-edit__field pa-pet-edit__field--full">
                            <label asp-for="Description" class="pa-pet-edit__label">
                                About This Pet
                            </label>
                            <p class="pa-pet-edit__field-help">
                                Describe temperament, favorite activities, training,
                                health considerations or special care needs.
                            </p>
                            <textarea asp-for="Description" rows="6" maxlength="1024"
                                      class="pa-pet-edit__input pa-pet-edit__textarea form-control"
                                      placeholder="Help future adopters get to know this pet..."></textarea>
                            <span asp-validation-for="Description"
                                  class="pa-pet-edit__field-error"></span>
                            <span class="pa-pet-edit__entry-count" id="descriptionCharacterCount"
                                  aria-live="off">0 / 1024 characters</span>
                        </div>
                    </div>
                </section>

                <section class="pa-pet-edit__panel" aria-labelledby="editPhotoShelterTitle">
                    <div class="pa-pet-edit__panel-header">
                        <div class="pa-pet-edit__panel-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="3" />
                                <circle cx="8.5" cy="8.5" r="1.5" />
                                <path d="m21 15-5-5L5 21" />
                            </svg>
                        </div>
                        <div>
                            <span class="pa-pet-edit__section-label">SECTION 02</span>
                            <h2 id="editPhotoShelterTitle">Photo &amp; Shelter</h2>
                            <p>Refresh the photo and review the shelter assignment.</p>
                        </div>
                    </div>
                    <div class="pa-pet-edit__fields">
                        <div class="pa-pet-edit__field pa-pet-edit__field--full">
                            <label asp-for="ImageUrl" class="pa-pet-edit__label">
                                Pet Photo URL
                            </label>
                            <div class="pa-pet-edit__url-field">
                                <span aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="1.8"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M10 13a5 5 0 0 0 7 .5l3-3a5 5 0 0 0-7-7l-1.7 1.7" />
                                        <path d="M14 11a5 5 0 0 0-7-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" />
                                    </svg>
                                </span>
                                <input asp-for="ImageUrl" type="url" maxlength="512"
                                       class="pa-pet-edit__input form-control"
                                       placeholder="https://example.com/pet.jpg" />
                            </div>
                            <span asp-validation-for="ImageUrl"
                                  class="pa-pet-edit__field-error"></span>
                            <p class="pa-pet-edit__field-help pa-pet-edit__field-help--bottom">
                                Add a public HTTP or HTTPS image link. A missing or broken
                                image will show a neutral illustration in the preview.
                            </p>
                        </div>

                        <div class="pa-pet-edit__field">
                            <label asp-for="ShelterId" class="pa-pet-edit__label">Shelter</label>
                            @if (isAdmin && !isWorkflowStatus)
                            {
                                <select asp-for="ShelterId" asp-items="shelterOptions"
                                        class="pa-pet-edit__input pa-pet-edit__select form-select">
                                    <option value="">Select a shelter</option>
                                </select>
                            }
                            else
                            {
                                <input type="hidden" asp-for="ShelterId" />
                                <input id="shelterDisplay" type="text"
                                       class="pa-pet-edit__input pa-pet-edit__readonly form-control"
                                       value="@(selectedShelter?.Name ?? "Current shelter")" readonly />
                            }
                            <span asp-validation-for="ShelterId"
                                  class="pa-pet-edit__field-error"></span>
                            @if (isAdmin)
                            {
                                <p class="pa-pet-edit__field-help pa-pet-edit__field-help--bottom">
                                    Shelter reassignment may be blocked when a pet has adoption
                                    history, or when its status is Reserved or Adopted.
                                </p>
                            }
                            else
                            {
                                <p class="pa-pet-edit__field-help pa-pet-edit__field-help--bottom">
                                    Only an administrator can change a pet's shelter.
                                </p>
                            }
                        </div>

                        <div class="pa-pet-edit__field">
                            <label asp-for="Status" class="pa-pet-edit__label">Adoption Status</label>
                            @if (isWorkflowStatus)
                            {
                                <input type="hidden" asp-for="Status" />
                                <div class="pa-pet-edit__locked-status" aria-describedby="petStatusRule">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.8" stroke-linecap="round"
                                         stroke-linejoin="round" aria-hidden="true">
                                        <rect x="5" y="10" width="14" height="11" rx="2" />
                                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                                    </svg>
                                    <strong>@Model.Status</strong>
                                </div>
                            }
                            else
                            {
                                <select asp-for="Status" id="Status"
                                        class="pa-pet-edit__input pa-pet-edit__select form-select"
                                        aria-describedby="petStatusRule">
                                    <option value="@((int)PetStatus.Available)">Available</option>
                                    <option value="@((int)PetStatus.Unavailable)">Unavailable</option>
                                </select>
                            }
                            <span asp-validation-for="Status"
                                  class="pa-pet-edit__field-error"></span>
                            <p id="petStatusRule" class="pa-pet-edit__info-note">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="9" />
                                    <path d="M12 11v5" />
                                    <path d="M12 8h.01" />
                                </svg>
                                <span>
                                    <strong>Reserved</strong> and <strong>Adopted</strong> statuses
                                    are managed by the adoption workflow, not through this form.
                                    Only Available and Unavailable are manually editable when the status is not locked.
                                </span>
                            </p>
                        </div>
                    </div>
                </section>

                <div class="pa-pet-edit__form-actions">
                    <div class="pa-pet-edit__save-information">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round"
                             stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 11v5" />
                            <path d="M12 8h.01" />
                        </svg>
                        <span>Review the changes before saving the profile.</span>
                    </div>
                    <div class="pa-pet-edit__buttons">
                        <a asp-controller="Pets" asp-action="Details"
                           asp-route-id="@Model.Id" class="pa-pet-edit__cancel">
                            Cancel
                        </a>
                        <button type="submit" class="pa-pet-edit__submit">
                            <svg viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="m5 12 4 4L19 6" />
                            </svg>
                            Save Changes
                            <svg viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M5 12h14" />
                                <path d="m13 6 6 6-6 6" />
                            </svg>
                        </button>
                    </div>
                </div>
            </form>
        </main>

        <aside class="pa-pet-edit__sidebar" aria-label="Pet profile preview and guidance">
            <section class="pa-pet-edit__preview-panel">
                <div class="pa-pet-edit__sidebar-heading">
                    <span class="pa-pet-edit__section-label">LIVE PREVIEW</span>
                    <h2>Updated Profile Preview</h2>
                    <p>See how the adoption card changes as you edit its details.</p>
                </div>
                <div class="pa-pet-edit__preview-card">
                    <div class="pa-pet-edit__preview-media">
                        <img id="petPreviewImage" alt="Pet profile preview" hidden />
                        <div id="petPreviewFallback"
                             class="pa-pet-edit__preview-fallback" aria-hidden="true">
                            <svg viewBox="0 0 100 100" fill="none"
                                 stroke="currentColor" stroke-width="2.1"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="25" cy="31" r="7" />
                                <circle cx="44" cy="19" r="7" />
                                <circle cx="64" cy="25" r="7" />
                                <circle cx="78" cy="43" r="7" />
                                <path d="M48 43c-12 0-18 12-27 23-7 9-2 22 8 22 8 0 12-5 19-5s11 5 19 5c10 0 15-13 8-22-9-11-15-23-27-23Z" />
                            </svg>
                            <span>No photo available</span>
                        </div>
                        <span id="petPreviewStatus"
                              class="pa-pet-edit__preview-status pa-pet-edit__preview-status--@(Model.Status.ToString().ToLowerInvariant())">
                            <span></span>
                            <span id="petPreviewStatusLabel">@Model.Status</span>
                        </span>
                    </div>
                    <div class="pa-pet-edit__preview-body">
                        <span class="pa-pet-edit__preview-eyebrow">MEET YOUR NEW FRIEND</span>
                        <div class="pa-pet-edit__preview-title-row">
                            <h3 id="petPreviewName">@Model.Name</h3>
                            <span id="petPreviewAge" class="pa-pet-edit__preview-age">
                                @Model.AgeYears @(Model.AgeYears == 1 ? "yr" : "yrs")
                            </span>
                        </div>
                        <p id="petPreviewBreed" class="pa-pet-edit__preview-breed">
                            @(string.IsNullOrWhiteSpace(Model.Breed)
                                                        ? "Breed not specified" : Model.Breed)
                        </p>
                        <span id="petPreviewSpecies" class="pa-pet-edit__preview-species">
                            @Model.Species
                        </span>
                        <p id="petPreviewDescription" class="pa-pet-edit__preview-description">
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                                        ? "A short introduction to your pet will appear here."
                                                        : Model.Description)
                        </p>
                        <div class="pa-pet-edit__preview-shelter">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 10 12 3l9 7" />
                                <path d="M5 9v11h14V9" />
                                <path d="M9 20v-7h6v7" />
                            </svg>
                            <span id="petPreviewShelter">
                                @(selectedShelter?.Name ?? "Current shelter")
                            </span>
                        </div>
                    </div>
                </div>
                <p class="pa-pet-edit__preview-note">
                    The preview is illustrative. No changes are saved until
                    you select <strong>Save Changes</strong>.
                </p>
                <a asp-controller="Pets" asp-action="Details"
                   asp-route-id="@Model.Id" class="pa-pet-edit__profile-link">
                    View current pet profile
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M5 12h14" />
                        <path d="m13 6 6 6-6 6" />
                    </svg>
                </a>
            </section>
            <section class="pa-pet-edit__tips">
                <div class="pa-pet-edit__tips-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 18h6" />
                        <path d="M10 22h4" />
                        <path d="M8.5 14.5A7 7 0 1 1 15.5 14.5C14.6 15.4 14 16 14 18h-4c0-2-.6-2.6-1.5-3.5Z" />
                    </svg>
                </div>
                <span class="pa-pet-edit__section-label">PROFILE GUIDANCE</span>
                <h2>Help adopters see the full picture.</h2>
                <p>Complete, accurate details help people understand this pet's needs.</p>
                <ul class="pa-pet-edit__tips-list">
                    <li>Use current, honest information.</li>
                    <li>Describe temperament and care requirements.</li>
                    <li>Choose a clear, recent photograph.</li>
                    <li>Use the adoption workflow for Reserved/Adopted.</li>
                </ul>
            </section>
        </aside>
    </div>
</div>

@section Styles {
    <style>
        .pa-pet-edit {
            max-width: 1350px;
            margin: 0 auto 60px;
            color: #173d32;
        }

            .pa-pet-edit [hidden] {
                display: none !important;
            }

        .pa-pet-edit__breadcrumb {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 11px;
            margin-bottom: 24px;
            color: #89968b;
            font-size: .82rem;
        }

            .pa-pet-edit__breadcrumb a {
                color: #637a69;
                text-decoration: none;
            }

                .pa-pet-edit__breadcrumb a:hover {
                    color: #c8914e;
                }

            .pa-pet-edit__breadcrumb [aria-current="page"] {
                color: #173d32;
                font-weight: 700;
            }

        .pa-pet-edit__hero {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
            min-height: 310px;
            margin-bottom: 30px;
            padding: clamp(30px, 4.5vw, 58px);
            overflow: hidden;
            border-radius: 28px;
            background: radial-gradient( circle at 85% 40%, rgba(244,197,122,.15), transparent 38% ), linear-gradient(125deg,#173d32,#245847);
            box-shadow: 0 22px 48px rgba(23,61,50,.15);
        }

        .pa-pet-edit__hero-content {
            position: relative;
            z-index: 2;
            max-width: 720px;
        }

        .pa-pet-edit__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 22px;
            color: #f4c57a;
            font-size: .71rem;
            font-weight: 800;
            letter-spacing: .14em;
        }

        .pa-pet-edit__eyebrow-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #f4c57a;
            box-shadow: 0 0 0 5px rgba(244,197,122,.13);
        }

        .pa-pet-edit__hero h1 {
            margin: 0;
            color: #fff;
            font-family: "Fraunces",Georgia,serif;
            font-size: clamp(2.5rem,4.5vw,4.2rem);
            font-weight: 600;
            letter-spacing: -.055em;
            line-height: 1.12;
        }

            .pa-pet-edit__hero h1 span {
                display: block;
                color: #f4c57a;
            }

        .pa-pet-edit__hero p {
            max-width: 540px;
            margin: 22px 0;
            color: rgba(255,255,255,.82);
            font-size: .94rem;
            line-height: 1.85;
        }

        .pa-pet-edit__hero-back {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #fff;
            font-size: .84rem;
            font-weight: 800;
            text-decoration: none;
        }

            .pa-pet-edit__hero-back:hover {
                color: #f4c57a;
            }

            .pa-pet-edit__hero-back svg {
                width: 18px;
                height: 18px;
            }

        .pa-pet-edit__hero-art {
            position: relative;
            display: grid;
            width: 230px;
            height: 230px;
            flex-shrink: 0;
            place-items: center;
            margin-right: 15px;
            color: #f4c57a;
        }

        .pa-pet-edit__art-circle,
        .pa-pet-edit__art-circle-inner {
            position: absolute;
            border: 1px solid rgba(244,197,122,.23);
            border-radius: 50%;
        }

        .pa-pet-edit__art-circle {
            inset: 0;
        }

        .pa-pet-edit__art-circle-inner {
            inset: 33px;
            background: rgba(255,255,255,.04);
        }

        .pa-pet-edit__hero-art > svg {
            position: relative;
            width: 120px;
            height: 120px;
            opacity: .9;
        }

        .pa-pet-edit__layout {
            display: grid;
            grid-template-columns: minmax(0,1fr) 325px;
            align-items: start;
            gap: 25px;
        }

        .pa-pet-edit__main,
        .pa-pet-edit__sidebar {
            min-width: 0;
        }

        .pa-pet-edit__panel {
            margin-bottom: 23px;
            padding: clamp(24px,3.4vw,42px);
            border: 1px solid #e2eae0;
            border-radius: 24px;
            background: #fffefa;
            box-shadow: 0 12px 35px rgba(23,61,50,.045);
        }

        .pa-pet-edit__panel-header {
            display: flex;
            align-items: center;
            gap: 17px;
            margin-bottom: 30px;
            padding-bottom: 25px;
            border-bottom: 1px solid #e9eee6;
        }

        .pa-pet-edit__panel-icon {
            display: grid;
            width: 54px;
            height: 54px;
            flex-shrink: 0;
            place-items: center;
            border: 1px solid #d7e5d6;
            border-radius: 16px;
            background: #edf5eb;
            color: #245847;
        }

            .pa-pet-edit__panel-icon svg {
                width: 27px;
                height: 27px;
            }

        .pa-pet-edit__section-label {
            display: block;
            margin-bottom: 8px;
            color: #a97843;
            font-size: .68rem;
            font-weight: 800;
            letter-spacing: .14em;
        }

        .pa-pet-edit__panel-header h2,
        .pa-pet-edit__sidebar-heading h2 {
            margin: 0 0 7px;
            color: #173d32;
            font-family: "Fraunces",Georgia,serif;
            font-size: clamp(1.55rem,2.4vw,2.05rem);
            font-weight: 600;
            letter-spacing: -.04em;
        }

        .pa-pet-edit__panel-header p,
        .pa-pet-edit__sidebar-heading p {
            margin: 0;
            color: #819084;
            font-size: .83rem;
            line-height: 1.7;
        }

        .pa-pet-edit__validation {
            margin-bottom: 23px;
            padding: 15px 18px;
            border: 1px solid #efcec8;
