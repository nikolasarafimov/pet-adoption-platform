@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            "use strict";
            const form = document.getElementById("petEditForm");
            if (!form) return;

            const nameInput = document.getElementById("Name");
            const speciesInput = document.getElementById("Species");
            const breedInput = document.getElementById("Breed");
            const ageInput = document.getElementById("AgeYears");
            const descriptionInput = document.getElementById("Description");
            const imageUrlInput = document.getElementById("ImageUrl");
            const shelterSelect = document.querySelector("select#ShelterId");
            const shelterDisplay = document.getElementById("shelterDisplay");
            const statusSelect = document.querySelector("select#Status");

            const previewName = document.getElementById("petPreviewName");
            const previewSpecies = document.getElementById("petPreviewSpecies");
            const previewBreed = document.getElementById("petPreviewBreed");
            const previewAge = document.getElementById("petPreviewAge");
            const previewDescription = document.getElementById("petPreviewDescription");
            const previewShelter = document.getElementById("petPreviewShelter");
            const previewStatus = document.getElementById("petPreviewStatus");
            const previewStatusLabel = document.getElementById("petPreviewStatusLabel");
            const previewImage = document.getElementById("petPreviewImage");
            const previewFallback = document.getElementById("petPreviewFallback");
            const characterCount = document.getElementById("descriptionCharacterCount");

            const updateDetails = () => {
                const name = nameInput?.value.trim() || "";
                previewName.textContent = name || "Your Pet's Name";
                previewBreed.textContent = breedInput?.value.trim() || "Breed not specified";
                previewDescription.textContent = descriptionInput?.value.trim() ||
                    "A short introduction to your pet will appear here.";
                characterCount.textContent = `${descriptionInput?.value.length || 0} / 1024 characters`;

                const speciesOption = speciesInput?.selectedOptions?.[0];
                previewSpecies.textContent = speciesOption?.textContent.trim() || "Species";

                const ageValue = ageInput?.value.trim();
                const age = Number(ageValue);
                previewAge.textContent = ageValue !== "" && ageValue != null &&
                    Number.isFinite(age) && age >= 0
                    ? `${age} ${age === 1 ? "yr" : "yrs"}` : "Age";

                if (shelterSelect?.value) {
                    previewShelter.textContent =
                        shelterSelect.selectedOptions[0]?.textContent.trim() || "Shelter not selected";
                } else if (shelterDisplay) {
                    previewShelter.textContent = shelterDisplay.value || "Current shelter";
                } else {
                    previewShelter.textContent = "Shelter not selected";
                }

                if (statusSelect) {
                    const statusLabel = statusSelect.selectedOptions[0]?.textContent.trim() || "Available";
                    previewStatusLabel.textContent = statusLabel;
                    previewStatus.classList.remove(
                        "pa-pet-edit__preview-status--available",
                        "pa-pet-edit__preview-status--unavailable",
                        "pa-pet-edit__preview-status--reserved",
                        "pa-pet-edit__preview-status--adopted",
                        "pa-pet-edit__preview-status--unknown");
                    const statusClass = statusLabel.toLowerCase() === "unavailable"
                        ? "pa-pet-edit__preview-status--unavailable"
                        : "pa-pet-edit__preview-status--available";
                    previewStatus.classList.add(statusClass);
                }

                previewImage.alt = name ? `Photo preview of ${name}` : "Pet photo preview";
            };

            let imageTimer;
            let currentImageUrl = null;
            const showFallback = () => {
                previewImage.hidden = true;
                previewFallback.hidden = false;
            };

            const updateImage = () => {
                const value = imageUrlInput?.value.trim() || "";
                if (value === currentImageUrl) return;
                currentImageUrl = value;

                let valid = false;
                if (value) {
                    try {
                        const candidate = new URL(value);
                        valid = candidate.protocol === "http:" || candidate.protocol === "https:";
                    } catch { }
                }

                if (!valid) {
                    previewImage.removeAttribute("src");
                    showFallback();
                    return;
                }
                showFallback();
                previewImage.src = value;
            };

            previewImage.addEventListener("load", () => {
                previewImage.hidden = false;
                previewFallback.hidden = true;
            });
            previewImage.addEventListener("error", showFallback);

            [nameInput, speciesInput, breedInput, ageInput, descriptionInput,
                shelterSelect, statusSelect].forEach(input => {
                if (!input) return;
                input.addEventListener("input", updateDetails);
                input.addEventListener("change", updateDetails);
            });

            imageUrlInput?.addEventListener("input", () => {
                clearTimeout(imageTimer);
                imageTimer = setTimeout(updateImage, 350);
            });
            imageUrlInput?.addEventListener("change", () => {
                clearTimeout(imageTimer);
                updateImage();
            });

            updateDetails();
            updateImage();
        })();
    </script>
}