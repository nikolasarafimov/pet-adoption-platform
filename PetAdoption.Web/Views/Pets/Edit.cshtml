@using Microsoft.AspNetCore.Mvc.Rendering
@using PetAdoption.Application.DTOs
@using PetAdoption.Domain.Enums
@model PetAdoption.Web.Models.Pets.PetFormVm

@{
    ViewData["Title"] = "Edit Pet";

    var shelters =
        ViewBag.Shelters as IReadOnlyList<ShelterDto>
        ?? Array.Empty<ShelterDto>();

    var selectedShelter =
        shelters.FirstOrDefault(s =>
            s.Id == Model.ShelterId
        );
}

<section class="mb-4">
    <a asp-action="Index"
       class="btn btn-sm btn-outline-secondary mb-4">
        ← Back to Pets
    </a>

    <div class="text-primary fw-semibold text-uppercase small mb-2">
        Pet Management
    </div>

    <h1 class="section-title mb-2">
        Edit @Model.Name
    </h1>

    <p class="section-subtitle mb-0">
        Keep the adoption profile accurate and up to date.
    </p>
</section>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card p-4 p-md-5">
            <form asp-action="Edit"
                  method="post"
                  novalidate>

                <input type="hidden"
                       asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger mb-4">
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Species"
                               class="form-label">
                        </label>

                        <select asp-for="Species"
                                class="form-select"
                                asp-items="Html.GetEnumSelectList<Species>()">
                        </select>

                        <span asp-validation-for="Species"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Breed"
                               class="form-label">
                        </label>

                        <input asp-for="Breed"
                               class="form-control" />

                        <span asp-validation-for="Breed"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AgeYears"
                               class="form-label">
                        </label>

                        <div class="input-group">
                            <input asp-for="AgeYears"
                                   type="number"
                                   class="form-control"
                                   min="0"
                                   max="200" />

                            <span class="input-group-text">
                                years
                            </span>
                        </div>

                        <span asp-validation-for="AgeYears"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description"
                               class="form-label">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ImageUrl"
                               class="form-label">
                        </label>

                        <input asp-for="ImageUrl"
                               id="imageUrl"
                               type="url"
                               class="form-control" />

                        <span asp-validation-for="ImageUrl"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ShelterId"
                               class="form-label">
                            Shelter
                        </label>

                        @if (User.IsInRole("Admin"))
                        {
                            <select asp-for="ShelterId"
                                    class="form-select"
                                    asp-items="@(new SelectList(
                                                                            shelters,
                                                                            nameof(ShelterDto.Id),
                                                                            nameof(ShelterDto.Name),
                                                                            Model.ShelterId
                                                                        ))">
                        </select>
                                                }
                        else
                        {
                            <input type="hidden"
                                   asp-for="ShelterId" />

                            <input type="text"
                                   class="form-control"
                                   value="@(selectedShelter?.Name ?? "Current shelter")"
                                   readonly />
                        }

                        <span asp-validation-for="ShelterId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status"
                               class="form-label">
                        </label>

                        <select asp-for="Status"
                                class="form-select"
                                asp-items="Html.GetEnumSelectList<PetStatus>()">
                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2 mt-5">
                    <button type="submit"
                            class="btn btn-primary px-4">
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card p-4 sticky-xl-top"
             style="top: 110px;">
            <div class="text-primary fw-semibold text-uppercase small mb-2">
                Current Preview
            </div>

            <h5 class="mb-3">
                @Model.Name
            </h5>

            <div class="rounded-4 overflow-hidden bg-light mb-3">
                <img id="imagePreview"
                     src="@(string.IsNullOrWhiteSpace(Model.ImageUrl)
                                              ? "https://placehold.co/800x600?text=Pet+Preview"
                                              : Model.ImageUrl)"
                     alt="@Model.Name"
                     class="w-100 object-fit-cover"
                     style="height: 250px;" />
            </div>

            <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-light text-dark">
                    @Model.Species
                </span>

                <span class="badge bg-light text-dark">
                    @Model.AgeYears yrs
                </span>

                <span class="badge bg-primary">
                    @Model.Status
                </span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const imageUrl =
            document.getElementById('imageUrl');

        const imagePreview =
            document.getElementById('imagePreview');

        function updatePreview() {
            const url = imageUrl.value.trim();

            imagePreview.src =
                url ||
                'https://placehold.co/800x600?text=Pet+Preview';
        }

        imageUrl.addEventListener(
            'input',
            updatePreview
        );

        imagePreview.addEventListener(
            'error',
            function () {
                imagePreview.src =
                    'https://placehold.co/800x600?text=Invalid+Image';
            }
        );
    </script>
}