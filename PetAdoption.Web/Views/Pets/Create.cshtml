@using Microsoft.AspNetCore.Mvc.Rendering
@using PetAdoption.Application.DTOs
@using PetAdoption.Domain.Enums
@model PetAdoption.Web.Models.Pets.PetFormVm

@{
    ViewData["Title"] = "Add New Pet";
    ViewData["Description"] = "Create a new pet adoption profile.";

    var shelters = ViewBag.Shelters as IReadOnlyList<ShelterDto>
        ?? Array.Empty<ShelterDto>();

    var selectedShelter = shelters.FirstOrDefault(s =>
        s.Id == Model.ShelterId);

    var shelterOptions = new SelectList(
        shelters,
        nameof(ShelterDto.Id),
        nameof(ShelterDto.Name),
        Model.ShelterId
    );

    var isAdmin = User.IsInRole("Admin");
}

<div class="pa-pet-create">

    <nav class="pa-pet-create__breadcrumb"
         aria-label="Breadcrumb">

        <a asp-controller="Home"
           asp-action="Welcome">Home</a>

        <span aria-hidden="true">/</span>

        <a asp-controller="Pets"
           asp-action="Index">Pet Management</a>

        <span aria-hidden="true">/</span>

        <span aria-current="page">Add Pet</span>
    </nav>

    <header class="pa-pet-create__hero">

        <div class="pa-pet-create__hero-content">

            <div class="pa-pet-create__eyebrow">
                <span class="pa-pet-create__eyebrow-dot"></span>
                PET MANAGEMENT WORKSPACE
            </div>

            <h1>
                Every story deserves
                <span>a new beginning.</span>
            </h1>

            <p>
                Create a thoughtful adoption profile.
                Share the details that make this pet special
                and help future adopters get to know them.
            </p>

            <a asp-controller="Pets"
               asp-action="Index"
               class="pa-pet-create__hero-back">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M19 12H5" />
                    <path d="m11 18-6-6 6-6" />
                </svg>

                Back to Pet Management
            </a>
        </div>

        <div class="pa-pet-create__hero-art"
             aria-hidden="true">

            <div class="pa-pet-create__art-circle"></div>
            <div class="pa-pet-create__art-circle-inner"></div>

            <svg viewBox="0 0 100 100"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <circle cx="25" cy="31" r="7" />
                <circle cx="44" cy="19" r="7" />
                <circle cx="64" cy="25" r="7" />
                <circle cx="78" cy="43" r="7" />

                <path d="M48 43c-12 0-18 12-27 23-7 9-2 22 8 22 8 0 12-5 19-5s11 5 19 5c10 0 15-13 8-22-9-11-15-23-27-23Z" />
            </svg>
        </div>
    </header>

    <div class="pa-pet-create__layout">

        <main class="pa-pet-create__main">

            <form asp-controller="Pets"
                  asp-action="Create"
                  method="post"
                  asp-antiforgery="true"
                  novalidate
                  id="petCreateForm">

                <section class="pa-pet-create__panel"
                         aria-labelledby="basicInformationTitle">

                    <div class="pa-pet-create__panel-header">

                        <div class="pa-pet-create__panel-icon"
                             aria-hidden="true">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">
                                <circle cx="12" cy="8" r="4" />
                                <path d="M4 21v-2a8 8 0 0 1 16 0v2" />
                            </svg>
                        </div>

                        <div>
                            <span class="pa-pet-create__section-label">
                                SECTION 01
                            </span>

                            <h2 id="basicInformationTitle">
                                Basic Information
                            </h2>

                            <p>
                                Introduce the pet and describe
                                what makes them unique.
                            </p>
                        </div>
                    </div>

                    <div asp-validation-summary="ModelOnly"
                         class="pa-pet-create__validation text-danger"
                         role="alert"></div>

                    <div class="pa-pet-create__fields">

                        <div class="pa-pet-create__field">

                            <label asp-for="Name"
                                   class="pa-pet-create__label">
                                Pet Name
                            </label>

                            <input asp-for="Name"
                                   class="pa-pet-create__input form-control"
                                   placeholder="e.g. Buddy" />

                            <span asp-validation-for="Name"
                                  class="pa-pet-create__field-error"></span>
                        </div>

                        <div class="pa-pet-create__field">

                            <label asp-for="Species"
                                   class="pa-pet-create__label">
                                Species
                            </label>

                            <select asp-for="Species"
                                    asp-items="Html.GetEnumSelectList<Species>()"
                                    class="pa-pet-create__input pa-pet-create__select form-select">
                            </select>

                            <span asp-validation-for="Species"
                                  class="pa-pet-create__field-error"></span>
                        </div>

                        <div class="pa-pet-create__field">

                            <label asp-for="Breed"
                                   class="pa-pet-create__label">
                                Breed
                            </label>

                            <input asp-for="Breed"
                                   class="pa-pet-create__input form-control"
                                   placeholder="e.g. Labrador Retriever" />

                            <span asp-validation-for="Breed"
                                  class="pa-pet-create__field-error"></span>
                        </div>

                        <div class="pa-pet-create__field">

                            <label asp-for="AgeYears"
                                   class="pa-pet-create__label">
                                Age
                            </label>

                            <div class="pa-pet-create__age-input">

                                <input asp-for="AgeYears"
                                       type="number"
                                       min="0"
                                       max="200"
                                       class="pa-pet-create__input form-control"
                                       aria-describedby="ageUnit" />

                                <span id="ageUnit">years</span>
                            </div>

                            <span asp-validation-for="AgeYears"
                                  class="pa-pet-create__field-error"></span>
                        </div>

                        <div class="pa-pet-create__field
                                    pa-pet-create__field--full">

                            <label asp-for="Description"
                                   class="pa-pet-create__label">
                                About This Pet
                            </label>

                            <p class="pa-pet-create__field-help">
                                Describe the pet's personality,
                                behavior, training and any
                                important care requirements.
                            </p>

                            <textarea asp-for="Description"
                                      rows="6"
                                      class="pa-pet-create__input pa-pet-create__textarea form-control"
                                      placeholder="Tell future adopters about this pet's personality, favorite activities and what kind of home would suit them best..."></textarea>

                            <span asp-validation-for="Description"
                                  class="pa-pet-create__field-error"></span>
                        </div>
                    </div>
                </section>

                <section class="pa-pet-create__panel"
                         aria-labelledby="photoShelterTitle">

                    <div class="pa-pet-create__panel-header">

                        <div class="pa-pet-create__panel-icon"
                             aria-hidden="true">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="3" />
                                <circle cx="8.5" cy="8.5" r="1.5" />
                                <path d="m21 15-5-5L5 21" />
                            </svg>
                        </div>

                        <div>
                            <span class="pa-pet-create__section-label">
                                SECTION 02
                            </span>

                            <h2 id="photoShelterTitle">
                                Photo & Shelter
                            </h2>

                            <p>
                                Add a photo and identify
                                the shelter responsible for the pet.
                            </p>
                        </div>
                    </div>

                    <div class="pa-pet-create__fields">

                        <div class="pa-pet-create__field
                                    pa-pet-create__field--full">

                            <label asp-for="ImageUrl"
                                   class="pa-pet-create__label">
                                Pet Photo URL
                            </label>

                            <div class="pa-pet-create__url-field">

                                <span aria-hidden="true">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M10 13a5 5 0 0 0 7 .5l3-3a5 5 0 0 0-7-7l-1.7 1.7" />
                                        <path d="M14 11a5 5 0 0 0-7-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" />
                                    </svg>
                                </span>

                                <input asp-for="ImageUrl"
                                       type="url"
                                       class="pa-pet-create__input form-control"
                                       placeholder="https://example.com/pet.jpg" />
                            </div>

                            <span asp-validation-for="ImageUrl"
                                  class="pa-pet-create__field-error"></span>

                            <p class="pa-pet-create__field-help
                                      pa-pet-create__field-help--bottom">
                                Use a public HTTPS image URL.
                                The photo preview will update automatically.
                            </p>
                        </div>

                        <div class="pa-pet-create__field">

                            @if (isAdmin)
                            {
                                <label asp-for="ShelterId"
                                       class="pa-pet-create__label">
                                    Shelter
                                </label>

                                <select asp-for="ShelterId"
                                        asp-items="shelterOptions"
                                        class="pa-pet-create__input pa-pet-create__select form-select">

                                    <option value="">
                                        Select a shelter
                                    </option>
                                </select>
                            }
                            else
                            {
                                <label for="shelterDisplay"
                                       class="pa-pet-create__label">
                                    Shelter
                                </label>

                                <input type="hidden"
                                       asp-for="ShelterId" />

                                <input id="shelterDisplay"
                                       type="text"
                                       class="pa-pet-create__input pa-pet-create__readonly form-control"
                                       value="@(selectedShelter?.Name ?? "Current shelter")"
                                       readonly />
                            }

                            <span asp-validation-for="ShelterId"
                                  class="pa-pet-create__field-error"></span>
                        </div>

                        <div class="pa-pet-create__field">

                            <span class="pa-pet-create__label">
                                Initial Status
                            </span>

                            <div class="pa-pet-create__status-field">

                                <span class="pa-pet-create__status-dot"></span>

                                <strong>Available</strong>

                                <span class="pa-pet-create__status-caption">
                                    Initial listing status
                                </span>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="pa-pet-create__form-actions">

                    <div class="pa-pet-create__save-information">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 11v5" />
                            <path d="M12 8h.01" />
                        </svg>

                        <span>
                            Review the information before
                            creating the profile.
                        </span>
                    </div>

                    <div class="pa-pet-create__buttons">

                        <a asp-controller="Pets"
                           asp-action="Index"
                           class="pa-pet-create__cancel">
                            Cancel
                        </a>

                        <button type="submit"
                                class="pa-pet-create__submit">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.9"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M12 5v14" />
                                <path d="M5 12h14" />
                            </svg>

                            Create Pet

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M5 12h14" />
                                <path d="m13 6 6 6-6 6" />
                            </svg>
                        </button>
                    </div>
                </div>
            </form>
        </main>

        <aside class="pa-pet-create__sidebar"
               aria-label="Pet profile preview and guidance">

            <section class="pa-pet-create__preview-panel">

                <div class="pa-pet-create__sidebar-heading">

                    <span class="pa-pet-create__section-label">
                        LIVE PREVIEW
                    </span>

                    <h2>Pet Card Preview</h2>

                    <p>
                        See how the essential profile details
                        come together as you type.
                    </p>
                </div>

                <div class="pa-pet-create__preview-card">

                    <div class="pa-pet-create__preview-media">

                        <img id="petPreviewImage"
                             alt="Pet profile preview"
                             hidden />

                        <div id="petPreviewFallback"
                             class="pa-pet-create__preview-fallback"
                             aria-hidden="true">

                            <svg viewBox="0 0 100 100"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2.1"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <circle cx="25" cy="31" r="7" />
                                <circle cx="44" cy="19" r="7" />
                                <circle cx="64" cy="25" r="7" />
                                <circle cx="78" cy="43" r="7" />
                                <path d="M48 43c-12 0-18 12-27 23-7 9-2 22 8 22 8 0 12-5 19-5s11 5 19 5c10 0 15-13 8-22-9-11-15-23-27-23Z" />
                            </svg>

                            <span>Photo preview</span>
                        </div>

                        <span class="pa-pet-create__preview-status">
                            <span></span>
                            Available
                        </span>
                    </div>

                    <div class="pa-pet-create__preview-body">

                        <span class="pa-pet-create__preview-eyebrow">
                            MEET YOUR NEW FRIEND
                        </span>

                        <div class="pa-pet-create__preview-title-row">

                            <h3 id="petPreviewName">
                                Your Pet's Name
                            </h3>

                            <span id="petPreviewAge"
                                  class="pa-pet-create__preview-age">
                                Age
                            </span>
                        </div>

                        <p id="petPreviewBreed"
                           class="pa-pet-create__preview-breed">
                            Breed not specified
                        </p>

                        <span id="petPreviewSpecies"
                              class="pa-pet-create__preview-species">
                            Species
                        </span>

                        <p id="petPreviewDescription"
                           class="pa-pet-create__preview-description">
                            A short introduction to your pet
                            will appear here.
                        </p>

                        <div class="pa-pet-create__preview-shelter">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M3 10 12 3l9 7" />
                                <path d="M5 9v11h14V9" />
                                <path d="M9 20v-7h6v7" />
                            </svg>

                            <span id="petPreviewShelter">
                                Shelter not selected
                            </span>
                        </div>
                    </div>
                </div>

                <p class="pa-pet-create__preview-note">
                    This preview is illustrative.
                    Your final profile will use
                    the saved information.
                </p>
            </section>

            <section class="pa-pet-create__tips">

                <div class="pa-pet-create__tips-icon"
                     aria-hidden="true">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M9 18h6" />
                        <path d="M10 22h4" />
                        <path d="M8.5 14.5A7 7 0 1 1 15.5 14.5C14.6 15.4 14 16 14 18h-4c0-2-.6-2.6-1.5-3.5Z" />
                    </svg>
                </div>

                <span class="pa-pet-create__section-label">
                    PROFILE GUIDANCE
                </span>

                <h2>Make their story shine.</h2>

                <p>
                    A complete, accurate profile helps
                    potential adopters understand the
                    pet's needs and personality.
                </p>

                <ul class="pa-pet-create__tips-list">
                    <li>Use the pet's real name.</li>
                    <li>Describe their temperament honestly.</li>
                    <li>Mention training or special care needs.</li>
                    <li>Choose a clear, recent photograph.</li>
                </ul>
            </section>
        </aside>
    </div>
</div>

@section Styles {
    <style>
        .pa-pet-create {
            max-width: 1350px;
            margin: 0 auto 60px;
            color: #173d32;
        }

            .pa-pet-create [hidden] {
                display: none !important;
            }

        .pa-pet-create__breadcrumb {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 11px;
            margin-bottom: 24px;
            color: #89968b;
            font-size: .82rem;
        }

            .pa-pet-create__breadcrumb a {
                color: #637a69;
                text-decoration: none;
            }

                .pa-pet-create__breadcrumb a:hover {
                    color: #c8914e;
                }

            .pa-pet-create__breadcrumb [aria-current="page"] {
                color: #173d32;
                font-weight: 700;
            }

        .pa-pet-create__hero {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
            min-height: 310px;
            margin-bottom: 30px;
            padding: clamp(30px, 4.5vw, 58px);
            overflow: hidden;
            border-radius: 28px;
            background: radial-gradient( circle at 85% 40%, rgba(244,197,122,.15), transparent 38% ), linear-gradient(125deg,#173d32,#245847);
            box-shadow: 0 22px 48px rgba(23,61,50,.15);
        }

        .pa-pet-create__hero-content {
            position: relative;
            z-index: 2;
            max-width: 720px;
        }

        .pa-pet-create__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 22px;
            color: #f4c57a;
            font-size: .71rem;
            font-weight: 800;
            letter-spacing: .14em;
        }

        .pa-pet-create__eyebrow-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #f4c57a;
            box-shadow: 0 0 0 5px rgba(244,197,122,.13);
        }

        .pa-pet-create__hero h1 {
            margin: 0;
            color: #fff;
            font-family: "Fraunces",Georgia,serif;
            font-size: clamp(2.5rem,4.5vw,4.2rem);
            font-weight: 600;
            letter-spacing: -.055em;
            line-height: 1.12;
        }

            .pa-pet-create__hero h1 span {
                display: block;
                color: #f4c57a;
            }

        .pa-pet-create__hero p {
            max-width: 540px;
            margin: 22px 0;
            color: rgba(255,255,255,.82);
            font-size: .94rem;
            line-height: 1.85;
        }

        .pa-pet-create__hero-back {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #fff;
            font-size: .84rem;
            font-weight: 800;
            text-decoration: none;
        }

            .pa-pet-create__hero-back:hover {
                color: #f4c57a;
            }

            .pa-pet-create__hero-back svg {
                width: 18px;
                height: 18px;
            }

        .pa-pet-create__hero-art {
            position: relative;
            display: grid;
            width: 230px;
            height: 230px;
            flex-shrink: 0;
            place-items: center;
            margin-right: 15px;
            color: #f4c57a;
        }

        .pa-pet-create__art-circle,
        .pa-pet-create__art-circle-inner {
            position: absolute;
            border: 1px solid rgba(244,197,122,.23);
            border-radius: 50%;
        }

        .pa-pet-create__art-circle {
            inset: 0;
        }

        .pa-pet-create__art-circle-inner {
            inset: 33px;
            background: rgba(255,255,255,.04);
        }

        .pa-pet-create__hero-art > svg {
            position: relative;
            width: 120px;
            height: 120px;
            opacity: .9;
        }

        .pa-pet-create__layout {
            display: grid;
            grid-template-columns: minmax(0,1fr) 325px;
            align-items: start;
            gap: 25px;
        }

        .pa-pet-create__main,
        .pa-pet-create__sidebar {
            min-width: 0;
        }

        .pa-pet-create__panel {
            margin-bottom: 23px;
            padding: clamp(24px,3.4vw,42px);
            border: 1px solid #e2eae0;
            border-radius: 24px;
            background: #fffefa;
            box-shadow: 0 12px 35px rgba(23,61,50,.045);
        }

        .pa-pet-create__panel-header {
            display: flex;
            align-items: center;
            gap: 17px;
            margin-bottom: 30px;
            padding-bottom: 25px;
            border-bottom: 1px solid #e9eee6;
        }

        .pa-pet-create__panel-icon {
            display: grid;
            width: 54px;
            height: 54px;
            flex-shrink: 0;
            place-items: center;
            border: 1px solid #d7e5d6;
            border-radius: 16px;
            background: #edf5eb;
            color: #245847;
        }

            .pa-pet-create__panel-icon svg {
                width: 27px;
                height: 27px;
            }

        .pa-pet-create__section-label {
            display: block;
            margin-bottom: 8px;
            color: #a97843;
            font-size: .68rem;
            font-weight: 800;
            letter-spacing: .14em;
        }

        .pa-pet-create__panel-header h2,
        .pa-pet-create__sidebar-heading h2 {
            margin: 0 0 7px;
            color: #173d32;
            font-family: "Fraunces",Georgia,serif;
            font-size: clamp(1.55rem,2.4vw,2.05rem);
            font-weight: 600;
            letter-spacing: -.04em;
        }

        .pa-pet-create__panel-header p,
        .pa-pet-create__sidebar-heading p {
            margin: 0;
            color: #819084;
            font-size: .83rem;
            line-height: 1.7;
        }

        .pa-pet-create__validation {
            margin-bottom: 23px;
            padding: 15px 18px;
            border: 1px solid #efcec8;
            border-radius: 12px;
            background: #fff3f0;
            font-size: .84rem;
        }

            .pa-pet-create__validation.validation-summary-valid {
                display: none;
            }

        .pa-pet-create__fields {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 23px;
        }

        .pa-pet-create__field {
            min-width: 0;
        }

        .pa-pet-create__field--full {
            grid-column: 1 / -1;
        }

        .pa-pet-create__label {
            display: block;
            margin-bottom: 10px;
            color: #314c3d;
            font-size: .85rem;
            font-weight: 800;
        }

        .pa-pet-create__input {
            width: 100%;
            min-height: 52px;
            padding: 12px 15px;
            border: 1px solid #dce7dc;
            border-radius: 12px;
            background: #fbfcf9;
            color: #173d32;
            font-family: "DM Sans",sans-serif;
            font-size: .88rem;
            transition: border-color .2s,box-shadow .2s;
        }

            .pa-pet-create__input::placeholder {
                color: #a1aca2;
            }

            .pa-pet-create__input:hover {
                border-color: #b9ccbd;
            }

            .pa-pet-create__input:focus {
                border-color: #42755b;
                background: #fff;
                box-shadow: 0 0 0 4px rgba(36,88,71,.1);
            }

        .pa-pet-create__select {
            cursor: pointer;
        }

        .pa-pet-create__textarea {
