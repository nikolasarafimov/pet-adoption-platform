@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            "use strict";

            const form = document.getElementById("petCreateForm");

            if (!form) {
                return;
            }

            const nameInput = document.getElementById("Name");
            const speciesInput = document.getElementById("Species");
            const breedInput = document.getElementById("Breed");
            const ageInput = document.getElementById("AgeYears");
            const descriptionInput = document.getElementById("Description");
            const imageUrlInput = document.getElementById("ImageUrl");
            const shelterSelect = document.getElementById("ShelterId");
            const shelterDisplay = document.getElementById("shelterDisplay");

            const previewName = document.getElementById("petPreviewName");
            const previewSpecies = document.getElementById("petPreviewSpecies");
            const previewBreed = document.getElementById("petPreviewBreed");
            const previewAge = document.getElementById("petPreviewAge");
            const previewDescription = document.getElementById("petPreviewDescription");
            const previewShelter = document.getElementById("petPreviewShelter");
            const previewImage = document.getElementById("petPreviewImage");
            const previewFallback = document.getElementById("petPreviewFallback");

            const updateDetails = () => {
                const name = nameInput?.value.trim() || "";

                previewName.textContent = name || "Your Pet's Name";

                previewBreed.textContent =
                    breedInput?.value.trim() || "Breed not specified";

                previewDescription.textContent =
                    descriptionInput?.value.trim() ||
                    "A short introduction to your pet will appear here.";

                const speciesOption =
                    speciesInput?.selectedOptions?.[0];

                previewSpecies.textContent =
                    speciesOption?.textContent.trim() || "Species";

                const ageValue = ageInput?.value.trim();

                if (ageValue !== "" && ageValue != null) {
                    const age = Number(ageValue);

                    previewAge.textContent =
                        Number.isFinite(age)
                            ? `${age} ${age === 1 ? "yr" : "yrs"}`
                            : "Age";
                } else {
                    previewAge.textContent = "Age";
                }

                if (shelterSelect && shelterSelect.value) {
                    previewShelter.textContent =
                        shelterSelect.selectedOptions[0]?.textContent.trim()
                        || "Shelter not selected";
                } else if (shelterDisplay) {
                    previewShelter.textContent =
                        shelterDisplay.value || "Current shelter";
                } else {
                    previewShelter.textContent = "Shelter not selected";
                }

                previewImage.alt =
                    name ? `Photo preview of ${name}` : "Pet photo preview";
            };

            let previewTimer;
            let currentImageUrl = "";

            const showFallback = () => {
                previewImage.hidden = true;
                previewFallback.hidden = false;
            };

            const updateImage = () => {
                const value = imageUrlInput?.value.trim() || "";

                if (value === currentImageUrl) {
                    return;
                }

                currentImageUrl = value;

                if (!value) {
                    previewImage.removeAttribute("src");
                    showFallback();
                    return;
                }

                let validUrl = false;

                try {
                    const url = new URL(value);

                    validUrl =
                        url.protocol === "https:" ||
                        url.protocol === "http:";
                } catch {
                    validUrl = false;
                }

                if (!validUrl) {
                    previewImage.removeAttribute("src");
                    showFallback();
                    return;
                }

                showFallback();
                previewImage.src = value;
            };

            previewImage?.addEventListener("load", () => {
                previewImage.hidden = false;
                previewFallback.hidden = true;
            });

            previewImage?.addEventListener("error", showFallback);

            [
                nameInput,
                speciesInput,
                breedInput,
                ageInput,
                descriptionInput,
                shelterSelect
            ].forEach(input => {
                if (!input) {
                    return;
                }

                input.addEventListener("input", updateDetails);
                input.addEventListener("change", updateDetails);
            });

            imageUrlInput?.addEventListener("input", () => {
                clearTimeout(previewTimer);

                previewTimer = setTimeout(updateImage, 350);
            });

            imageUrlInput?.addEventListener("change", () => {
                clearTimeout(previewTimer);
                updateImage();
            });

            updateDetails();
            updateImage();
        })();
    </script>
}