        @@media (prefers-reduced-motion: reduce) {
            .pa-pet-directory *, .pa-pet-directory *::before, .pa-pet-directory *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; }
        }
    </style>
}

@section Scripts {
    <script>
        (() => {
            "use strict";

            document.querySelectorAll("[data-pa-directory-image]").forEach((image) => {
                const fallback = image.parentElement?.querySelector(".pa-pet-directory__fallback");
                const showFallback = () => {
                    image.hidden = true;
                    if (fallback) fallback.hidden = false;
                };

                image.addEventListener("error", showFallback, { once: true });

                if (image.complete && image.naturalWidth === 0) {
                    showFallback();
                }
            });
        })();
    </script>
}