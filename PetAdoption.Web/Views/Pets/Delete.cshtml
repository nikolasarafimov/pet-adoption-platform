@section Scripts {
    <script>
        (() => {
            const image = document.getElementById("deletePetImage");
            const fallback = document.getElementById("deletePetFallback");

            if (!image || !fallback) {
                return;
            }

            const showFallback = () => {
                image.hidden = true;
                fallback.hidden = false;
            };

            image.addEventListener("error", showFallback, {
                once: true
            });

            if (image.complete && image.naturalWidth === 0) {
                showFallback();
            }
        })();
    </script>
}