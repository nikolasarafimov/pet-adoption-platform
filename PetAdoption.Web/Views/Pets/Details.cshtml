        @@media (max-width:479.98px) {
            .pa-pet-details__breadcrumb { gap:8px; font-size:.78rem; }
            .pa-pet-details__hero-back { width:100%; justify-content:center; }
            .pa-pet-details__facts { grid-template-columns:repeat(2,minmax(0,1fr)); }
            .pa-pet-details__facts .pa-pet-details__fact:last-child { grid-column:1 / -1; }
            .pa-pet-details__adoption,.pa-pet-details__side { padding:23px 19px; border-radius:20px; }
            .pa-pet-details__adoption-button { width:100%; }
            .pa-pet-details__image-footer { bottom:14px; left:14px; font-size:.7rem; }
        }
        @@media (prefers-reduced-motion:reduce) {
            .pa-pet-details *, .pa-pet-details *::before, .pa-pet-details *::after { animation:none !important; transition:none !important; scroll-behavior:auto !important; }
        }
    </style>
}

@section Scripts {
    <script>
        (() => {
            "use strict";
            const image = document.querySelector("[data-pa-details-image]");
            if (!image) return;

            const fallback = image.parentElement?.querySelector(".pa-pet-details__fallback");
            const showFallback = () => {
                image.hidden = true;
                if (fallback) fallback.hidden = false;
            };

            image.addEventListener("error", showFallback, { once: true });
            if (image.complete && image.naturalWidth === 0) showFallback();
        })();
    </script>
}