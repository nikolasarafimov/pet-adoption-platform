@using PetAdoption.Domain.Enums
@model IReadOnlyList<PetAdoption.Application.DTOs.PetDto>

@{
    ViewData["Title"] = "Welcome";
    ViewData["Description"] = "Discover pets, explore dog breeds, and connect with shelters through PetAdoption.";

    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool isAdmin = User.IsInRole("Admin");
    bool isShelter = User.IsInRole("Shelter");
    bool isAdopter = User.IsInRole("Adopter");

    bool hasWorkspace =
        isAuthenticated && (isAdopter || isShelter || isAdmin);
}

<div class="pa-welcome">
    <section class="pa-welcome__hero"
             aria-labelledby="welcomeTitle">

        <div class="pa-welcome__hero-copy">

            <div class="pa-welcome__hero-decoration"
                 aria-hidden="true"></div>

            <div class="pa-welcome__eyebrow">

                <span class="pa-welcome__eyebrow-icon"
                      aria-hidden="true">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="7" cy="8" r="1" />
                        <circle cx="12" cy="5" r="1" />
                        <circle cx="17" cy="8" r="1" />
                        <circle cx="20" cy="12" r="1" />
                        <path d="M12 12c-2.2 0-3.4 2-5 3.5-1.4 1.4-.8 4.5 1.8 4.5 1.4 0 2.2-.8 3.2-.8s1.8.8 3.2.8c2.6 0 3.2-3.1 1.8-4.5C15.4 14 14.2 12 12Z" />
                    </svg>
                </span>

                CONNECTING HEARTS & HOMES
            </div>

            <h1 id="welcomeTitle">
                Every pet deserves
                <em>a place to belong.</em>
            </h1>

            <p class="pa-welcome__hero-description">
                Behind every adoption is a new beginning.
                Discover wonderful pets, connect with shelters,
                and take the first step toward a lifelong
                companionship.
            </p>

            <div class="pa-welcome__hero-actions">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="pa-welcome__button
                          pa-welcome__button--gold">

                    Find Your Companion

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="M5 12h14" />
                        <path d="m13 6 6 6-6 6" />
                    </svg>
                </a>

                <a asp-controller="Breeds"
                   asp-action="Index"
                   class="pa-welcome__button
                          pa-welcome__button--outline-light">

                    Explore Breeds
                </a>
            </div>

            @if (!isAuthenticated)
            {
                <div class="pa-welcome__hero-register">

                    <span>New to PetAdoption?</span>

                    <a asp-controller="Account"
                       asp-action="Register">

                        Create your account

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </a>
                </div>
            }
        </div>

        <div class="pa-welcome__hero-visual">

            <img src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?q=85&amp;w=1400&amp;auto=format&amp;fit=crop"
                 alt="A dog looking toward the camera"
                 class="pa-welcome__hero-photo"
                 fetchpriority="high" />

            <div class="pa-welcome__photo-overlay"
                 aria-hidden="true"></div>

            <div class="pa-welcome__photo-caption">

                <span class="pa-welcome__photo-caption-icon"
                      aria-hidden="true">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
                    </svg>
                </span>

                <div>
                    <span>MORE THAN A PET</span>
                    <strong>A new member of the family.</strong>
                </div>
            </div>
        </div>
    </section>

    <section class="pa-welcome__journey"
             aria-labelledby="journeyTitle">

        <div class="pa-welcome__section-header
                    pa-welcome__section-header--center">

            <span class="pa-welcome__section-eyebrow">
                THE ADOPTION JOURNEY
            </span>

            <h2 id="journeyTitle">
                A little love.
                <em>A big beginning.</em>
            </h2>

            <p>
                Discover, connect, and take the next step
                toward welcoming a companion into your life.
            </p>
        </div>

        <div class="pa-welcome__steps">

            <article class="pa-welcome__step">

                <div class="pa-welcome__step-top">

                    <span class="pa-welcome__step-icon"
                          aria-hidden="true">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.7"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <circle cx="10.5" cy="10.5" r="6.5" />
                            <path d="m16 16 5 5" />
                        </svg>
                    </span>

                    <span class="pa-welcome__step-number">
                        01
                    </span>
                </div>

                <h3>Discover</h3>

                <p>
                    Browse pet profiles, explore different
                    breeds, and find an animal that could
                    be the right match for you.
                </p>
            </article>

            <article class="pa-welcome__step">

                <div class="pa-welcome__step-top">

                    <span class="pa-welcome__step-icon"
                          aria-hidden="true">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.7"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8l-5 3V7a2 2 0 0 1 1-2Z" />
                            <path d="M8 10h8" />
                            <path d="M8 14h5" />
                        </svg>
                    </span>

                    <span class="pa-welcome__step-number">
                        02
                    </span>
                </div>

                <h3>Connect</h3>

                <p>
                    Submit an adoption request for an
                    available pet and share your interest
                    with the shelter.
                </p>
            </article>

            <article class="pa-welcome__step">

                <div class="pa-welcome__step-top">

                    <span class="pa-welcome__step-icon"
                          aria-hidden="true">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.7"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M3 10 12 3l9 7" />
                            <path d="M5 9v11h14V9" />
                            <path d="M9 20v-7h6v7" />
                            <path d="M12 10c-2-3-6-.8-5 2 1 2.5 5 5 5 5s4-2.5 5-5c1-2.8-3-5-5-2Z" />
                        </svg>
                    </span>

                    <span class="pa-welcome__step-number">
                        03
                    </span>
                </div>

                <h3>Take the Next Step</h3>

                <p>
                    Follow your request status and
                    continue the adoption process
                    when the shelter makes a decision.
                </p>
            </article>
        </div>
    </section>

    @if (hasWorkspace)
    {
        <section class="pa-welcome__workspace"
                 aria-labelledby="workspaceTitle">

            <div class="pa-welcome__section-header">

                <div>
                    <span class="pa-welcome__section-eyebrow">
                        YOUR WORKSPACE
                    </span>

                    <h2 id="workspaceTitle">
                        Pick up where
                        <em>you left off.</em>
                    </h2>

                    <p>
                        Access the tools available
                        for your account.
                    </p>
                </div>
            </div>

            <div class="pa-welcome__workspace-grid">

                @if (isAdopter)
                {
                    <a asp-controller="AdoptionRequests"
                       asp-action="Index"
                       class="pa-welcome__workspace-card">

                        <span class="pa-welcome__workspace-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">

                                <rect x="4" y="3" width="16" height="18" rx="3" />
                                <path d="M8 8h8M8 12h8M8 16h5" />
                            </svg>
                        </span>

                        <div>
                            <h3>My Adoption Requests</h3>

                            <p>
                                Track your applications and
                                review their latest statuses.
                            </p>
                        </div>

                        <span class="pa-welcome__workspace-arrow"
                              aria-hidden="true">→</span>
                    </a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="pa-welcome__workspace-card">

                        <span class="pa-welcome__workspace-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">

                                <circle cx="11" cy="11" r="7" />
                                <path d="m16 16 5 5" />
                            </svg>
                        </span>

                        <div>
                            <h3>Find Another Pet</h3>

                            <p>
                                Explore more pets and
                                discover their stories.
                            </p>
                        </div>

                        <span class="pa-welcome__workspace-arrow"
                              aria-hidden="true">→</span>
                    </a>
                }
                else if (isShelter)
                {
                    <a asp-controller="Pets"
                       asp-action="Index"
                       class="pa-welcome__workspace-card">

                        <span class="pa-welcome__workspace-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">

                                <path d="M3 10 12 3l9 7" />
                                <path d="M5 9v11h14V9" />
                                <path d="M9 20v-7h6v7" />
                            </svg>
                        </span>

                        <div>
                            <h3>Manage Pets</h3>

                            <p>
                                Add, update, and manage
                                your shelter's pet listings.
                            </p>
                        </div>

                        <span class="pa-welcome__workspace-arrow"
                              aria-hidden="true">→</span>
                    </a>

                    <a asp-controller="AdoptionRequests"
                       asp-action="Manage"
                       class="pa-welcome__workspace-card">

                        <span class="pa-welcome__workspace-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">

                                <circle cx="12" cy="12" r="9" />
                                <path d="m8 12 3 3 5-6" />
                            </svg>
                        </span>

                        <div>
                            <h3>Review Requests</h3>

                            <p>
                                Review adoption applications
                                and manage pending decisions.
                            </p>
                        </div>

                        <span class="pa-welcome__workspace-arrow"
                              aria-hidden="true">→</span>
                    </a>
                }
                else if (isAdmin)
                {
                    <a asp-controller="Pets"
                       asp-action="Index"
                       class="pa-welcome__workspace-card">

                        <span class="pa-welcome__workspace-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">

                                <circle cx="7" cy="8" r="1" />
                                <circle cx="12" cy="5" r="1" />
                                <circle cx="17" cy="8" r="1" />
                                <path d="M12 12c-2 0-3 2-5 4-1 2 0 4 2 4 1 0 2-1 3-1s2 1 3 1c2 0 3-2 2-4-2-2-3-4-5-4Z" />
                            </svg>
                        </span>

                        <div>
                            <h3>Manage Pets</h3>

                            <p>
                                Oversee pet profiles and
                                registered listings.
                            </p>
                        </div>

                        <span class="pa-welcome__workspace-arrow"
                              aria-hidden="true">→</span>
                    </a>

                    <a asp-controller="Shelters"
                       asp-action="Index"
                       class="pa-welcome__workspace-card">

                        <span class="pa-welcome__workspace-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">

                                <path d="M3 10 12 3l9 7" />
                                <path d="M5 9v11h14V9" />
                                <path d="M9 20v-7h6v7" />
                            </svg>
                        </span>

                        <div>
                            <h3>Manage Shelters</h3>

                            <p>
                                Review and maintain
                                registered shelter information.
                            </p>
                        </div>

                        <span class="pa-welcome__workspace-arrow"
                              aria-hidden="true">→</span>
                    </a>

                    <a asp-controller="AdoptersAdmin"
                       asp-action="Index"
                       class="pa-welcome__workspace-card">

                        <span class="pa-welcome__workspace-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">

                                <circle cx="9" cy="8" r="4" />
                                <path d="M2 21v-2a7 7 0 0 1 14 0v2" />
                                <path d="M18 8h4M20 6v4" />
                            </svg>
                        </span>

                        <div>
                            <h3>Manage Adopters</h3>

                            <p>
                                View and manage
                                adopter profiles.
                            </p>
                        </div>

                        <span class="pa-welcome__workspace-arrow"
                              aria-hidden="true">→</span>
                    </a>
                }
            </div>
        </section>
    }

    <section class="pa-welcome__featured"
             aria-labelledby="featuredPetsTitle">

        <div class="pa-welcome__featured-heading">

            <div>
                <span class="pa-welcome__section-eyebrow">
                    MEET THE ANIMALS
                </span>

                <h2 id="featuredPetsTitle">
                    Meet some
                    <em>lovely companions.</em>
                </h2>

                <p>
                    Explore a selection of pets
                    featured on our platform.
                </p>
            </div>

            <a asp-controller="Home"
               asp-action="Index"
               class="pa-welcome__view-all">

                View All Pets

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                </svg>
            </a>
        </div>

        @if (Model.Count == 0)
        {
            <div class="pa-welcome__empty">

                <span class="pa-welcome__empty-icon"
                      aria-hidden="true">

                    <svg viewBox="0 0 64 64"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="18" cy="21" r="4" />
                        <circle cx="31" cy="13" r="4" />
                        <circle cx="44" cy="21" r="4" />
                        <circle cx="52" cy="34" r="4" />
                        <path d="M32 31c-8 0-11 8-17 15-4 5-1 12 5 12 5 0 7-3 12-3s7 3 12 3c6 0 9-7 5-12-6-7-9-15-17-15Z" />
                    </svg>
                </span>

                <h3>No featured pets right now.</h3>

                <p>
                    There are no featured pet profiles
                    to display at the moment.
                    Explore the full directory for more listings.
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="pa-welcome__empty-button">

                    Explore All Pets
                </a>
            </div>
        }
        else
        {
            <div class="pa-welcome__pet-grid">

                @foreach (var pet in Model)
                {
                    var petName =
                    string.IsNullOrWhiteSpace(pet.Name)
                    ? "Unnamed Pet"
                    : pet.Name.Trim();

                    var hasImage =
                    Uri.TryCreate(
                    pet.ImageUrl,
                    UriKind.Absolute,
                    out var imageUri
                    )
                    && imageUri is not null
                    && (
                    imageUri.Scheme == Uri.UriSchemeHttps ||
                    imageUri.Scheme == Uri.UriSchemeHttp
                    );

                    var statusClass = pet.Status switch
                    {
                        PetStatus.Available => "available",
                        PetStatus.Reserved => "reserved",
                        PetStatus.Adopted => "adopted",
                        _ => "unknown"
                    };

                    var petDescription =
                    string.IsNullOrWhiteSpace(pet.Description)
                    ? "No description has been provided for this pet yet."
                    : pet.Description;

                    <article class="pa-welcome__pet-card">

                        <div class="pa-welcome__pet-media">

                            @if (hasImage)
                            {
                                <img src="@pet.ImageUrl"
                                     alt="Photo of @petName"
                                     class="pa-welcome__pet-image"
                                     loading="lazy"
                                     decoding="async"
                                     data-pa-welcome-image />
                            }

                        <div class="pa-welcome__pet-fallback"
                             hidden="@hasImage"
                             aria-hidden="true">

                            <svg viewBox="0 0 80 80"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <circle cx="19" cy="22" r="4" />
                                <circle cx="32" cy="14" r="4" />
                                <circle cx="45" cy="22" r="4" />
                                <circle cx="54" cy="35" r="4" />
                                <path d="M35 32c-8 0-11 8-17 15-4 5-1 12 5 12 5 0 7-3 12-3s7 3 12 3c6 0 9-7 5-12-6-7-9-15-17-15Z" />
                            </svg>
                        </div>

                        <span class="pa-welcome__pet-status
                                             pa-welcome__pet-status--@statusClass">

                            <span></span>
                            @pet.Status
                        </span>

                        <span class="pa-welcome__pet-species">
                            @pet.Species
                        </span>
                    </div>

                    <div class="pa-welcome__pet-body">

                        <div class="pa-welcome__pet-heading">

                            <div>
                                <span class="pa-welcome__pet-eyebrow">
                                    MEET @petName.ToUpperInvariant()
                                </span>

                                <h3>
                                    <a asp-controller="Pets"
                                       asp-action="Details"
                                       asp-route-id="@pet.Id">
                                        @petName
                                    </a>
                                </h3>

                                <p class="pa-welcome__pet-breed">
                                    @(string.IsNullOrWhiteSpace(pet.Breed)
                                                                    ? "Breed not specified"
                                                                    : pet.Breed)
                                                                            </p>
                                                                        </div>

                            <span class="pa-welcome__pet-age">
                                @pet.AgeYears
                                @(pet.AgeYears == 1 ? "yr" : "yrs")
                            </span>
                        </div>

                        <p class="pa-welcome__pet-description">
                            @petDescription
                        </p>

                        <div class="pa-welcome__pet-shelter">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.7"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">

                                <path d="M3 10 12 3l9 7" />
                                <path d="M5 9v11h14V9" />
                                <path d="M9 20v-7h6v7" />
                            </svg>

                            <span>
                                @(string.IsNullOrWhiteSpace(pet.ShelterName)
                                                            ? "Shelter not specified"
                                                            : pet.ShelterName)
                        </span>
                    </div>
                </div>

                        <div class="pa-welcome__pet-actions">

                            <a asp-controller="Pets"
                               asp-action="Details"
                               asp-route-id="@pet.Id"
                               class="pa-welcome__pet-details">

                                View Details

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">

                                    <path d="M5 12h14" />
                                    <path d="m13 6 6 6-6 6" />
                                </svg>
                            </a>

                    @if (pet.Status == PetStatus.Available && isAdopter)
                            {
                                <a asp-controller="AdoptionRequests"
                                   asp-action="Create"
                                   asp-route-petId="@pet.Id"
                                   class="pa-welcome__pet-adopt">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         aria-hidden="true">

                                        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
                                    </svg>

                                    Adopt
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="pa-welcome__breed-cta"
             aria-labelledby="breedCtaTitle">

        <div class="pa-welcome__breed-decoration"
             aria-hidden="true">

            <svg viewBox="0 0 120 120"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="M36 42 20 29 13 52l15 15" />
                <path d="m84 42 16-13 7 23-15 15" />
                <path d="M30 52c0-25 12-39 30-39s30 14 30 39v15c0 21-13 35-30 35S30 88 30 67Z" />
                <path d="M45 60h3M72 60h3" />
                <path d="m52 76 8 6 8-6-8-5Z" />
                <path d="M60 82v6" />
            </svg>
        </div>

        <div class="pa-welcome__breed-copy">

            <span class="pa-welcome__section-eyebrow">
                GET TO KNOW THE BREEDS
            </span>

            <h2 id="breedCtaTitle">
                Curious minds.
                <em>Wagging tails.</em>
            </h2>

            <p>
                Learn about dog breeds, from temperament
                and lifespan to average weight, using
                information from The Dog API.
            </p>

            <a asp-controller="Breeds"
               asp-action="Index"
               class="pa-welcome__breed-button">

                Explore Dog Breeds

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                </svg>
            </a>
        </div>
    </section>

</div>

@section Styles {
    <style>
        .pa-welcome {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto 65px;
        }

            .pa-welcome [hidden] {
                display: none !important;
            }

            .pa-welcome a:focus-visible {
                outline: 3px solid #c8914e;
                outline-offset: 4px;
            }

        .pa-welcome__hero {
            display: grid;
            grid-template-columns: minmax(0, 1.13fr) minmax(0, 0.87fr);
