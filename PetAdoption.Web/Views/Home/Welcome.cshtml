@section Scripts {
    <script>
        (() => {
            "use strict";

            const images = document.querySelectorAll(
                "[data-pa-welcome-image]"
            );

            images.forEach(image => {
                const media = image.closest(
                    ".pa-welcome__pet-media"
                );

                const fallback = media?.querySelector(
                    ".pa-welcome__pet-fallback"
                );

                const showFallback = () => {
                    image.hidden = true;

                    if (fallback) {
                        fallback.hidden = false;
                    }
                };

                image.addEventListener(
                    "error",
                    showFallback,
                    { once: true }
                );

                if (image.complete && image.naturalWidth === 0) {
                    showFallback();
                }
            });
        })();
    </script>
}