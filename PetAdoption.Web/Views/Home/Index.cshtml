@section Scripts {
    <script>
        (() => {
            "use strict";

            const form = document.getElementById("petSearchForm");
            const pageSize = document.getElementById("pageSize");

            // Automatically apply the selected page size.
            // The regular submit button remains available
            // when JavaScript is disabled.

            if (form && pageSize) {
                pageSize.addEventListener("change", () => {
                    form.requestSubmit();
                });
            }

            // Replace broken external pet photos with
            // the built-in vector illustration.

            document.querySelectorAll(
                "[data-pa-pet-image]"
            ).forEach(image => {
                const media = image.closest(
                    ".pa-discover__card-media"
                );

                const fallback = media?.querySelector(
                    ".pa-discover__image-fallback"
                );

                const showFallback = () => {
                    image.hidden = true;

                    if (fallback) {
                        fallback.hidden = false;
                    }
                };

                image.addEventListener(
                    "error",
                    showFallback,
                    { once: true }
                );

                if (image.complete && image.naturalWidth === 0) {
                    showFallback();
                }
            });
        })();
    </script>
}