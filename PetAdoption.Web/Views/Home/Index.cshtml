@using PetAdoption.Domain.Enums
@model IReadOnlyList<PetAdoption.Application.DTOs.PetDto>

@{
    ViewData["Title"] = "Find Your Companion";
    ViewData["Description"] = "Explore pets, discover their stories, and find your next companion through PetAdoption.";

    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 9;
    int total = ViewBag.Total ?? Model.Count;
    int totalPages = ViewBag.TotalPages ?? 1;

    page = Math.Max(1, page);
    total = Math.Max(0, total);
    totalPages = Math.Max(1, totalPages);

    string search = ViewBag.Search as string ?? string.Empty;
    Species? selectedSpecies = ViewBag.Species as Species?;

    bool hasFilters =
        !string.IsNullOrWhiteSpace(search) ||
        selectedSpecies.HasValue;

    bool isAdopter = User.IsInRole("Adopter");

    int firstPage = Math.Max(1, page - 2);
    int lastPage = Math.Min(totalPages, page + 2);

    string BuildUrl(int targetPage)
    {
        return Url.Action(
            "Index",
            "Home",
            new
            {
                search,
                species = selectedSpecies,
                page = targetPage,
                pageSize
            }
        ) ?? "#";
    }
}

<div class="pa-discover">

    <nav class="pa-discover__breadcrumb"
         aria-label="Breadcrumb">

        <a asp-controller="Home"
           asp-action="Welcome">
            Home
        </a>

        <span aria-hidden="true">/</span>

        <span aria-current="page">
            Explore Pets
        </span>
    </nav>

    <header class="pa-discover__hero">

        <div class="pa-discover__hero-glow"
             aria-hidden="true"></div>

        <div class="pa-discover__hero-content">

            <div class="pa-discover__eyebrow">

                <span class="pa-discover__eyebrow-dot"></span>

                DISCOVER YOUR NEXT COMPANION
            </div>

            <h1>
                Their next chapter
                <span>could start with you.</span>
            </h1>

            <p class="pa-discover__hero-description">
                Every pet has a story worth discovering.
                Explore animals registered on PetAdoption,
                get to know their personalities, and
                find a companion who feels like home.
            </p>

            <a href="#petCollection"
               class="pa-discover__hero-button">

                Explore Pets

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <path d="M12 5v14" />
                    <path d="m6 13 6 6 6-6" />
                </svg>
            </a>
        </div>

        <div class="pa-discover__hero-art"
             aria-hidden="true">

            <div class="pa-discover__art-orbit
                        pa-discover__art-orbit--outer"></div>

            <div class="pa-discover__art-orbit
                        pa-discover__art-orbit--inner"></div>

            <div class="pa-discover__art-center">

                <svg viewBox="0 0 96 96"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.5"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M17 41 48 17l31 24" />
                    <path d="M25 36v42h46V36" />

                    <path d="M37 78V55h22v23" />

                    <path d="M48 40c-5-7-15-2-12 6 2 6 12 13 12 13s10-7 12-13c3-8-7-13-12-6Z" />
                </svg>
            </div>

            <span class="pa-discover__art-spark
                         pa-discover__art-spark--one"></span>

            <span class="pa-discover__art-spark
                         pa-discover__art-spark--two"></span>
        </div>
    </header>

    <section class="pa-discover__filters"
             aria-labelledby="discoverFiltersTitle">

        <div class="pa-discover__filters-heading">

            <div>
                <span class="pa-discover__section-eyebrow">
                    FIND YOUR MATCH
                </span>

                <h2 id="discoverFiltersTitle">
                    Meet your future friend.
                </h2>

                <p>
                    Search by name or breed, or narrow
                    your results by animal type.
                </p>
            </div>

            <span class="pa-discover__filters-icon"
                  aria-hidden="true">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="11" cy="11" r="7" />
                    <path d="m16 16 5 5" />
                </svg>
            </span>
        </div>

        <form asp-controller="Home"
              asp-action="Index"
              method="get"
              id="petSearchForm"
              class="pa-discover__filter-form">

            <div class="pa-discover__field
                        pa-discover__field--search">

                <label for="search">
                    Search pets
                </label>

                <div class="pa-discover__input-wrap">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <circle cx="11" cy="11" r="7" />
                        <path d="m16 16 5 5" />
                    </svg>

                    <input id="search"
                           type="search"
                           name="search"
                           value="@search"
                           class="pa-discover__input"
                           placeholder="Search by name or breed..."
                           autocomplete="off" />
                </div>
            </div>

            <div class="pa-discover__field">

                <label for="species">
                    Animal type
                </label>

                <div class="pa-discover__select-wrap">

                    <select id="species"
                            name="species"
                            class="pa-discover__select">

                        <option value="">
                            All species
                        </option>

                        @foreach (var species in Enum.GetValues<Species>())
                        {
                            if (selectedSpecies == species)
                            {
                                <option value="@species" selected>
                                    @species
                                </option>
                            }
                            else
                            {
                                <option value="@species">
                                    @species
                                </option>
                            }
                        }
                    </select>

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="m6 9 6 6 6-6" />
                    </svg>
                </div>
            </div>

            <div class="pa-discover__field
                        pa-discover__field--size">

                <label for="pageSize">
                    Per page
                </label>

                <div class="pa-discover__select-wrap">

                    <select id="pageSize"
                            name="pageSize"
                            class="pa-discover__select">

                        @foreach (var size in new[] { 6, 9, 12, 15, 18 })
                        {
                            if (pageSize == size)
                            {
                                <option value="@size" selected>
                                    @size
                                </option>
                            }
                            else
                            {
                                <option value="@size">
                                    @size
                                </option>
                            }
                        }
                    </select>

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="m6 9 6 6 6-6" />
                    </svg>
                </div>
            </div>

            <button type="submit"
                    class="pa-discover__search-button">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <circle cx="11" cy="11" r="7" />
                    <path d="m16 16 5 5" />
                </svg>

                Find Pets
            </button>
        </form>

        @if (hasFilters)
        {
            <div class="pa-discover__active-filters">

                <div class="pa-discover__active-tags">

                    <span class="pa-discover__active-label">
                        Active filters:
                    </span>

                    @if (!string.IsNullOrWhiteSpace(search))
                    {
                        <span class="pa-discover__active-tag">
                            Search: @search
                        </span>
                    }

                    @if (selectedSpecies.HasValue)
                    {
                        <span class="pa-discover__active-tag">
                            @selectedSpecies.Value
                        </span>
                    }
                </div>

                <a asp-controller="Home"
                   asp-action="Index"
                   asp-route-pageSize="@pageSize"
                   class="pa-discover__clear">

                    Clear Filters

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="M6 6l12 12" />
                        <path d="M18 6 6 18" />
                    </svg>
                </a>
            </div>
        }
    </section>

    <section id="petCollection"
             class="pa-discover__collection"
             aria-labelledby="petCollectionTitle">

        <div class="pa-discover__collection-heading">

            <div>
                <span class="pa-discover__section-eyebrow">
                    PET DISCOVERY
                </span>

                <h2 id="petCollectionTitle">
                    @(hasFilters ? "Your Search Results" : "Meet the Pets")
                </h2>

                <p>
                    @if (hasFilters)
                    {
                        <text>
                            Explore pets matching your
                            selected search criteria.
                        </text>
                    }
                    else
                    {
                        <text>
                            Get to know the animals currently
                            featured in our directory.
                        </text>
                    }
                </p>
            </div>

            <div class="pa-discover__result-count">

                <span class="pa-discover__result-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <circle cx="7" cy="8" r="1" />
                        <circle cx="12" cy="5" r="1" />
                        <circle cx="17" cy="8" r="1" />
                        <circle cx="20" cy="12" r="1" />

                        <path d="M12 12c-2.2 0-3.4 2-5 3.5-1.4 1.4-.8 4.5 1.8 4.5 1.4 0 2.2-.8 3.2-.8s1.8.8 3.2.8c2.6 0 3.2-3.1 1.8-4.5C15.4 14 14.2 12 12Z" />
                    </svg>
                </span>

                <strong>@total</strong>

                <span>
                    @(total == 1 ? "pet found" : "pets found")
                </span>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="pa-discover__empty">

                <div class="pa-discover__empty-icon"
                     aria-hidden="true">

                    <svg viewBox="0 0 64 64"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="27" cy="27" r="15" />
                        <path d="m39 39 16 16" />
                        <path d="M21 27h12" />
                    </svg>
                </div>

                <span class="pa-discover__empty-eyebrow">
                    @(hasFilters ? "NO MATCHES FOUND" : "NO LISTINGS YET")
                </span>

                <h3>
                    @(hasFilters
                        ? "No pets match your search."
                        : "No pets to show right now.")
                </h3>

                <p>
                    @if (hasFilters)
                    {
                        <text>
                            We couldn't find any pets matching
                            your current filters. Try another
                            search or explore the full directory.
                        </text>
                    }
                    else
                    {
                        <text>
                            There are currently no pet listings
                            available to display. Check back
                            as the directory is updated.
                        </text>
                    }
                </p>

                @if (hasFilters)
                {
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="pa-discover__empty-button">

                        Clear All Filters

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="pa-discover__grid">

                @foreach (var pet in Model)
                {
                    var petName = string.IsNullOrWhiteSpace(pet.Name)
                        ? "Unnamed Pet"
                        : pet.Name.Trim();

                    var hasImage =
                        Uri.TryCreate(
                            pet.ImageUrl,
                            UriKind.Absolute,
                            out var imageUri)
                        && (
                            imageUri.Scheme == Uri.UriSchemeHttps ||
                            imageUri.Scheme == Uri.UriSchemeHttp
                        );

                    var statusClass = pet.Status switch
                    {
                        PetStatus.Available => "available",
                        PetStatus.Reserved => "reserved",
                        PetStatus.Adopted => "adopted",
                        _ => "unknown"
                    };

                    var shelterName =
                        string.IsNullOrWhiteSpace(pet.ShelterName)
                            ? "Shelter not specified"
                            : pet.ShelterName;

                    var description =
                        string.IsNullOrWhiteSpace(pet.Description)
                            ? "No description is available for this pet yet."
                            : pet.Description;

                    <article class="pa-discover__card">

                        <div class="pa-discover__card-media">

                            @if (hasImage)
                            {
                                <img src="@pet.ImageUrl"
                                     alt="Photo of @petName"
                                     class="pa-discover__card-image"
                                     loading="lazy"
                                     decoding="async"
                                     data-pa-pet-image />
                            }

                            <div class="pa-discover__image-fallback"
                                 hidden="@hasImage"
                                 aria-hidden="true">

                                <svg viewBox="0 0 96 96"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2.3"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <path d="M18 40 48 17l30 23" />
                                    <path d="M26 35v43h44V35" />

                                    <path d="M38 78V56h20v22" />

                                    <path d="M48 42c-5-7-14-2-11 5 2 6 11 12 11 12s9-6 11-12c3-7-6-12-11-5Z" />
                                </svg>
                            </div>

                            <span class="pa-discover__status
                                         pa-discover__status--@statusClass">

                                <span class="pa-discover__status-dot"></span>

                                @pet.Status
                            </span>

                            <span class="pa-discover__species-badge">
                                @pet.Species
                            </span>
                        </div>

                        <div class="pa-discover__card-body">

                            <div class="pa-discover__card-top">

                                <div class="pa-discover__card-title-wrap">

                                    <span class="pa-discover__card-eyebrow">
                                        MEET YOUR COMPANION
                                    </span>

                                    <h3>
                                        <a asp-controller="Pets"
                                           asp-action="Details"
                                           asp-route-id="@pet.Id">
                                            @petName
                                        </a>
                                    </h3>

                                    <div class="pa-discover__breed">

                                        @if (!string.IsNullOrWhiteSpace(pet.Breed))
                                        {
                                            @pet.Breed
                                        }
                                        else
                                        {
                                            <span>Breed not specified</span>
                                        }
                                    </div>
                                </div>

                                <div class="pa-discover__age">

                                    <strong>@pet.AgeYears</strong>

                                    <span>
                                        @(pet.AgeYears == 1 ? "year" : "years")
                                    </span>
                                </div>
                            </div>

                            <p class="pa-discover__description">
                                @description
                            </p>

                            <div class="pa-discover__shelter">

                                <span class="pa-discover__shelter-icon"
                                      aria-hidden="true">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <path d="M3 10 12 3l9 7" />
                                        <path d="M5 9v11h14V9" />
                                        <path d="M9 20v-7h6v7" />
                                    </svg>
                                </span>

                                <div>
                                    <small>Listed by</small>
                                    <strong>@shelterName</strong>
                                </div>
                            </div>
                        </div>

                        <div class="pa-discover__card-actions">

                            <a asp-controller="Pets"
                               asp-action="Details"
                               asp-route-id="@pet.Id"
                               class="pa-discover__details-button">

                                View Details

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">

                                    <path d="M5 12h14" />
                                    <path d="m13 6 6 6-6 6" />
                                </svg>
                            </a>

                            @if (pet.Status == PetStatus.Available && isAdopter)
                            {
                                <a asp-controller="AdoptionRequests"
                                   asp-action="Create"
                                   asp-route-petId="@pet.Id"
                                   class="pa-discover__adopt-button">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         aria-hidden="true">

                                        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
                                    </svg>

                                    Adopt
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>

            @if (totalPages > 1)
            {
                <nav class="pa-discover__pagination"
                     aria-label="Pet pagination">

                    <div class="pa-discover__pagination-controls">

                        @if (page > 1)
                        {
                            <a href="@BuildUrl(page - 1)"
                               class="pa-discover__page-arrow"
                               aria-label="Previous page">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">

                                    <path d="M19 12H5" />
                                    <path d="m11 18-6-6 6-6" />
                                </svg>

                                <span>Previous</span>
                            </a>
                        }
                        else
                        {
                            <span class="pa-discover__page-arrow is-disabled"
                                  aria-disabled="true">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">

                                    <path d="M19 12H5" />
                                    <path d="m11 18-6-6 6-6" />
                                </svg>

                                <span>Previous</span>
                            </span>
                        }

                        <div class="pa-discover__page-numbers">

                            @if (firstPage > 1)
                            {
                                <a href="@BuildUrl(1)"
                                   class="pa-discover__page-number">
                                    1
                                </a>

                                @if (firstPage > 2)
                                {
                                    <span class="pa-discover__page-ellipsis"
                                          aria-hidden="true">…</span>
                                }
                            }

                            @for (int i = firstPage; i <= lastPage; i++)
                            {
                                if (i == page)
                                {
                                    <span class="pa-discover__page-number is-active"
                                          aria-current="page">
                                        @i
                                    </span>
                                }
                                else
                                {
                                    <a href="@BuildUrl(i)"
                                       class="pa-discover__page-number">
                                        @i
                                    </a>
                                }
                            }

                            @if (lastPage < totalPages)
                            {
                                @if (lastPage < totalPages - 1)
                                {
                                    <span class="pa-discover__page-ellipsis"
                                          aria-hidden="true">…</span>
                                }

                                <a href="@BuildUrl(totalPages)"
                                   class="pa-discover__page-number">
                                    @totalPages
                                </a>
                            }
                        </div>

                        @if (page < totalPages)
                        {
                            <a href="@BuildUrl(page + 1)"
                               class="pa-discover__page-arrow"
                               aria-label="Next page">

                                <span>Next</span>

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">

                                    <path d="M5 12h14" />
                                    <path d="m13 6 6 6-6 6" />
                                </svg>
                            </a>
                        }
                        else
                        {
                            <span class="pa-discover__page-arrow is-disabled"
                                  aria-disabled="true">

                                <span>Next</span>

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">

                                    <path d="M5 12h14" />
                                    <path d="m13 6 6 6-6 6" />
                                </svg>
                            </span>
                        }
                    </div>

                    <p class="pa-discover__page-description">
                        Page @(page) of @totalPages
                    </p>
                </nav>
            }
        }
    </section>

    <section class="pa-discover__bottom-cta">

        <div class="pa-discover__bottom-icon"
             aria-hidden="true">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
            </svg>
        </div>

        <div>
            <h2>Find the connection that matters.</h2>

            <p>
                A little curiosity can be the beginning
                of a lifelong friendship.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Welcome">

            Our Story

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="M5 12h14" />
                <path d="m13 6 6 6-6 6" />
            </svg>
        </a>
    </section>
</div>

@section Styles {
    <style>
        .pa-discover {
            width: 100%;
            max-width: 1350px;
            margin: 0 auto 55px;
            color: #173d32;
        }

        .pa-discover [hidden] {
            display: none !important;
        }

        .pa-discover__breadcrumb {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            margin-bottom: 24px;
            color: #89968b;
            font-size: 0.82rem;
        }

        .pa-discover__breadcrumb a {
            color: #637a69;
            text-decoration: none;
        }

        .pa-discover__breadcrumb a:hover {
            color: #c8914e;
        }

        .pa-discover__breadcrumb [aria-current="page"] {
            color: #173d32;
            font-weight: 700;
        }

        .pa-discover__hero {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            min-height: 360px;
            margin-bottom: 30px;
            padding: clamp(32px, 4.5vw, 60px);
            overflow: hidden;
            isolation: isolate;
            border-radius: 28px;
            background:
                radial-gradient(
                    circle at 85% 45%,
                    rgba(244, 197, 122, 0.16),
                    transparent 36%
                ),
                linear-gradient(125deg, #173d32, #245847);
            box-shadow: 0 22px 48px rgba(23, 61, 50, 0.15);
        }

        .pa-discover__hero-glow {
            position: absolute;
            right: -100px;
            bottom: -190px;
            z-index: -1;
            width: 450px;
            height: 450px;
            border-radius: 50%;
