@model PetAdoption.Web.Models.Adopters.AdopterFormVm

@{
    ViewData["Title"] = "Edit Adopter";
    ViewData["Description"] = "Update adopter profile information in the PetAdoption administration workspace.";

    var adopterName = string.IsNullOrWhiteSpace(Model.FullName)
        ? "Adopter"
        : Model.FullName.Trim();

    var initial = adopterName[0].ToString().ToUpperInvariant();
}

<div class="pa-adopter-edit">

    <nav class="pa-adopter-edit__breadcrumb"
         aria-label="Breadcrumb">

        <a asp-controller="Home"
           asp-action="Welcome">
            Home
        </a>

        <span aria-hidden="true">/</span>

        <a asp-controller="AdoptersAdmin"
           asp-action="Index">
            Adopters
        </a>

        <span aria-hidden="true">/</span>

        <a asp-controller="AdoptersAdmin"
           asp-action="Details"
           asp-route-id="@Model.Id">
            Profile
        </a>

        <span aria-hidden="true">/</span>

        <span aria-current="page">
            Edit
        </span>
    </nav>

    <header class="pa-adopter-edit__hero">

        <div class="pa-adopter-edit__hero-glow"
             aria-hidden="true"></div>

        <div class="pa-adopter-edit__hero-content">

            <div class="pa-adopter-edit__eyebrow">

                <span class="pa-adopter-edit__eyebrow-dot"></span>

                ADMINISTRATION WORKSPACE
            </div>

            <div class="pa-adopter-edit__profile">

                <div class="pa-adopter-edit__avatar"
                     aria-hidden="true">
                    @initial
                </div>

                <div class="pa-adopter-edit__profile-info">

                    <span class="pa-adopter-edit__profile-label">
                        EDITING ADOPTER PROFILE
                    </span>

                    <h1 id="editAdopterTitle">
                        @adopterName
                    </h1>

                    <span class="pa-adopter-edit__profile-id">
                        Adopter ID #@Model.Id
                    </span>
                </div>
            </div>

            <p class="pa-adopter-edit__hero-description">
                Keep this adopter's profile accurate and up to date.
                Review the information below and save your changes
                when you're ready.
            </p>

            <a asp-controller="AdoptersAdmin"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="pa-adopter-edit__back">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <path d="M19 12H5" />
                    <path d="m11 18-6-6 6-6" />
                </svg>

                Back to Profile
            </a>
        </div>

        <div class="pa-adopter-edit__hero-art"
             aria-hidden="true">

            <div class="pa-adopter-edit__art-ring
                        pa-adopter-edit__art-ring--outer">
            </div>

            <div class="pa-adopter-edit__art-ring
                        pa-adopter-edit__art-ring--inner">
            </div>

            <div class="pa-adopter-edit__art-center">

                <svg viewBox="0 0 64 64"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="26" cy="22" r="10" />

                    <path d="M7 54v-5c0-10 8-16 19-16s19 6 19 16v5" />

                    <path d="m42 39 14-14 5 5-14 14-7 2Z" />

                    <path d="m53 28 5 5" />
                </svg>
            </div>
        </div>
    </header>

    <div class="pa-adopter-edit__layout">

        <main class="pa-adopter-edit__main">

            <section class="pa-adopter-edit__card"
                     aria-labelledby="editFormTitle">

                <div class="pa-adopter-edit__card-header">

                    <div>
                        <span class="pa-adopter-edit__card-eyebrow">
                            PROFILE MANAGEMENT
                        </span>

                        <h2 id="editFormTitle">
                            Edit Profile Details
                        </h2>

                        <p>
                            Update contact information and
                            administrative notes for this adopter.
                        </p>
                    </div>

                    <span class="pa-adopter-edit__card-icon"
                          aria-hidden="true">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="m15 5 4 4" />

                            <path d="M4 20h4l12-12a2.8 2.8 0 0 0-4-4L4 16Z" />
                        </svg>
                    </span>
                </div>

                <div class="pa-adopter-edit__divider"></div>

                <form asp-controller="AdoptersAdmin"
                      asp-action="Edit"
                      method="post"
                      asp-antiforgery="true"
                      class="pa-adopter-edit__form">

                    <input type="hidden"
                           asp-for="Id" />

                    <partial name="_AdopterForm"
                             model="Model" />

                    <div class="pa-adopter-edit__form-footer">

                        <div class="pa-adopter-edit__save-note">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">

                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 11v5" />
                                <path d="M12 8h.01" />
                            </svg>

                            <span>
                                Changes are saved when you select
                                Save Changes.
                            </span>
                        </div>

                        <div class="pa-adopter-edit__actions">

                            <a asp-controller="AdoptersAdmin"
                               asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="pa-adopter-edit__cancel">

                                Cancel
                            </a>

                            <button type="submit"
                                    class="pa-adopter-edit__submit">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">

                                    <path d="M5 3h12l4 4v14H3V3Z" />
                                    <path d="M7 3v7h10V3" />
                                    <path d="M7 21v-8h10v8" />
                                </svg>

                                Save Changes

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">

                                    <path d="M5 12h14" />
                                    <path d="m13 6 6 6-6 6" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </form>
            </section>
        </main>

        <aside class="pa-adopter-edit__sidebar"
               aria-label="Adopter profile guidance">

            <section class="pa-adopter-edit__guide">

                <div class="pa-adopter-edit__guide-icon"
                     aria-hidden="true">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" />
                        <path d="m9 12 2 2 4-4" />
                    </svg>
                </div>

                <span class="pa-adopter-edit__guide-eyebrow">
                    PROFILE EDITING
                </span>

                <h2>
                    Keep information
                    <span>up to date.</span>
                </h2>

                <p class="pa-adopter-edit__guide-description">
                    Accurate details help maintain clear
                    adopter records and make administrative
                    management easier.
                </p>

                <div class="pa-adopter-edit__guide-divider"></div>

                <div class="pa-adopter-edit__guide-item">

                    <span class="pa-adopter-edit__guide-number">
                        01
                    </span>

                    <div>
                        <strong>Review contact details</strong>

                        <p>
                            Check the name, email, phone
                            number and address.
                        </p>
                    </div>
                </div>

                <div class="pa-adopter-edit__guide-item">

                    <span class="pa-adopter-edit__guide-number">
                        02
                    </span>

                    <div>
                        <strong>Update notes</strong>

                        <p>
                            Add or revise relevant
                            administrative information.
                        </p>
                    </div>
                </div>

                <div class="pa-adopter-edit__guide-item">

                    <span class="pa-adopter-edit__guide-number">
                        03
                    </span>

                    <div>
                        <strong>Save your changes</strong>

                        <p>
                            Submit the form when
                            the information is correct.
                        </p>
                    </div>
                </div>
            </section>

            <section class="pa-adopter-edit__notice">

                <div class="pa-adopter-edit__notice-icon"
                     aria-hidden="true">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 11v5" />
                        <path d="M12 8h.01" />
                    </svg>
                </div>

                <div>
                    <h3>
                        Account information
                    </h3>

                    <p>
                        Updating the adopter's contact email
                        does not automatically change the
                        sign-in email of a linked Identity account.
                    </p>
                </div>
            </section>

            <a asp-controller="AdoptersAdmin"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="pa-adopter-edit__view-profile">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" />
                    <circle cx="12" cy="12" r="3" />
                </svg>

                View Full Profile
            </a>
        </aside>
    </div>
</div>

@section Styles {
    <style>
        .pa-adopter-edit {
            width: 100%;
            max-width: 1350px;
            margin: 0 auto 55px;
        }

        .pa-adopter-edit__breadcrumb {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 11px;
            margin-bottom: 24px;
            color: #89968b;
            font-size: 0.83rem;
        }

            .pa-adopter-edit__breadcrumb a {
                color: #637a69;
                text-decoration: none;
                transition: color 200ms ease;
            }

                .pa-adopter-edit__breadcrumb a:hover {
                    color: #c8914e;
                }

            .pa-adopter-edit__breadcrumb [aria-current="page"] {
                color: #173d32;
                font-weight: 700;
            }

        .pa-adopter-edit__hero {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            min-height: 310px;
            margin-bottom: 30px;
            padding: clamp(30px, 4.5vw, 58px);
            overflow: hidden;
            isolation: isolate;
            border-radius: 28px;
            background: radial-gradient( circle at 85% 45%, rgba(244, 197, 122, 0.16), transparent 36% ), linear-gradient(125deg, #173d32, #245847);
            box-shadow: 0 22px 48px rgba(23, 61, 50, 0.15);
        }

        .pa-adopter-edit__hero-glow {
            position: absolute;
            right: -100px;
            bottom: -190px;
            z-index: -1;
            width: 450px;
            height: 450px;
            border-radius: 50%;
            background: rgba(244, 197, 122, 0.12);
            filter: blur(65px);
            pointer-events: none;
        }

        .pa-adopter-edit__hero-content {
            position: relative;
            z-index: 2;
            min-width: 0;
            max-width: 730px;
            animation: pa-edit-enter 650ms ease both;
        }

        .pa-adopter-edit__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 24px;
            color: #f4c57a;
            font-size: 0.71rem;
            font-weight: 800;
            letter-spacing: 0.14em;
        }

        .pa-adopter-edit__eyebrow-dot {
            width: 8px;
            height: 8px;
            flex-shrink: 0;
            border-radius: 50%;
            background: #f4c57a;
            box-shadow: 0 0 0 5px rgba(244, 197, 122, 0.14);
        }

        .pa-adopter-edit__profile {
            display: flex;
            align-items: center;
            gap: 22px;
        }

        .pa-adopter-edit__avatar {
            display: grid;
            width: 90px;
            height: 90px;
            flex-shrink: 0;
            place-items: center;
            border: 1px solid rgba(244, 197, 122, 0.45);
            border-radius: 26px;
            background: rgba(244, 197, 122, 0.14);
            color: #f4c57a;
            font-family: "Fraunces", Georgia, serif;
            font-size: 3.05rem;
            font-weight: 600;
            backdrop-filter: blur(12px);
        }

        .pa-adopter-edit__profile-info {
            min-width: 0;
        }

        .pa-adopter-edit__profile-label {
            display: block;
            margin-bottom: 10px;
            color: #f4c57a;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.14em;
        }

        .pa-adopter-edit__profile-info h1 {
            margin: 0 0 10px;
            color: #fff;
            font-family: "Fraunces", Georgia, serif;
            font-size: clamp(2rem, 3.7vw, 3.45rem);
            font-weight: 600;
            letter-spacing: -0.055em;
            line-height: 1.14;
            overflow-wrap: anywhere;
        }

        .pa-adopter-edit__profile-id {
            color: rgba(255, 255, 255, 0.78);
            font-size: 0.82rem;
            font-weight: 600;
        }

        .pa-adopter-edit__hero-description {
            max-width: 560px;
            margin: 24px 0;
            color: rgba(255, 255, 255, 0.83);
            font-size: 0.94rem;
            line-height: 1.8;
        }

        .pa-adopter-edit__back {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: #fff;
            font-size: 0.85rem;
            font-weight: 700;
            text-decoration: none;
            transition: gap 220ms ease, color 220ms ease;
        }

            .pa-adopter-edit__back svg {
                width: 19px;
                height: 19px;
            }

            .pa-adopter-edit__back:hover {
                gap: 15px;
                color: #f4c57a;
            }

        .pa-adopter-edit__hero-art {
            position: relative;
            display: grid;
            width: 240px;
            height: 240px;
            flex-shrink: 0;
            place-items: center;
            margin-right: 20px;
            animation: pa-edit-float 6s ease-in-out infinite;
        }

        .pa-adopter-edit__art-ring {
            position: absolute;
            border: 1px solid rgba(244, 197, 122, 0.21);
            border-radius: 50%;
        }

        .pa-adopter-edit__art-ring--outer {
            inset: 0;
        }

        .pa-adopter-edit__art-ring--inner {
            inset: 35px;
            background: rgba(255, 255, 255, 0.035);
        }

        .pa-adopter-edit__art-center {
            display: grid;
            width: 122px;
            height: 122px;
            place-items: center;
            border: 1px solid rgba(244, 197, 122, 0.32);
            border-radius: 35px;
            background: rgba(244, 197, 122, 0.14);
            color: #f4c57a;
            transform: rotate(-7deg);
        }

            .pa-adopter-edit__art-center svg {
                width: 65px;
                height: 65px;
                transform: rotate(7deg);
            }

        .pa-adopter-edit__layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 315px;
            align-items: start;
            gap: 25px;
        }

        .pa-adopter-edit__main,
        .pa-adopter-edit__sidebar {
            min-width: 0;
        }

        .pa-adopter-edit__card {
            padding: clamp(25px, 3.5vw, 44px);
            border: 1px solid #e4ebe2;
            border-radius: 25px;
            background: #fffefa;
            box-shadow: 0 15px 45px rgba(23, 61, 50, 0.055);
        }

        .pa-adopter-edit__card-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
        }

        .pa-adopter-edit__card-eyebrow {
            display: block;
            margin-bottom: 11px;
            color: #a97843;
            font-size: 0.69rem;
            font-weight: 800;
            letter-spacing: 0.14em;
        }

        .pa-adopter-edit__card-header h2 {
            margin: 0 0 9px;
            color: #173d32;
            font-family: "Fraunces", Georgia, serif;
            font-size: clamp(1.65rem, 2.5vw, 2.2rem);
            font-weight: 600;
            letter-spacing: -0.045em;
        }

        .pa-adopter-edit__card-header p {
            margin: 0;
            color: #7a887d;
            font-size: 0.87rem;
            line-height: 1.7;
        }

        .pa-adopter-edit__card-icon {
            display: grid;
            width: 49px;
            height: 49px;
            flex-shrink: 0;
            place-items: center;
            border: 1px solid #dce9dc;
            border-radius: 15px;
            background: #edf5ec;
            color: #245847;
        }

            .pa-adopter-edit__card-icon svg {
                width: 24px;
                height: 24px;
            }

        .pa-adopter-edit__divider {
            height: 1px;
            margin: 30px 0 34px;
            background: #e6ece4;
        }

        .pa-adopter-edit__form-footer {
            margin-top: 38px;
            padding-top: 26px;
            border-top: 1px solid #e4ebe2;
        }

        .pa-adopter-edit__save-note {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            margin-bottom: 20px;
            color: #829085;
            font-size: 0.8rem;
            line-height: 1.65;
        }

            .pa-adopter-edit__save-note svg {
                width: 18px;
                height: 18px;
                flex-shrink: 0;
                margin-top: 1px;
                color: #77977d;
            }

        .pa-adopter-edit__actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 12px;
        }

        .pa-adopter-edit__cancel,
        .pa-adopter-edit__submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 11px;
            min-height: 52px;
            padding: 13px 22px;
            border-radius: 13px;
            font-size: 0.87rem;
            font-weight: 800;
            text-decoration: none;
            transition: transform 220ms ease, border-color 220ms ease, background-color 220ms ease, box-shadow 220ms ease;
        }

        .pa-adopter-edit__cancel {
            border: 1px solid #dbe5da;
            background: #fff;
            color: #53695b;
        }

            .pa-adopter-edit__cancel:hover {
                border-color: #adbfaf;
                background: #f1f6f0;
                color: #173d32;
            }

        .pa-adopter-edit__submit {
            border: 1px solid #173d32;
            background: linear-gradient(135deg, #245847, #173d32);
            color: #fff;
            box-shadow: 0 10px 23px rgba(23, 61, 50, 0.15);
            cursor: pointer;
        }

            .pa-adopter-edit__submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 16px 29px rgba(23, 61, 50, 0.23);
                color: #fff;
            }

            .pa-adopter-edit__submit svg {
                width: 19px;
                height: 19px;
            }

        .pa-adopter-edit__sidebar {
            display: grid;
            gap: 20px;
        }

        .pa-adopter-edit__guide {
            padding: 29px;
            border: 1px solid #e5e8dd;
            border-radius: 23px;
            background: radial-gradient( circle at top right, rgba(244, 197, 122, 0.14), transparent 45% ), #fbfaf4;
        }

        .pa-adopter-edit__guide-icon {
            display: grid;
            width: 46px;
            height: 46px;
            margin-bottom: 20px;
            place-items: center;
            border-radius: 14px;
            background: #e2eee0;
            color: #245847;
        }

            .pa-adopter-edit__guide-icon svg {
                width: 24px;
                height: 24px;
            }

        .pa-adopter-edit__guide-eyebrow {
            display: block;
            margin-bottom: 13px;
            color: #a17c49;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.14em;
        }

        .pa-adopter-edit__guide h2 {
            margin: 0;
            color: #173d32;
            font-family: "Fraunces", Georgia, serif;
            font-size: 1.8rem;
            font-weight: 600;
            letter-spacing: -0.045em;
            line-height: 1.25;
        }

            .pa-adopter-edit__guide h2 span {
                color: #c8914e;
            }

        .pa-adopter-edit__guide-description {
            margin: 16px 0 0;
            color: #788579;
            font-size: 0.84rem;
            line-height: 1.8;
        }

        .pa-adopter-edit__guide-divider {
            height: 1px;
            margin: 27px 0;
            background: #e3e8da;
        }

        .pa-adopter-edit__guide-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 22px;
        }

            .pa-adopter-edit__guide-item:last-child {
                margin-bottom: 0;
            }

        .pa-adopter-edit__guide-number {
            display: grid;
            width: 29px;
            height: 29px;
            flex-shrink: 0;
            place-items: center;
            border-radius: 9px;
            background: #e7eee3;
            color: #416b4b;
            font-size: 0.72rem;
            font-weight: 800;
        }

        .pa-adopter-edit__guide-item strong {
            display: block;
            margin-bottom: 5px;
            color: #294937;
            font-size: 0.83rem;
        }

        .pa-adopter-edit__guide-item p {
            margin: 0;
            color: #7c897e;
            font-size: 0.79rem;
            line-height: 1.7;
        }

        .pa-adopter-edit__notice {
            display: flex;
            align-items: flex-start;
            gap: 13px;
            padding: 23px;
            border: 1px solid #dfe9de;
            border-radius: 20px;
            background: #eff5ed;
        }

        .pa-adopter-edit__notice-icon {
            display: grid;
            width: 37px;
            height: 37px;
            flex-shrink: 0;
            place-items: center;
            border-radius: 12px;
            background: #deebdb;
            color: #245847;
        }

            .pa-adopter-edit__notice-icon svg {
                width: 20px;
                height: 20px;
            }

        .pa-adopter-edit__notice h3 {
            margin: 0 0 7px;
            color: #244d35;
            font-size: 0.9rem;
            font-weight: 800;
        }

        .pa-adopter-edit__notice p {
            margin: 0;
            color: #667b69;
            font-size: 0.79rem;
            line-height: 1.75;
        }

        .pa-adopter-edit__view-profile {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 10px;
            color: #54725b;
            font-size: 0.82rem;
            font-weight: 800;
            text-align: center;
            text-decoration: none;
            transition: color 200ms ease;
        }

            .pa-adopter-edit__view-profile:hover {
                color: #b47d40;
            }

            .pa-adopter-edit__view-profile svg {
                width: 19px;
                height: 19px;
            }

        .pa-adopter-edit a:focus-visible,
        .pa-adopter-edit button:focus-visible {
