@model IReadOnlyList<PetAdoption.Application.DTOs.AdopterDto>

@{
    ViewData["Title"] = "Adopters";
    ViewData["Description"] = "Manage adopter profiles and contact information in the PetAdoption administration workspace.";

    var adopterCount = Model.Count;
}

<div class="pa-adopters-index">

    <nav class="pa-adopters-index__breadcrumb"
         aria-label="Breadcrumb">

        <a asp-controller="Home"
           asp-action="Welcome">
            Home
        </a>

        <span aria-hidden="true">/</span>

        <span aria-current="page">
            Adopters
        </span>
    </nav>

    <header class="pa-adopters-index__hero">

        <div class="pa-adopters-index__hero-glow"
             aria-hidden="true"></div>

        <div class="pa-adopters-index__hero-content">

            <div class="pa-adopters-index__eyebrow">

                <span class="pa-adopters-index__eyebrow-dot"></span>

                ADMINISTRATION WORKSPACE
            </div>

            <h1>
                Adopter
                <span>Directory.</span>
            </h1>

            <p class="pa-adopters-index__hero-description">
                Manage adopter profiles, review contact
                information, and keep your records organized
                in one convenient workspace.
            </p>

            <div class="pa-adopters-index__hero-actions">

                <a asp-controller="AdoptersAdmin"
                   asp-action="Create"
                   class="pa-adopters-index__add-btn">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.9"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="M12 5v14" />
                        <path d="M5 12h14" />
                    </svg>

                    Add New Adopter
                </a>

                <span class="pa-adopters-index__hero-count">

                    <span class="pa-adopters-index__hero-count-dot"></span>

                    @adopterCount
                    @(adopterCount == 1 ? "profile" : "profiles")
                    in directory
                </span>
            </div>
        </div>

        <div class="pa-adopters-index__hero-art"
             aria-hidden="true">

            <div class="pa-adopters-index__art-ring
                        pa-adopters-index__art-ring--outer"></div>

            <div class="pa-adopters-index__art-ring
                        pa-adopters-index__art-ring--inner"></div>

            <div class="pa-adopters-index__art-center">

                <svg viewBox="0 0 64 64"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="24" cy="23" r="9" />

                    <path d="M7 53v-4c0-10 7-16 17-16s17 6 17 16v4" />

                    <circle cx="44" cy="23" r="7" />

                    <path d="M46 36c7 1 11 6 11 13v4" />
                </svg>
            </div>

            <span class="pa-adopters-index__art-spark
                         pa-adopters-index__art-spark--one"></span>

            <span class="pa-adopters-index__art-spark
                         pa-adopters-index__art-spark--two"></span>
        </div>
    </header>

    <section class="pa-adopters-index__directory"
             aria-labelledby="adopterDirectoryTitle">

        <div class="pa-adopters-index__directory-header">

            <div class="pa-adopters-index__directory-heading">

                <span class="pa-adopters-index__section-eyebrow">
                    ADOPTER MANAGEMENT
                </span>

                <h2 id="adopterDirectoryTitle">
                    All Adopters
                </h2>

                <p>
                    Browse and manage the adopter profiles
                    currently recorded on the platform.
                </p>
            </div>

            <div class="pa-adopters-index__directory-icon"
                 aria-hidden="true">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <rect x="3" y="4" width="18" height="16" rx="3" />

                    <path d="M8 9h8" />
                    <path d="M8 13h8" />
                    <path d="M8 17h5" />
                </svg>
            </div>
        </div>

        @if (adopterCount == 0)
        {
            <div class="pa-adopters-index__empty">

                <div class="pa-adopters-index__empty-art"
                     aria-hidden="true">

                    <span class="pa-adopters-index__empty-ring"></span>

                    <svg viewBox="0 0 64 64"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="25" cy="22" r="10" />
                        <path d="M7 54v-5c0-11 8-17 18-17 8 0 14 4 17 10" />
                        <path d="M49 40v17" />
                        <path d="M40.5 48.5h17" />
                    </svg>
                </div>

                <span class="pa-adopters-index__empty-eyebrow">
                    YOUR DIRECTORY IS EMPTY
                </span>

                <h3>
                    No adopter profiles yet.
                </h3>

                <p>
                    Adopter profiles will appear here once
                    they have been created or registered.
                    You can also add a profile manually.
                </p>

                <a asp-controller="AdoptersAdmin"
                   asp-action="Create"
                   class="pa-adopters-index__empty-btn">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.9"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="M12 5v14" />
                        <path d="M5 12h14" />
                    </svg>

                    Add First Adopter
                </a>
            </div>
        }
        else
        {
            <div class="pa-adopters-index__toolbar">

                <div class="pa-adopters-index__search">

                    <label for="adopterSearch"
                           class="pa-adopters-index__search-label">

                        Search directory
                    </label>

                    <div class="pa-adopters-index__search-wrap">

                        <svg class="pa-adopters-index__search-icon"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <circle cx="10.8" cy="10.8" r="6.8" />
                            <path d="m16 16 5 5" />
                        </svg>

                        <input type="search"
                               id="adopterSearch"
                               class="pa-adopters-index__search-input"
                               placeholder="Search name, email, phone, address..."
                               autocomplete="off"
                               aria-controls="adoptersTable"
                               aria-describedby="adopterSearchHint" />

                        <button type="button"
                                id="clearAdopterSearch"
                                class="pa-adopters-index__search-clear"
                                aria-label="Clear search"
                                hidden>

                            Clear
                        </button>
                    </div>

                    <span id="adopterSearchHint"
                          class="pa-adopters-index__search-hint">

                        Search the profiles currently displayed
                        in this directory.
                    </span>
                </div>

                <div class="pa-adopters-index__results">

                    <span class="pa-adopters-index__results-icon"
                          aria-hidden="true">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <rect x="3" y="4" width="18" height="16" rx="3" />
                            <path d="M8 9h8" />
                            <path d="M8 13h8" />
                            <path d="M8 17h5" />
                        </svg>
                    </span>

                    <span id="adopterResultsCount"
                          aria-live="polite"
                          aria-atomic="true">

                        Showing @adopterCount of @adopterCount
                        @(adopterCount == 1 ? "adopter" : "adopters")
                    </span>
                </div>
            </div>

            <div id="adoptersTableContainer"
                 class="pa-adopters-index__table-wrap">

                <table id="adoptersTable"
                       class="pa-adopters-index__table">

                    <thead>
                        <tr>
                            <th scope="col">
                                Adopter
                            </th>

                            <th scope="col">
                                Contact
                            </th>

                            <th scope="col">
                                Address
                            </th>

                            <th scope="col"
                                class="pa-adopters-index__actions-heading">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var adopter in Model)
                        {
                            var displayName = string.IsNullOrWhiteSpace(adopter.FullName)
                            ? "Unnamed Adopter"
                            : adopter.FullName.Trim();

                            var initial = displayName[0]
                            .ToString()
                            .ToUpperInvariant();

                            var hasEmail = !string.IsNullOrWhiteSpace(adopter.Email);
                            var hasPhone = !string.IsNullOrWhiteSpace(adopter.Phone);
                            var hasAddress = !string.IsNullOrWhiteSpace(adopter.Address);

                            var searchText = $"{displayName} {adopter.Email} {adopter.Phone} {adopter.Address} {adopter.Id}";

                            <tr data-pa-adopter-row
                                data-pa-search="@searchText">

                                <td data-label="Adopter">

                                    <div class="pa-adopters-index__person">

                                        <div class="pa-adopters-index__avatar"
                                             aria-hidden="true">

                                            @initial
                                        </div>

                                        <div class="pa-adopters-index__person-info">

                                            <a asp-controller="AdoptersAdmin"
                                               asp-action="Details"
                                               asp-route-id="@adopter.Id"
                                               class="pa-adopters-index__person-name">

                                                @displayName
                                            </a>

                                            <span class="pa-adopters-index__person-id">
                                                Adopter #@adopter.Id
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <td data-label="Contact">

                                    <div class="pa-adopters-index__contact">

                                        @if (hasEmail)
                                        {
                                            <a href="mailto:@adopter.Email"
                                               class="pa-adopters-index__contact-email">

                                                @adopter.Email
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="pa-adopters-index__muted">
                                                No email
                                            </span>
                                        }

                                        @if (hasPhone)
                                        {
                                            <a href="tel:@adopter.Phone"
                                               class="pa-adopters-index__contact-phone">

                                                @adopter.Phone
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="pa-adopters-index__contact-phone
                                                                     pa-adopters-index__muted">

                                                No phone
                                            </span>
                                        }
                                    </div>
                                </td>

                                <td data-label="Address">

                                    <div class="pa-adopters-index__address">

                                        @if (hasAddress)
                                        {
                                            @adopter.Address
                                        }
                                        else
                                        {
                                            <span class="pa-adopters-index__muted">
                                                Not provided
                                            </span>
                                        }
                                    </div>
                                </td>

                                <td data-label="Actions">

                                    <div class="pa-adopters-index__row-actions">

                                        <a asp-controller="AdoptersAdmin"
                                           asp-action="Details"
                                           asp-route-id="@adopter.Id"
                                           class="pa-adopters-index__action
                                                          pa-adopters-index__action--details"
                                           aria-label="View details for @displayName">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round"
                                                 aria-hidden="true">

                                                <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" />
                                                <circle cx="12" cy="12" r="3" />
                                            </svg>

                                            Details
                                        </a>

                                        <a asp-controller="AdoptersAdmin"
                                           asp-action="Edit"
                                           asp-route-id="@adopter.Id"
                                           class="pa-adopters-index__action
                                                          pa-adopters-index__action--edit"
                                           aria-label="Edit @displayName">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round"
                                                 aria-hidden="true">

                                                <path d="m15 5 4 4" />
                                                <path d="M4 20h4l12-12a2.8 2.8 0 0 0-4-4L4 16Z" />
                                            </svg>

                                            Edit
                                        </a>

                                        <a asp-controller="AdoptersAdmin"
                                           asp-action="Delete"
                                           asp-route-id="@adopter.Id"
                                           class="pa-adopters-index__action
                                                          pa-adopters-index__action--delete"
                                           aria-label="Delete @displayName">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round"
                                                 aria-hidden="true">

                                                <path d="M3 6h18" />
                                                <path d="M8 6V4h8v2" />
                                                <path d="M6 6l1 15h10l1-15" />
                                                <path d="M10 10v7" />
                                                <path d="M14 10v7" />
                                            </svg>

                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="adopterSearchEmpty"
                 class="pa-adopters-index__search-empty"
                 hidden>

                <div class="pa-adopters-index__search-empty-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <circle cx="10.8" cy="10.8" r="6.8" />
                        <path d="m16 16 5 5" />
                    </svg>
                </div>

                <h3>No matching adopters</h3>

                <p>
                    No profiles match your search.
                    Try a different name or contact detail.
                </p>

                <button type="button"
                        id="resetAdopterSearch"
                        class="pa-adopters-index__reset-btn">

                    Clear Search
                </button>
            </div>

            <div class="pa-adopters-index__table-footer">

                <div class="pa-adopters-index__footer-note">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 11v5" />
                        <path d="M12 8h.01" />
                    </svg>

                    Select Details to view a complete adopter profile.
                </div>

                <span class="pa-adopters-index__footer-total">

                    @adopterCount total
                    @(adopterCount == 1 ? "profile" : "profiles")
                </span>
            </div>
        }
    </section>
</div>

@section Styles {
    <style>
        .pa-adopters-index {
            width: 100%;
            max-width: 1350px;
            margin: 0 auto 55px;
        }

        .pa-adopters-index__breadcrumb {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 11px;
            margin-bottom: 24px;
            color: #89968b;
            font-size: 0.83rem;
        }

            .pa-adopters-index__breadcrumb a {
                color: #637a69;
                text-decoration: none;
                transition: color 200ms ease;
            }

                .pa-adopters-index__breadcrumb a:hover {
                    color: #c8914e;
                }

            .pa-adopters-index__breadcrumb [aria-current="page"] {
                color: #173d32;
                font-weight: 700;
            }

        .pa-adopters-index__hero {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            min-height: 300px;
            margin-bottom: 29px;
            padding: clamp(30px, 4.5vw, 58px);
            overflow: hidden;
            isolation: isolate;
            border-radius: 28px;
            background: radial-gradient( circle at 85% 45%, rgba(244, 197, 122, 0.16), transparent 35% ), linear-gradient(125deg, #173d32, #245847);
            box-shadow: 0 22px 48px rgba(23, 61, 50, 0.15);
        }

        .pa-adopters-index__hero-glow {
            position: absolute;
            right: -100px;
            bottom: -190px;
            z-index: -1;
            width: 450px;
            height: 450px;
            border-radius: 50%;
            background: rgba(244, 197, 122, 0.12);
            filter: blur(65px);
            pointer-events: none;
        }

        .pa-adopters-index__hero-content {
            position: relative;
            z-index: 2;
            max-width: 720px;
            animation: pa-adopters-enter 650ms ease both;
        }

        .pa-adopters-index__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 20px;
            color: #f4c57a;
            font-size: 0.71rem;
            font-weight: 800;
            letter-spacing: 0.14em;
        }

        .pa-adopters-index__eyebrow-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #f4c57a;
            box-shadow: 0 0 0 5px rgba(244, 197, 122, 0.13);
        }

        .pa-adopters-index__hero h1 {
            margin: 0;
            color: #fff;
            font-family: "Fraunces", Georgia, serif;
            font-size: clamp(2.7rem, 4.8vw, 4.4rem);
            font-weight: 600;
            letter-spacing: -0.06em;
            line-height: 1.08;
        }

            .pa-adopters-index__hero h1 span {
                display: block;
                color: #f4c57a;
            }

        .pa-adopters-index__hero-description {
            max-width: 550px;
            margin: 21px 0 28px;
            color: rgba(255, 255, 255, 0.83);
            font-size: 0.95rem;
            line-height: 1.8;
        }

        .pa-adopters-index__hero-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 16px 25px;
        }

        .pa-adopters-index__add-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 11px;
            min-height: 52px;
            padding: 13px 23px;
            border: 1px solid #f4c57a;
            border-radius: 13px;
            background: #f4c57a;
            color: #173d32;
            font-size: 0.88rem;
            font-weight: 800;
            text-decoration: none;
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.1);
            transition: transform 220ms ease, box-shadow 220ms ease, background-color 220ms ease;
        }

            .pa-adopters-index__add-btn:hover {
                transform: translateY(-2px);
                background: #ffdc9b;
                color: #173d32;
                box-shadow: 0 16px 30px rgba(0, 0, 0, 0.15);
            }

            .pa-adopters-index__add-btn svg {
                width: 19px;
                height: 19px;
            }

        .pa-adopters-index__hero-count {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: rgba(255, 255, 255, 0.86);
            font-size: 0.82rem;
            font-weight: 600;
        }

        .pa-adopters-index__hero-count-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #f4c57a;
        }

        .pa-adopters-index__hero-art {
            position: relative;
            display: grid;
            width: 245px;
            height: 245px;
            flex-shrink: 0;
            place-items: center;
            margin-right: 20px;
            animation: pa-adopters-float 6s ease-in-out infinite;
        }

        .pa-adopters-index__art-ring {
            position: absolute;
            border: 1px solid rgba(244, 197, 122, 0.23);
            border-radius: 50%;
        }

        .pa-adopters-index__art-ring--outer {
            inset: 0;
        }

        .pa-adopters-index__art-ring--inner {
            inset: 35px;
            background: rgba(255, 255, 255, 0.035);
        }

        .pa-adopters-index__art-center {
            display: grid;
            width: 125px;
            height: 125px;
            place-items: center;
            border: 1px solid rgba(244, 197, 122, 0.34);
            border-radius: 36px;
            background: rgba(244, 197, 122, 0.14);
            color: #f4c57a;
            transform: rotate(-7deg);
        }

            .pa-adopters-index__art-center svg {
                width: 67px;
                height: 67px;
                transform: rotate(7deg);
            }

        .pa-adopters-index__art-spark {
            position: absolute;
            border-radius: 50%;
            background: #f4c57a;
            box-shadow: 0 0 20px rgba(244, 197, 122, 0.55);
        }

        .pa-adopters-index__art-spark--one {
            top: 20px;
            right: 50px;
            width: 8px;
            height: 8px;
        }

        .pa-adopters-index__art-spark--two {
            bottom: 35px;
            left: 25px;
            width: 5px;
            height: 5px;
        }

        .pa-adopters-index__directory {
            overflow: hidden;
            border: 1px solid #e3ebe1;
            border-radius: 25px;
            background: #fffefa;
            box-shadow: 0 15px 45px rgba(23, 61, 50, 0.055);
        }

        .pa-adopters-index__directory-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            padding: 34px 35px 27px;
        }

        .pa-adopters-index__section-eyebrow {
            display: block;
            margin-bottom: 10px;
            color: #a97843;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.14em;
        }

        .pa-adopters-index__directory-heading h2 {
            margin: 0 0 8px;
            color: #173d32;
            font-family: "Fraunces", Georgia, serif;
            font-size: clamp(1.7rem, 2.5vw, 2.3rem);
            font-weight: 600;
            letter-spacing: -0.045em;
        }

        .pa-adopters-index__directory-heading p {
            margin: 0;
            color: #7a887d;
            font-size: 0.87rem;
            line-height: 1.7;
        }

        .pa-adopters-index__directory-icon {
            display: grid;
            width: 49px;
            height: 49px;
            flex-shrink: 0;
            place-items: center;
            border: 1px solid #dce9dc;
            border-radius: 15px;
            background: #edf5ec;
            color: #245847;
        }

            .pa-adopters-index__directory-icon svg {
                width: 24px;
                height: 24px;
            }

        .pa-adopters-index__toolbar {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
            padding: 23px 35px;
            border-top: 1px solid #e8eee6;
            border-bottom: 1px solid #e8eee6;
            background: #fbfcf9;
        }

        .pa-adopters-index__search {
            width: min(100%, 470px);
            min-width: 0;
        }

        .pa-adopters-index__search-label {
            display: block;
            margin-bottom: 9px;
            color: #365344;
            font-size: 0.83rem;
            font-weight: 800;
        }

        .pa-adopters-index__search-wrap {
            position: relative;
        }

        .pa-adopters-index__search-icon {
            position: absolute;
            top: 50%;
            left: 15px;
            width: 20px;
            height: 20px;
            color: #84988a;
            transform: translateY(-50%);
            pointer-events: none;
        }

        .pa-adopters-index__search-input {
            width: 100%;
            min-height: 51px;
            padding: 12px 70px 12px 45px;
            border: 1px solid #dce7dd;
            border-radius: 13px;
            background: #fff;
            color: #173d32;
            font-family: "DM Sans", sans-serif;
            font-size: 0.86rem;
            outline: none;
            transition: border-color 220ms ease, box-shadow 220ms ease;
        }

            .pa-adopters-index__search-input::placeholder {
                color: #9aa79c;
            }

            .pa-adopters-index__search-input:focus {
                border-color: #42755b;
                box-shadow: 0 0 0 4px rgba(36, 88, 71, 0.11);
            }

