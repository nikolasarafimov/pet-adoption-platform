@section Scripts {
    <script>
        (() => {
            const searchInput = document.getElementById("adopterSearch");
            const clearButton = document.getElementById("clearAdopterSearch");
            const resetButton = document.getElementById("resetAdopterSearch");
            const tableContainer = document.getElementById("adoptersTableContainer");
            const emptyState = document.getElementById("adopterSearchEmpty");
            const resultsCount = document.getElementById("adopterResultsCount");

            if (!searchInput || !tableContainer || !emptyState || !resultsCount) {
                return;
            }

            const rows = Array.from(
                document.querySelectorAll("[data-pa-adopter-row]")
            );

            const total = rows.length;

            const normalize = value =>
                value.trim().toLocaleLowerCase();

            const searchableRows = rows.map(row => ({
                element: row,
                searchText: normalize(row.dataset.paSearch || "")
            }));

            const filterAdopters = () => {
                const query = normalize(searchInput.value);
                let visibleCount = 0;

                searchableRows.forEach(({ element, searchText }) => {
                    const matches = !query || searchText.includes(query);

                    element.hidden = !matches;

                    if (matches) {
                        visibleCount++;
                    }
                });

                tableContainer.hidden = visibleCount === 0;
                emptyState.hidden = visibleCount !== 0;

                if (clearButton) {
                    clearButton.hidden = query.length === 0;
                }

                resultsCount.textContent =
                    `Showing ${visibleCount} of ${total} ` +
                    (total === 1 ? "adopter" : "adopters");
            };

            const resetSearch = () => {
                searchInput.value = "";
                filterAdopters();
                searchInput.focus();
            };

            searchInput.addEventListener("input", filterAdopters);

            searchInput.addEventListener("keydown", event => {
                if (event.key === "Escape" && searchInput.value) {
                    event.preventDefault();
                    resetSearch();
                }
            });

            clearButton?.addEventListener("click", resetSearch);
            resetButton?.addEventListener("click", resetSearch);

            filterAdopters();
        })();
    </script>
}