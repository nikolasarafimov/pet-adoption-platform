@model PetAdoption.Application.DTOs.AdopterDto

@{
    ViewData["Title"] = "Delete Adopter";
    ViewData["Description"] = "Review and confirm the deletion of an adopter profile.";

    var initial = string.IsNullOrWhiteSpace(Model.FullName)
        ? "?"
        : Model.FullName.Trim()[0].ToString().ToUpperInvariant();
}

<div class="pa-adopter-delete">

    <nav class="pa-adopter-delete__breadcrumb"
         aria-label="Breadcrumb">

        <a asp-controller="Home"
           asp-action="Welcome">
            Home
        </a>

        <span aria-hidden="true">/</span>

        <a asp-controller="AdoptersAdmin"
           asp-action="Index">
            Adopters
        </a>

        <span aria-hidden="true">/</span>

        <span aria-current="page">
            Delete Adopter
        </span>
    </nav>

    <section class="pa-adopter-delete__hero"
             aria-labelledby="deleteAdopterTitle">

        <div class="pa-adopter-delete__hero-glow"
             aria-hidden="true">
        </div>

        <div class="pa-adopter-delete__hero-content">

            <div class="pa-adopter-delete__eyebrow">

                <span class="pa-adopter-delete__eyebrow-dot"></span>

                ADMINISTRATION WORKSPACE
            </div>

            <h1 id="deleteAdopterTitle"
                class="pa-adopter-delete__hero-title">

                Delete adopter
                <span>profile.</span>
            </h1>

            <p class="pa-adopter-delete__hero-description">
                You're about to remove an adopter record.
                Review the information carefully before
                confirming this action.
            </p>

            <a asp-controller="AdoptersAdmin"
               asp-action="Index"
               class="pa-adopter-delete__back">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M19 12H5" />
                    <path d="m11 18-6-6 6-6" />
                </svg>

                Back to Adopters
            </a>
        </div>

        <div class="pa-adopter-delete__hero-art"
             aria-hidden="true">

            <div class="pa-adopter-delete__art-orbit"></div>
            <div class="pa-adopter-delete__art-orbit
                        pa-adopter-delete__art-orbit--inner">
            </div>

            <div class="pa-adopter-delete__art-center">

                <svg viewBox="0 0 64 64"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M22 22v-4a10 10 0 0 1 20 0v4" />
                    <rect x="14"
                          y="22"
                          width="36"
                          height="32"
                          rx="8" />
                    <circle cx="32" cy="37" r="3" />
                    <path d="M32 40v5" />
                </svg>
            </div>
        </div>
    </section>

    <div class="pa-adopter-delete__layout">

        <section class="pa-adopter-delete__main"
                 aria-labelledby="deleteConfirmTitle">

            <div class="pa-adopter-delete__card">

                <div class="pa-adopter-delete__warning-icon"
                     aria-hidden="true">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M10.3 3.9 2.2 18a2 2 0 0 0 1.7 3h16.2a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
                        <path d="M12 9v5" />
                        <path d="M12 18h.01" />
                    </svg>
                </div>

                <span class="pa-adopter-delete__card-eyebrow">
                    DELETE CONFIRMATION
                </span>

                <h2 id="deleteConfirmTitle"
                    class="pa-adopter-delete__card-title">

                    Are you sure you want to
                    <span>delete this adopter?</span>
                </h2>

                <p class="pa-adopter-delete__card-description">
                    This action permanently removes the adopter
                    profile from the platform if deletion is allowed.
                    Deleted profile information cannot be recovered
                    through the application.
                </p>

                <div class="pa-adopter-delete__divider"></div>

                <div class="pa-adopter-delete__profile">

                    <div class="pa-adopter-delete__profile-header">

                        <div class="pa-adopter-delete__avatar"
                             aria-hidden="true">
                            @initial
                        </div>

                        <div class="pa-adopter-delete__profile-identity">

                            <span class="pa-adopter-delete__profile-label">
                                SELECTED PROFILE
                            </span>

                            <h3>
                                @Model.FullName
                            </h3>

                            <span class="pa-adopter-delete__profile-id">
                                Adopter ID #@Model.Id
                            </span>
                        </div>
                    </div>

                    <div class="pa-adopter-delete__profile-divider"></div>

                    <dl class="pa-adopter-delete__details">

                        <div class="pa-adopter-delete__detail">

                            <dt>
                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.7"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">
                                    <rect x="3" y="5" width="18" height="14" rx="3" />
                                    <path d="m4 7 8 6 8-6" />
                                </svg>

                                Email Address
                            </dt>

                            <dd>
                                @(string.IsNullOrWhiteSpace(Model.Email)
                                                                ? "Not provided"
                                                                : Model.Email)
                            </dd>
                        </div>

                        <div class="pa-adopter-delete__detail">

                            <dt>
                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.7"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">
                                    <path d="M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" />
                                    <path d="M10 17h4" />
                                </svg>

                                Phone Number
                            </dt>

                            <dd>
                                @(string.IsNullOrWhiteSpace(Model.Phone)
                                                                ? "Not provided"
                                                                : Model.Phone)
                            </dd>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Address))
                        {
                            <div class="pa-adopter-delete__detail
                                            pa-adopter-delete__detail--full">

                                <dt>
                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.7"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         aria-hidden="true">
                                        <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                                        <circle cx="12" cy="10" r="2.5" />
                                    </svg>

                                    Address
                                </dt>

                                <dd>@Model.Address</dd>
                            </div>
                        }
                    </dl>
                </div>

                <div class="pa-adopter-delete__alert"
                     role="note">

                    <div class="pa-adopter-delete__alert-icon"
                         aria-hidden="true">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 11v5" />
                            <path d="M12 8h.01" />
                        </svg>
                    </div>

                    <div>
                        <strong>Important information</strong>

                        <p>
                            Profiles linked to a user account or
                            existing adoption requests cannot be
                            deleted through this action.
                        </p>
                    </div>
                </div>

                <form asp-controller="AdoptersAdmin"
                      asp-action="Delete"
                      method="post"
                      asp-antiforgery="true"
                      class="pa-adopter-delete__form">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <div class="pa-adopter-delete__form-heading">

                        <h3>
                            Confirm your decision
                        </h3>

                        <p>
                            Only continue if you intend to
                            permanently remove this record.
                        </p>
                    </div>

                    <div class="pa-adopter-delete__actions">

                        <a asp-controller="AdoptersAdmin"
                           asp-action="Index"
                           class="pa-adopter-delete__cancel">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M19 12H5" />
                                <path d="m11 18-6-6 6-6" />
                            </svg>

                            Keep Profile
                        </a>

                        <button type="submit"
                                class="pa-adopter-delete__submit">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M3 6h18" />
                                <path d="M8 6V4h8v2" />
                                <path d="M6 6l1 15h10l1-15" />
                                <path d="M10 10v7" />
                                <path d="M14 10v7" />
                            </svg>

                            Delete Adopter
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <aside class="pa-adopter-delete__sidebar"
               aria-label="Deletion guidance">

            <div class="pa-adopter-delete__guide">

                <div class="pa-adopter-delete__guide-icon"
                     aria-hidden="true">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.7"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" />
                        <path d="m9 12 2 2 4-4" />
                    </svg>
                </div>

                <span class="pa-adopter-delete__guide-eyebrow">
                    DATA PROTECTION
                </span>

                <h2>
                    Protecting
                    <span>adoption records.</span>
                </h2>

                <p>
                    PetAdoption keeps related records protected
                    by restricting deletion when important
                    account or adoption relationships exist.
                </p>

                <div class="pa-adopter-delete__guide-rule"></div>

                <div class="pa-adopter-delete__guide-item">

                    <span>01</span>

                    <div>
                        <strong>Review the profile</strong>
                        <p>Verify that you selected the correct adopter.</p>
                    </div>
                </div>

                <div class="pa-adopter-delete__guide-item">

                    <span>02</span>

                    <div>
                        <strong>Check related records</strong>
                        <p>Existing account links and adoption requests may prevent deletion.</p>
                    </div>
                </div>

                <div class="pa-adopter-delete__guide-item">

                    <span>03</span>

                    <div>
                        <strong>Confirm or go back</strong>
                        <p>You can cancel without making any changes.</p>
                    </div>
                </div>
            </div>

            <div class="pa-adopter-delete__sidebar-note">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 11v5" />
                    <path d="M12 8h.01" />
                </svg>

                <p>
                    Need to check something first?
                    <a asp-controller="AdoptersAdmin"
                       asp-action="Details"
                       asp-route-id="@Model.Id">
                        View adopter details
                    </a>
                </p>
            </div>
        </aside>
    </div>
</div>

@section Styles {
    <style>
        .pa-adopter-delete {
            width: 100%;
            max-width: 1320px;
            margin: 0 auto 55px;
        }

        .pa-adopter-delete__breadcrumb {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 11px;
            margin-bottom: 24px;
            color: #89968b;
            font-size: 0.83rem;
        }

            .pa-adopter-delete__breadcrumb a {
                color: #637a69;
                text-decoration: none;
                transition: color 200ms ease;
            }

                .pa-adopter-delete__breadcrumb a:hover {
                    color: #c8914e;
                }

            .pa-adopter-delete__breadcrumb [aria-current="page"] {
                color: #173d32;
                font-weight: 700;
            }

        .pa-adopter-delete__hero {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 265px;
            margin-bottom: 30px;
            padding: clamp(30px, 4.4vw, 58px);
            overflow: hidden;
            isolation: isolate;
            border-radius: 28px;
            background: radial-gradient( circle at 88% 40%, rgba(244, 197, 122, 0.13), transparent 35% ), linear-gradient(125deg, #173d32, #245847);
            box-shadow: 0 22px 48px rgba(23, 61, 50, 0.14);
        }

        .pa-adopter-delete__hero-glow {
            position: absolute;
            right: -100px;
            bottom: -200px;
            z-index: -1;
            width: 450px;
            height: 450px;
            border-radius: 50%;
            background: rgba(200, 145, 78, 0.12);
            filter: blur(65px);
            pointer-events: none;
        }

        .pa-adopter-delete__hero-content {
            position: relative;
            z-index: 2;
            max-width: 700px;
            animation: pa-delete-enter 600ms ease both;
        }

        .pa-adopter-delete__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 20px;
            color: #f4c57a;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.14em;
        }

        .pa-adopter-delete__eyebrow-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #f4c57a;
            box-shadow: 0 0 0 5px rgba(244, 197, 122, 0.12);
        }

        .pa-adopter-delete__hero-title {
            margin: 0;
            color: #fff;
            font-family: "Fraunces", Georgia, serif;
            font-size: clamp(2.3rem, 4vw, 3.7rem);
            font-weight: 600;
            letter-spacing: -0.055em;
            line-height: 1.14;
        }

            .pa-adopter-delete__hero-title span {
                display: block;
                color: #f4c57a;
            }

        .pa-adopter-delete__hero-description {
            max-width: 540px;
            margin: 19px 0 24px;
            color: rgba(255, 255, 255, 0.82);
            font-size: 0.94rem;
            line-height: 1.8;
        }

        .pa-adopter-delete__back {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: #fff;
            font-size: 0.85rem;
            font-weight: 700;
            text-decoration: none;
            transition: gap 220ms ease, color 220ms ease;
        }

            .pa-adopter-delete__back:hover {
                gap: 15px;
                color: #f4c57a;
            }

            .pa-adopter-delete__back svg {
                width: 19px;
                height: 19px;
            }

        .pa-adopter-delete__hero-art {
            position: relative;
            display: grid;
            width: 230px;
            height: 230px;
            flex-shrink: 0;
            place-items: center;
            margin-right: 30px;
            animation: pa-delete-float 6s ease-in-out infinite;
        }

        .pa-adopter-delete__art-orbit {
            position: absolute;
            inset: 0;
            border: 1px solid rgba(244, 197, 122, 0.19);
            border-radius: 50%;
        }

        .pa-adopter-delete__art-orbit--inner {
            inset: 32px;
            background: rgba(255, 255, 255, 0.035);
        }

        .pa-adopter-delete__art-center {
            display: grid;
            width: 112px;
            height: 112px;
            place-items: center;
            border: 1px solid rgba(244, 197, 122, 0.32);
            border-radius: 33px;
            background: rgba(244, 197, 122, 0.12);
            color: #f4c57a;
            transform: rotate(-8deg);
        }

            .pa-adopter-delete__art-center svg {
                width: 56px;
                height: 56px;
                transform: rotate(8deg);
            }

        .pa-adopter-delete__layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 310px;
            align-items: start;
            gap: 25px;
        }

        .pa-adopter-delete__main,
        .pa-adopter-delete__sidebar {
            min-width: 0;
        }

        .pa-adopter-delete__card {
            padding: clamp(25px, 3.5vw, 46px);
            border: 1px solid #e5ebe2;
            border-radius: 25px;
            background: #fffefa;
            box-shadow: 0 15px 45px rgba(23, 61, 50, 0.055);
        }

        .pa-adopter-delete__warning-icon {
            display: grid;
            width: 66px;
            height: 66px;
            margin-bottom: 24px;
            place-items: center;
            border: 1px solid #f2d4ce;
            border-radius: 21px;
            background: #fff0ec;
            color: #bd594d;
        }

            .pa-adopter-delete__warning-icon svg {
                width: 32px;
                height: 32px;
            }

        .pa-adopter-delete__card-eyebrow {
            display: block;
            margin-bottom: 13px;
            color: #b85e50;
            font-size: 0.71rem;
            font-weight: 800;
            letter-spacing: 0.15em;
        }

        .pa-adopter-delete__card-title {
            max-width: 640px;
            margin: 0;
            color: #173d32;
            font-family: "Fraunces", Georgia, serif;
            font-size: clamp(1.85rem, 2.9vw, 2.65rem);
            font-weight: 600;
            letter-spacing: -0.045em;
            line-height: 1.2;
        }

            .pa-adopter-delete__card-title span {
                color: #be6457;
            }

        .pa-adopter-delete__card-description {
            max-width: 630px;
            margin: 18px 0 0;
            color: #718076;
            font-size: 0.92rem;
            line-height: 1.8;
        }

        .pa-adopter-delete__divider {
            height: 1px;
            margin: 31px 0;
            background: #e6ece4;
        }

        .pa-adopter-delete__profile {
            padding: 25px;
            border: 1px solid #e2eae0;
            border-radius: 20px;
            background: #f8faf6;
        }

        .pa-adopter-delete__profile-header {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .pa-adopter-delete__avatar {
            display: grid;
            width: 65px;
            height: 65px;
            flex-shrink: 0;
            place-items: center;
            border: 1px solid #d6e4d6;
            border-radius: 19px;
            background: linear-gradient(145deg, #dcebdd, #eaf3e8);
            color: #245847;
            font-family: "Fraunces", Georgia, serif;
            font-size: 2rem;
            font-weight: 600;
        }

        .pa-adopter-delete__profile-identity {
            min-width: 0;
        }

        .pa-adopter-delete__profile-label {
            display: block;
            margin-bottom: 7px;
            color: #a07847;
            font-size: 0.67rem;
            font-weight: 800;
            letter-spacing: 0.12em;
        }

        .pa-adopter-delete__profile-identity h3 {
            margin: 0 0 5px;
            color: #173d32;
            font-size: clamp(1.12rem, 2vw, 1.45rem);
            font-weight: 800;
            overflow-wrap: anywhere;
        }

        .pa-adopter-delete__profile-id {
            color: #829086;
            font-size: 0.78rem;
        }

        .pa-adopter-delete__profile-divider {
            height: 1px;
            margin: 23px 0;
            background: #e0e9de;
        }

        .pa-adopter-delete__details {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 23px;
            margin: 0;
        }

        .pa-adopter-delete__detail {
            min-width: 0;
        }

        .pa-adopter-delete__detail--full {
            grid-column: 1 / -1;
        }

        .pa-adopter-delete__detail dt {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 10px;
            color: #819086;
            font-size: 0.79rem;
            font-weight: 600;
        }

            .pa-adopter-delete__detail dt svg {
                width: 17px;
                height: 17px;
                flex-shrink: 0;
            }

        .pa-adopter-delete__detail dd {
            margin: 0;
            color: #2b4739;
            font-size: 0.9rem;
            font-weight: 700;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .pa-adopter-delete__alert {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            margin-top: 25px;
            padding: 19px;
            border: 1px solid #f1d8b6;
            border-radius: 16px;
            background: #fff8ed;
        }

        .pa-adopter-delete__alert-icon {
            display: grid;
            width: 37px;
            height: 37px;
            flex-shrink: 0;
            place-items: center;
            border-radius: 12px;
            background: #f9eacb;
            color: #ad7738;
        }

            .pa-adopter-delete__alert-icon svg {
                width: 20px;
                height: 20px;
            }

        .pa-adopter-delete__alert strong {
            display: block;
            margin-bottom: 6px;
            color: #805c30;
            font-size: 0.86rem;
        }

        .pa-adopter-delete__alert p {
            margin: 0;
            color: #896f4d;
            font-size: 0.81rem;
            line-height: 1.75;
        }

        .pa-adopter-delete__form {
            margin-top: 34px;
            padding-top: 28px;
            border-top: 1px solid #e6ece4;
        }

        .pa-adopter-delete__form-heading h3 {
            margin: 0 0 7px;
            color: #173d32;
            font-size: 1.06rem;
            font-weight: 800;
        }

        .pa-adopter-delete__form-heading p {
            margin: 0;
            color: #839087;
            font-size: 0.83rem;
            line-height: 1.7;
        }

        .pa-adopter-delete__actions {
            display: flex;
            flex-wrap: wrap;
            gap: 13px;
            margin-top: 25px;
        }

        .pa-adopter-delete__cancel,
        .pa-adopter-delete__submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-height: 54px;
            padding: 14px 23px;
            border-radius: 13px;
            font-size: 0.87rem;
            font-weight: 800;
            text-decoration: none;
            transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease, background-color 220ms ease;
        }

        .pa-adopter-delete__cancel {
            border: 1px solid #dce6dc;
            background: #fff;
            color: #3f634d;
        }

            .pa-adopter-delete__cancel:hover {
                border-color: #a9c3ad;
                background: #eff5ed;
                color: #173d32;
            }

        .pa-adopter-delete__submit {
            border: 1px solid #ad453c;
            background: linear-gradient(135deg, #cb6559, #a83f37);
            color: #fff;
            box-shadow: 0 10px 22px rgba(168, 63, 55, 0.16);
            cursor: pointer;
        }

            .pa-adopter-delete__submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 15px 28px rgba(168, 63, 55, 0.25);
                color: #fff;
            }

            .pa-adopter-delete__cancel svg,
            .pa-adopter-delete__submit svg {
                width: 19px;
                height: 19px;
            }

            .pa-adopter-delete__breadcrumb a:focus-visible,
            .pa-adopter-delete__back:focus-visible,
