@model PetAdoption.Application.DTOs.AdopterDto

@{
    ViewData["Title"] = "Delete Adopter";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card p-4 p-md-5">
            <div class="text-center mb-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 mb-3"
                     style="width: 80px; height: 80px;">
                    <span class="fs-2">
                        ⚠️
                    </span>
                </div>

                <h1 class="section-title text-danger mb-2">
                    Delete Adopter?
                </h1>

                <p class="section-subtitle mb-0">
                    This action permanently removes the adopter profile.
                </p>
            </div>

            <div class="bg-light rounded-4 p-4 mb-4">
                <h4 class="mb-3">
                    @Model.FullName
                </h4>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="small text-muted">
                            Email
                        </div>

                        <div>
                            @(Model.Email ?? "-")
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="small text-muted">
                            Phone
                        </div>

                        <div>
                            @(Model.Phone ?? "-")
                        </div>
                    </div>
                </div>
            </div>

            <form asp-action="Delete"
                  method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <div class="d-flex flex-column flex-sm-row gap-2">
                    <button type="submit"
                            class="btn btn-danger flex-grow-1">
                        Delete Adopter
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>