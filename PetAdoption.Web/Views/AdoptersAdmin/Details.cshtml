@model PetAdoption.Application.DTOs.AdopterDto

@{
    ViewData["Title"] = "Adopter Details";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <a asp-action="Index"
           class="btn btn-sm btn-outline-secondary mb-4">
            ← Back to Adopters
        </a>

        <div class="card p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row align-items-md-center gap-4 mb-5">
                <div class="d-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10"
                     style="width: 86px; height: 86px;">
                    <span class="fs-1">
                        👤
                    </span>
                </div>

                <div>
                    <div class="text-success text-uppercase small fw-semibold mb-1">
                        Adopter Profile
                    </div>

                    <h1 class="section-title mb-1">
                        @Model.FullName
                    </h1>

                    <div class="text-muted">
                        Adopter ID #@Model.Id
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="bg-light rounded-4 p-4 h-100">
                        <div class="small text-muted mb-1">
                            Email
                        </div>

                        <div class="fw-semibold">
                            @(Model.Email ?? "-")
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="bg-light rounded-4 p-4 h-100">
                        <div class="small text-muted mb-1">
                            Phone
                        </div>

                        <div class="fw-semibold">
                            @(Model.Phone ?? "-")
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="bg-light rounded-4 p-4">
                        <div class="small text-muted mb-1">
                            Address
                        </div>

                        <div class="fw-semibold">
                            @(Model.Address ?? "-")
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="bg-light rounded-4 p-4">
                        <div class="small text-muted mb-1">
                            Notes
                        </div>

                        <div>
                            @(string.IsNullOrWhiteSpace(Model.Notes)
                                                        ? "No notes available."
                                                        : Model.Notes)
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-5">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary px-4">
                    Edit Profile
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger">
                    Delete
                </a>
            </div>
        </div>
    </div>
</div>