@model PetAdoption.Application.DTOs.AdopterDto

@{
    ViewData["Title"] = "Adopter Details";
    ViewData["Description"] = "View adopter profile information and manage adopter records.";

    var adopterName = string.IsNullOrWhiteSpace(Model.FullName)
        ? "Unnamed Adopter"
        : Model.FullName.Trim();

    var initial = adopterName[0].ToString().ToUpperInvariant();

    var hasEmail = !string.IsNullOrWhiteSpace(Model.Email);
    var hasPhone = !string.IsNullOrWhiteSpace(Model.Phone);
    var hasAddress = !string.IsNullOrWhiteSpace(Model.Address);
    var hasNotes = !string.IsNullOrWhiteSpace(Model.Notes);
}

<div class="pa-adopter-details">

    <nav class="pa-adopter-details__breadcrumb"
         aria-label="Breadcrumb">

        <a asp-controller="Home"
           asp-action="Welcome">
            Home
        </a>

        <span aria-hidden="true">/</span>

        <a asp-controller="AdoptersAdmin"
           asp-action="Index">
            Adopters
        </a>

        <span aria-hidden="true">/</span>

        <span aria-current="page">
            Profile Details
        </span>
    </nav>

    <header class="pa-adopter-details__hero">

        <div class="pa-adopter-details__hero-glow"
             aria-hidden="true"></div>

        <div class="pa-adopter-details__hero-content">

            <div class="pa-adopter-details__eyebrow">

                <span class="pa-adopter-details__eyebrow-dot"></span>

                ADMINISTRATION WORKSPACE
            </div>

            <div class="pa-adopter-details__hero-profile">

                <div class="pa-adopter-details__avatar"
                     aria-hidden="true">

                    <span>@initial</span>
                </div>

                <div class="pa-adopter-details__hero-info">

                    <span class="pa-adopter-details__profile-label">
                        ADOPTER PROFILE
                    </span>

                    <h1 id="adopterProfileTitle">
                        @adopterName
                    </h1>

                    <div class="pa-adopter-details__profile-id">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <rect x="3" y="5" width="18" height="14" rx="3" />
                            <circle cx="8" cy="12" r="2" />
                            <path d="M13 10h5M13 14h5" />
                        </svg>

                        Adopter ID #@Model.Id
                    </div>
                </div>
            </div>

            <p class="pa-adopter-details__hero-description">
                View and manage this adopter's contact
                information and administrative profile.
            </p>

            <a asp-controller="AdoptersAdmin"
               asp-action="Index"
               class="pa-adopter-details__back">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <path d="M19 12H5" />
                    <path d="m11 18-6-6 6-6" />
                </svg>

                Back to Adopters
            </a>
        </div>

        <div class="pa-adopter-details__hero-art"
             aria-hidden="true">

            <div class="pa-adopter-details__art-ring"></div>

            <div class="pa-adopter-details__art-ring
                        pa-adopter-details__art-ring--inner"></div>

            <div class="pa-adopter-details__art-center">

                <svg viewBox="0 0 64 64"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="26" cy="21" r="10" />

                    <path d="M7 54v-5c0-10 8-16 19-16s19 6 19 16v5" />

                    <path d="M49 22c-2.8-4.4-10-2.2-10 3.1 0 5 10 11.5 10 11.5s10-6.5 10-11.5c0-5.3-7.2-7.5-10-3.1Z" />
                </svg>
            </div>

            <span class="pa-adopter-details__art-spark
                         pa-adopter-details__art-spark--one"></span>

            <span class="pa-adopter-details__art-spark
                         pa-adopter-details__art-spark--two"></span>
        </div>
    </header>

    <div class="pa-adopter-details__layout">

        <div class="pa-adopter-details__main">

            <section class="pa-adopter-details__card"
                     aria-labelledby="contactDetailsTitle">

                <div class="pa-adopter-details__card-header">

                    <div class="pa-adopter-details__card-heading">

                        <span class="pa-adopter-details__card-eyebrow">
                            PROFILE INFORMATION
                        </span>

                        <h2 id="contactDetailsTitle">
                            Contact Details
                        </h2>

                        <p>
                            The contact information stored
                            for this adopter.
                        </p>
                    </div>

                    <span class="pa-adopter-details__card-icon"
                          aria-hidden="true">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <rect x="4" y="3" width="16" height="18" rx="3" />

                            <circle cx="12" cy="9" r="2.5" />

                            <path d="M8 17c0-2.5 1.8-4 4-4s4 1.5 4 4" />
                        </svg>
                    </span>
                </div>

                <div class="pa-adopter-details__divider"></div>

                <dl class="pa-adopter-details__info-grid">

                    <div class="pa-adopter-details__info-item">

                        <dt>
                            <span class="pa-adopter-details__info-icon"
                                  aria-hidden="true">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <rect x="3" y="5" width="18" height="14" rx="3" />

                                    <path d="m4 7 8 6 8-6" />
                                </svg>
                            </span>

                            <span>Email Address</span>
                        </dt>

                        <dd>
                            @if (hasEmail)
                            {
                                <a href="mailto:@Model.Email">
                                    @Model.Email
                                </a>
                            }
                            else
                            {
                                <span class="pa-adopter-details__empty-value">
                                    Not provided
                                </span>
                            }
                        </dd>
                    </div>

                    <div class="pa-adopter-details__info-item">

                        <dt>
                            <span class="pa-adopter-details__info-icon"
                                  aria-hidden="true">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <path d="M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" />

                                    <path d="M10 17h4" />
                                </svg>
                            </span>

                            <span>Phone Number</span>
                        </dt>

                        <dd>
                            @if (hasPhone)
                            {
                                <a href="tel:@Model.Phone">
                                    @Model.Phone
                                </a>
                            }
                            else
                            {
                                <span class="pa-adopter-details__empty-value">
                                    Not provided
                                </span>
                            }
                        </dd>
                    </div>

                    <div class="pa-adopter-details__info-item
                                pa-adopter-details__info-item--full">

                        <dt>
                            <span class="pa-adopter-details__info-icon"
                                  aria-hidden="true">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />

                                    <circle cx="12" cy="10" r="2.5" />
                                </svg>
                            </span>

                            <span>Residential Address</span>
                        </dt>

                        <dd>
                            @if (hasAddress)
                            {
                                @Model.Address
                            }
                            else
                            {
                                <span class="pa-adopter-details__empty-value">
                                    Not provided
                                </span>
                            }
                        </dd>
                    </div>
                </dl>
            </section>

            <section class="pa-adopter-details__card
                            pa-adopter-details__notes-card"
                     aria-labelledby="adopterNotesTitle">

                <div class="pa-adopter-details__card-header">

                    <div class="pa-adopter-details__card-heading">

                        <span class="pa-adopter-details__card-eyebrow">
                            INTERNAL REFERENCE
                        </span>

                        <h2 id="adopterNotesTitle">
                            Administrative Notes
                        </h2>

                        <p>
                            Additional information saved
                            with this adopter profile.
                        </p>
                    </div>

                    <span class="pa-adopter-details__card-icon
                                 pa-adopter-details__card-icon--gold"
                          aria-hidden="true">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M8 4h9a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8Z" />

                            <path d="M8 4v4H4" />

                            <path d="M8 13h8" />

                            <path d="M8 17h6" />
                        </svg>
                    </span>
                </div>

                <div class="pa-adopter-details__divider"></div>

                @if (hasNotes)
                {
                    <div class="pa-adopter-details__notes-content">
                        @Model.Notes
                    </div>
                }
                else
                {
                    <div class="pa-adopter-details__notes-empty">

                        <span class="pa-adopter-details__notes-empty-icon"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M8 4h9a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8Z" />

                                <path d="M8 4v4H4" />

                                <path d="M8 13h8" />
                            </svg>
                        </span>

                        <strong>No notes available</strong>

                        <p>
                            No additional notes have been
                            recorded for this adopter.
                        </p>
                    </div>
                }
            </section>
        </div>

        <aside class="pa-adopter-details__sidebar"
               aria-label="Profile actions">

            <section class="pa-adopter-details__action-card"
                     aria-labelledby="profileActionsTitle">

                <span class="pa-adopter-details__action-eyebrow">
                    PROFILE MANAGEMENT
                </span>

                <h2 id="profileActionsTitle">
                    Quick Actions
                </h2>

                <p>
                    Manage the details of this adopter
                    through the administration workspace.
                </p>

                <div class="pa-adopter-details__action-buttons">

                    <a asp-controller="AdoptersAdmin"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="pa-adopter-details__edit-btn">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <path d="m15 5 4 4" />

                            <path d="M4 20h4l12-12a2.8 2.8 0 0 0-4-4L4 16Z" />
                        </svg>

                        Edit Profile
                    </a>

                    <a asp-controller="AdoptersAdmin"
                       asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="pa-adopter-details__delete-btn">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <path d="M3 6h18" />

                            <path d="M8 6V4h8v2" />

                            <path d="M6 6l1 15h10l1-15" />

                            <path d="M10 10v7" />

                            <path d="M14 10v7" />
                        </svg>

                        Delete Profile
                    </a>
                </div>

                <div class="pa-adopter-details__action-footer">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 11v5" />
                        <path d="M12 8h.01" />
                    </svg>

                    Deletion requires confirmation
                    and may be restricted by related records.
                </div>
            </section>

            <section class="pa-adopter-details__info-panel"
                     aria-labelledby="recordInfoTitle">

                <span class="pa-adopter-details__info-panel-icon"
                      aria-hidden="true">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" />

                        <path d="m9 12 2 2 4-4" />
                    </svg>
                </span>

                <h2 id="recordInfoTitle">
                    About This Record
                </h2>

                <p>
                    This page contains the adopter's
                    administrative profile information.
                </p>

                <div class="pa-adopter-details__info-panel-divider"></div>

                <p>
                    Editing the profile email does not
                    automatically update an associated
                    Identity account's sign-in email.
                </p>
            </section>

            <a asp-controller="AdoptersAdmin"
               asp-action="Index"
               class="pa-adopter-details__sidebar-back">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <path d="M19 12H5" />
                    <path d="m11 18-6-6 6-6" />
                </svg>

                Return to Adopter Directory
            </a>
        </aside>
    </div>
</div>

@section Styles {
    <style>
        .pa-adopter-details {
            width: 100%;
            max-width: 1350px;
            margin: 0 auto 55px;
        }

        .pa-adopter-details__breadcrumb {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 11px;
            margin-bottom: 24px;
            color: #89968b;
            font-size: 0.83rem;
        }

            .pa-adopter-details__breadcrumb a {
                color: #637a69;
                text-decoration: none;
                transition: color 200ms ease;
            }

                .pa-adopter-details__breadcrumb a:hover {
                    color: #c8914e;
                }

            .pa-adopter-details__breadcrumb [aria-current="page"] {
                color: #173d32;
                font-weight: 700;
            }

        .pa-adopter-details__hero {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            min-height: 310px;
            margin-bottom: 29px;
            padding: clamp(30px, 4.5vw, 58px);
            overflow: hidden;
            isolation: isolate;
            border-radius: 28px;
            background: radial-gradient( circle at 86% 50%, rgba(244, 197, 122, 0.16), transparent 35% ), linear-gradient(125deg, #173d32, #245847);
            box-shadow: 0 22px 48px rgba(23, 61, 50, 0.15);
        }

        .pa-adopter-details__hero-glow {
            position: absolute;
            right: -110px;
            bottom: -190px;
            z-index: -1;
            width: 460px;
            height: 460px;
            border-radius: 50%;
            background: rgba(244, 197, 122, 0.11);
            filter: blur(65px);
            pointer-events: none;
        }

        .pa-adopter-details__hero-content {
            position: relative;
            z-index: 2;
            min-width: 0;
            max-width: 730px;
            animation: pa-details-enter 650ms ease both;
        }

        .pa-adopter-details__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 23px;
            color: #f4c57a;
            font-size: 0.71rem;
            font-weight: 800;
            letter-spacing: 0.14em;
        }

        .pa-adopter-details__eyebrow-dot {
            width: 8px;
            height: 8px;
            flex-shrink: 0;
            border-radius: 50%;
            background: #f4c57a;
            box-shadow: 0 0 0 5px rgba(244, 197, 122, 0.14);
        }

        .pa-adopter-details__hero-profile {
            display: flex;
            align-items: center;
            gap: 23px;
        }

        .pa-adopter-details__avatar {
            display: grid;
            width: 94px;
            height: 94px;
            flex-shrink: 0;
            place-items: center;
            border: 1px solid rgba(244, 197, 122, 0.45);
            border-radius: 27px;
            background: linear-gradient( 145deg, rgba(244, 197, 122, 0.22), rgba(244, 197, 122, 0.08) );
            color: #f4c57a;
            font-family: "Fraunces", Georgia, serif;
            font-size: 3.15rem;
            font-weight: 600;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
            backdrop-filter: blur(12px);
        }

        .pa-adopter-details__hero-info {
            min-width: 0;
        }

        .pa-adopter-details__profile-label {
            display: block;
            margin-bottom: 9px;
            color: #f4c57a;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.14em;
        }

        .pa-adopter-details__hero h1 {
            margin: 0 0 13px;
            color: #ffffff;
            font-family: "Fraunces", Georgia, serif;
            font-size: clamp(2rem, 3.8vw, 3.6rem);
            font-weight: 600;
            letter-spacing: -0.055em;
            line-height: 1.17;
            overflow-wrap: anywhere;
        }

        .pa-adopter-details__profile-id {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: rgba(255, 255, 255, 0.77);
            font-size: 0.82rem;
            font-weight: 600;
        }

            .pa-adopter-details__profile-id svg {
                width: 17px;
                height: 17px;
            }

        .pa-adopter-details__hero-description {
            max-width: 550px;
            margin: 23px 0;
            color: rgba(255, 255, 255, 0.83);
            font-size: 0.94rem;
            line-height: 1.8;
        }

        .pa-adopter-details__back {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: #ffffff;
            font-size: 0.85rem;
            font-weight: 700;
            text-decoration: none;
            transition: gap 220ms ease, color 220ms ease;
        }

            .pa-adopter-details__back:hover {
                gap: 15px;
                color: #f4c57a;
            }

            .pa-adopter-details__back svg {
                width: 19px;
                height: 19px;
            }

        .pa-adopter-details__hero-art {
            position: relative;
            display: grid;
            width: 240px;
            height: 240px;
            flex-shrink: 0;
            place-items: center;
            margin-right: 20px;
            animation: pa-details-float 6s ease-in-out infinite;
        }

        .pa-adopter-details__art-ring {
            position: absolute;
            inset: 0;
            border: 1px solid rgba(244, 197, 122, 0.2);
            border-radius: 50%;
        }

        .pa-adopter-details__art-ring--inner {
            inset: 35px;
            background: rgba(255, 255, 255, 0.035);
        }

        .pa-adopter-details__art-center {
            display: grid;
            width: 122px;
            height: 122px;
            place-items: center;
            border: 1px solid rgba(244, 197, 122, 0.34);
            border-radius: 35px;
            background: rgba(244, 197, 122, 0.13);
            color: #f4c57a;
            backdrop-filter: blur(12px);
            transform: rotate(-7deg);
        }

            .pa-adopter-details__art-center svg {
                width: 65px;
                height: 65px;
                transform: rotate(7deg);
            }

        .pa-adopter-details__art-spark {
            position: absolute;
            border-radius: 50%;
            background: #f4c57a;
            box-shadow: 0 0 20px rgba(244, 197, 122, 0.6);
        }

        .pa-adopter-details__art-spark--one {
            top: 22px;
            right: 47px;
            width: 8px;
            height: 8px;
        }

        .pa-adopter-details__art-spark--two {
            bottom: 35px;
            left: 25px;
            width: 5px;
            height: 5px;
        }

        .pa-adopter-details__layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 315px;
            align-items: start;
            gap: 25px;
        }

        .pa-adopter-details__main,
        .pa-adopter-details__sidebar {
            min-width: 0;
        }

        .pa-adopter-details__main,
        .pa-adopter-details__sidebar {
            display: grid;
            gap: 23px;
        }

        .pa-adopter-details__card {
            padding: clamp(25px, 3.5vw, 43px);
            border: 1px solid #e4ebe2;
            border-radius: 25px;
            background: #fffefa;
            box-shadow: 0 15px 45px rgba(23, 61, 50, 0.055);
        }

        .pa-adopter-details__card-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 18px;
        }

        .pa-adopter-details__card-heading {
            min-width: 0;
        }

        .pa-adopter-details__card-eyebrow {
            display: block;
            margin-bottom: 11px;
            color: #a97843;
            font-size: 0.69rem;
            font-weight: 800;
            letter-spacing: 0.14em;
        }

        .pa-adopter-details__card-heading h2 {
            margin: 0 0 9px;
            color: #173d32;
            font-family: "Fraunces", Georgia, serif;
            font-size: clamp(1.65rem, 2.5vw, 2.2rem);
            font-weight: 600;
            letter-spacing: -0.045em;
        }

        .pa-adopter-details__card-heading p {
            margin: 0;
            color: #7c897f;
            font-size: 0.87rem;
            line-height: 1.7;
        }

        .pa-adopter-details__card-icon {
            display: grid;
            width: 49px;
            height: 49px;
            flex-shrink: 0;
            place-items: center;
            border: 1px solid #dce9dc;
            border-radius: 15px;
            background: #edf5ec;
            color: #245847;
        }

        .pa-adopter-details__card-icon--gold {
            border-color: #efe2c7;
            background: #fcf4e6;
            color: #b47d40;
        }

        .pa-adopter-details__card-icon svg {
            width: 24px;
            height: 24px;
        }

        .pa-adopter-details__divider {
            height: 1px;
            margin: 29px 0;
            background: #e6ece4;
        }

        .pa-adopter-details__info-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
            margin: 0;
        }

        .pa-adopter-details__info-item {
            min-width: 0;
            padding: 23px;
            border: 1px solid #e4ebe2;
            border-radius: 18px;
            background: #f8faf6;
            transition: transform 250ms ease, border-color 250ms ease, box-shadow 250ms ease;
        }

            .pa-adopter-details__info-item:hover {
                transform: translateY(-3px);
                border-color: #c9ddcb;
                box-shadow: 0 12px 25px rgba(23, 61, 50, 0.055);
            }

        .pa-adopter-details__info-item--full {
            grid-column: 1 / -1;
        }

        .pa-adopter-details__info-item dt {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 17px;
            color: #7e8c81;
