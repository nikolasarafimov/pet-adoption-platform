@model PetAdoption.Web.Models.Adopters.AdopterFormVm

@{
    ViewData["Title"] = "Add Adopter";
    ViewData["Description"] = "Create and manage adopter profiles through the PetAdoption administration workspace.";
}

<div class="pa-adopter-create">

    <nav class="pa-adopter-create__breadcrumb"
         aria-label="Breadcrumb">

        <a asp-controller="Home"
           asp-action="Welcome">
            Home
        </a>

        <span aria-hidden="true">/</span>

        <a asp-controller="AdoptersAdmin"
           asp-action="Index">
            Adopters
        </a>

        <span aria-hidden="true">/</span>

        <span aria-current="page">
            Add Adopter
        </span>
    </nav>

    <section class="pa-adopter-create__hero"
             aria-labelledby="createAdopterTitle">

        <div class="pa-adopter-create__hero-glow"
             aria-hidden="true">
        </div>

        <div class="pa-adopter-create__hero-content">

            <div class="pa-adopter-create__eyebrow">

                <span class="pa-adopter-create__eyebrow-dot"></span>

                ADMINISTRATION WORKSPACE
            </div>

            <h1 id="createAdopterTitle"
                class="pa-adopter-create__hero-title">

                Create an
                <span>adopter profile.</span>
            </h1>

            <p class="pa-adopter-create__hero-description">
                Add a new adopter to your records and keep
                important contact information organized
                in one place.
            </p>

            <a asp-controller="AdoptersAdmin"
               asp-action="Index"
               class="pa-adopter-create__back">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <path d="M19 12H5" />
                    <path d="m11 18-6-6 6-6" />
                </svg>

                Back to Adopters
            </a>
        </div>

        <div class="pa-adopter-create__hero-art"
             aria-hidden="true">

            <div class="pa-adopter-create__art-ring
                        pa-adopter-create__art-ring--outer">
            </div>

            <div class="pa-adopter-create__art-ring
                        pa-adopter-create__art-ring--inner">
            </div>

            <div class="pa-adopter-create__art-center">

                <svg viewBox="0 0 64 64"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.4"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="27" cy="23" r="10" />

                    <path d="M8 53v-5c0-10 8-16 19-16s19 6 19 16v5" />

                    <path d="M52 18v18" />

                    <path d="M43 27h18" />
                </svg>
            </div>

            <span class="pa-adopter-create__art-spark
                         pa-adopter-create__art-spark--one">
            </span>

            <span class="pa-adopter-create__art-spark
                         pa-adopter-create__art-spark--two">
            </span>
        </div>
    </section>

    <div class="pa-adopter-create__layout">

        <section class="pa-adopter-create__main"
                 aria-labelledby="profileFormTitle">

            <div class="pa-adopter-create__card">

                <div class="pa-adopter-create__card-heading">

                    <div>
                        <span class="pa-adopter-create__card-eyebrow">
                            NEW RECORD
                        </span>

                        <h2 id="profileFormTitle">
                            Profile Details
                        </h2>

                        <p>
                            Complete the information below to
                            create a new adopter profile.
                        </p>
                    </div>

                    <div class="pa-adopter-create__card-icon"
                         aria-hidden="true">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M8 4h9a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8Z" />

                            <path d="M8 4v4H4" />

                            <path d="M8 13h8" />

                            <path d="M8 17h6" />
                        </svg>
                    </div>
                </div>

                <div class="pa-adopter-create__card-divider"></div>

                <form asp-controller="AdoptersAdmin"
                      asp-action="Create"
                      method="post"
                      asp-antiforgery="true"
                      class="pa-adopter-create__form">

                    <partial name="_AdopterForm"
                             model="Model" />

                    <div class="pa-adopter-create__actions">

                        <div class="pa-adopter-create__actions-info">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">

                                <circle cx="12" cy="12" r="9" />

                                <path d="M12 11v5" />

                                <path d="M12 8h.01" />
                            </svg>

                            <span>
                                Review the information before saving.
                            </span>
                        </div>

                        <div class="pa-adopter-create__buttons">

                            <a asp-controller="AdoptersAdmin"
                               asp-action="Index"
                               class="pa-adopter-create__cancel">

                                Cancel
                            </a>

                            <button type="submit"
                                    class="pa-adopter-create__submit">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">

                                    <circle cx="10" cy="8" r="4" />

                                    <path d="M3 21v-2a7 7 0 0 1 14 0v2" />

                                    <path d="M19 8v6" />

                                    <path d="M16 11h6" />
                                </svg>

                                Create Adopter

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">

                                    <path d="M5 12h14" />

                                    <path d="m13 6 6 6-6 6" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </section>

        <aside class="pa-adopter-create__sidebar"
               aria-label="Profile information">

            <div class="pa-adopter-create__guide">

                <div class="pa-adopter-create__guide-top">

                    <span class="pa-adopter-create__guide-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.7"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" />

                            <path d="m9 12 2 2 4-4" />
                        </svg>
                    </span>

                    <span class="pa-adopter-create__guide-label">
                        GOOD TO KNOW
                    </span>
                </div>

                <h2>
                    A well-organized
                    <span>adopter record.</span>
                </h2>

                <p class="pa-adopter-create__guide-description">
                    Keep essential adopter information
                    clear and accessible for administration.
                </p>

                <div class="pa-adopter-create__guide-list">

                    <div class="pa-adopter-create__guide-item">

                        <span class="pa-adopter-create__guide-check">
                            ✓
                        </span>

                        <div>
                            <strong>Contact information</strong>

                            <p>
                                Store the adopter's name and
                                available contact details.
                            </p>
                        </div>
                    </div>

                    <div class="pa-adopter-create__guide-item">

                        <span class="pa-adopter-create__guide-check">
                            ✓
                        </span>

                        <div>
                            <strong>Administrative notes</strong>

                            <p>
                                Record relevant information
                                for future reference.
                            </p>
                        </div>
                    </div>

                    <div class="pa-adopter-create__guide-item">

                        <span class="pa-adopter-create__guide-check">
                            ✓
                        </span>

                        <div>
                            <strong>Editable profile</strong>

                            <p>
                                Update adopter details through
                                the administration workspace.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pa-adopter-create__notice">

                <div class="pa-adopter-create__notice-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <circle cx="12" cy="12" r="9" />

                        <path d="M12 11v5" />

                        <path d="M12 8h.01" />
                    </svg>
                </div>

                <div>
                    <h3>
                        Profile only
                    </h3>

                    <p>
                        Creating an adopter here does not
                        automatically create a login account.
                        User registration is handled separately.
                    </p>
                </div>
            </div>
        </aside>
    </div>
</div>

@section Styles {
    <style>
        .pa-adopter-create {
            width: 100%;
            max-width: 1350px;
            margin: 0 auto 50px;
        }

        .pa-adopter-create__breadcrumb {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 11px;
            margin-bottom: 24px;
            color: #8b988d;
            font-size: 0.83rem;
        }

            .pa-adopter-create__breadcrumb a {
                color: #637a69;
                text-decoration: none;
                transition: color 200ms ease;
            }

                .pa-adopter-create__breadcrumb a:hover {
                    color: #c8914e;
                }

                .pa-adopter-create__breadcrumb a:focus-visible,
                .pa-adopter-create__back:focus-visible,
                .pa-adopter-create__cancel:focus-visible,
                .pa-adopter-create__submit:focus-visible {
                    outline: 3px solid #c8914e;
                    outline-offset: 4px;
                }

            .pa-adopter-create__breadcrumb [aria-current="page"] {
                color: #173d32;
                font-weight: 700;
            }

        .pa-adopter-create__hero {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 295px;
            padding: clamp(30px, 4.5vw, 62px);
            margin-bottom: 30px;
            overflow: hidden;
            isolation: isolate;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 28px;
            background: radial-gradient( circle at 85% 50%, rgba(116, 168, 125, 0.28), transparent 34% ), linear-gradient( 125deg, #173d32, #245847 72%, #315f48 );
            box-shadow: 0 22px 48px rgba(23, 61, 50, 0.15);
        }

        .pa-adopter-create__hero-glow {
            position: absolute;
            right: -90px;
            bottom: -180px;
            z-index: -1;
            width: 430px;
            height: 430px;
            border-radius: 50%;
            background: rgba(244, 197, 122, 0.12);
            filter: blur(55px);
        }

        .pa-adopter-create__hero-content {
            position: relative;
            z-index: 2;
            max-width: 680px;
            animation: pa-create-enter 650ms ease both;
        }

        .pa-adopter-create__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            color: #f4c57a;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.15em;
        }

        .pa-adopter-create__eyebrow-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #f4c57a;
            box-shadow: 0 0 0 5px rgba(244, 197, 122, 0.13);
        }

        .pa-adopter-create__hero-title {
            margin: 0;
            color: #fff;
            font-family: "Fraunces", Georgia, serif;
            font-size: clamp(2.3rem, 4vw, 3.8rem);
            font-weight: 600;
            line-height: 1.15;
            letter-spacing: -0.055em;
        }

            .pa-adopter-create__hero-title span {
                display: block;
                color: #f4c57a;
            }

        .pa-adopter-create__hero-description {
            max-width: 530px;
            margin: 19px 0 25px;
            color: rgba(255, 255, 255, 0.82);
            font-size: 0.96rem;
            line-height: 1.8;
        }

        .pa-adopter-create__back {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: #fff;
            font-size: 0.85rem;
            font-weight: 700;
            text-decoration: none;
            transition: gap 220ms ease, color 220ms ease;
        }

            .pa-adopter-create__back svg {
                width: 19px;
                height: 19px;
            }

            .pa-adopter-create__back:hover {
                gap: 15px;
                color: #f4c57a;
            }

        .pa-adopter-create__hero-art {
            position: relative;
            display: grid;
            width: 260px;
            height: 260px;
            flex-shrink: 0;
            place-items: center;
            margin-right: 35px;
            animation: pa-create-float 6s ease-in-out infinite;
        }

        .pa-adopter-create__art-ring {
            position: absolute;
            border: 1px solid rgba(244, 197, 122, 0.23);
            border-radius: 50%;
        }

        .pa-adopter-create__art-ring--outer {
            inset: 0;
        }

        .pa-adopter-create__art-ring--inner {
            inset: 35px;
            background: rgba(255, 255, 255, 0.035);
        }

        .pa-adopter-create__art-center {
            display: grid;
            width: 122px;
            height: 122px;
            place-items: center;
            border: 1px solid rgba(244, 197, 122, 0.28);
            border-radius: 37px;
            background: rgba(244, 197, 122, 0.14);
            color: #f4c57a;
            backdrop-filter: blur(12px);
            transform: rotate(-7deg);
        }

            .pa-adopter-create__art-center svg {
                width: 59px;
                height: 59px;
                transform: rotate(7deg);
            }

        .pa-adopter-create__art-spark {
            position: absolute;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #f4c57a;
            box-shadow: 0 0 18px rgba(244, 197, 122, 0.5);
        }

        .pa-adopter-create__art-spark--one {
            top: 25px;
            right: 55px;
        }

        .pa-adopter-create__art-spark--two {
            bottom: 45px;
            left: 20px;
            width: 5px;
            height: 5px;
        }

        .pa-adopter-create__layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 325px;
            align-items: start;
            gap: 25px;
        }

        .pa-adopter-create__main,
        .pa-adopter-create__sidebar {
            min-width: 0;
        }

        .pa-adopter-create__card {
            padding: clamp(24px, 3.4vw, 44px);
            border: 1px solid #e4ebe2;
            border-radius: 25px;
            background: #fffefa;
            box-shadow: 0 15px 45px rgba(23, 61, 50, 0.055);
        }

        .pa-adopter-create__card-heading {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
        }

        .pa-adopter-create__card-eyebrow {
            display: block;
            margin-bottom: 11px;
            color: #ab7944;
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.15em;
        }

        .pa-adopter-create__card-heading h2 {
            margin: 0 0 9px;
            color: #173d32;
            font-family: "Fraunces", Georgia, serif;
            font-size: clamp(1.65rem, 2.4vw, 2.2rem);
            letter-spacing: -0.04em;
        }

        .pa-adopter-create__card-heading p {
            margin: 0;
            color: #7a887d;
            font-size: 0.88rem;
            line-height: 1.7;
        }

        .pa-adopter-create__card-icon {
            display: grid;
            width: 49px;
            height: 49px;
            flex-shrink: 0;
            place-items: center;
            border: 1px solid #dce9dc;
            border-radius: 15px;
            background: #edf5ec;
            color: #245847;
        }

            .pa-adopter-create__card-icon svg {
                width: 24px;
                height: 24px;
            }

        .pa-adopter-create__card-divider {
            height: 1px;
            margin: 29px 0 33px;
            background: #e6ece4;
        }

        .pa-adopter-create__actions {
            margin-top: 38px;
            padding-top: 26px;
            border-top: 1px solid #e4ebe2;
        }

        .pa-adopter-create__actions-info {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 20px;
            color: #829085;
            font-size: 0.8rem;
        }

            .pa-adopter-create__actions-info svg {
                width: 17px;
                height: 17px;
                flex-shrink: 0;
                color: #77977d;
            }

        .pa-adopter-create__buttons {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 12px;
        }

        .pa-adopter-create__cancel,
        .pa-adopter-create__submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 11px;
            min-height: 51px;
            padding: 13px 22px;
            border-radius: 13px;
            font-size: 0.87rem;
            font-weight: 800;
            text-decoration: none;
            transition: transform 230ms ease, background-color 230ms ease, border-color 230ms ease, box-shadow 230ms ease;
        }

        .pa-adopter-create__cancel {
            border: 1px solid #dbe5da;
            background: #fff;
            color: #53695b;
        }

            .pa-adopter-create__cancel:hover {
                border-color: #adbfaf;
                background: #f1f6f0;
                color: #173d32;
            }

        .pa-adopter-create__submit {
            border: 1px solid #173d32;
            background: linear-gradient(135deg, #245847, #173d32);
            box-shadow: 0 10px 23px rgba(23, 61, 50, 0.15);
            color: #fff;
            cursor: pointer;
        }

            .pa-adopter-create__submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 16px 29px rgba(23, 61, 50, 0.23);
            }

            .pa-adopter-create__submit svg {
                width: 18px;
                height: 18px;
            }

        .pa-adopter-create__sidebar {
            display: grid;
            gap: 20px;
        }

        .pa-adopter-create__guide {
            position: relative;
            overflow: hidden;
            padding: 29px;
            border: 1px solid #e5e8dd;
            border-radius: 23px;
            background: radial-gradient( circle at top right, rgba(244, 197, 122, 0.15), transparent 45% ), #fbfaf4;
        }

        .pa-adopter-create__guide-top {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 25px;
        }

        .pa-adopter-create__guide-icon {
            display: grid;
            width: 39px;
            height: 39px;
            place-items: center;
            border-radius: 12px;
            background: #e4efe3;
            color: #245847;
        }

            .pa-adopter-create__guide-icon svg {
                width: 20px;
                height: 20px;
            }

        .pa-adopter-create__guide-label {
            color: #9b784b;
            font-size: 0.69rem;
            font-weight: 800;
            letter-spacing: 0.13em;
        }

        .pa-adopter-create__guide h2 {
            margin: 0;
            color: #173d32;
            font-family: "Fraunces", Georgia, serif;
            font-size: 1.75rem;
            line-height: 1.25;
            letter-spacing: -0.04em;
        }

            .pa-adopter-create__guide h2 span {
                color: #c8914e;
            }

        .pa-adopter-create__guide-description {
            margin: 15px 0 0;
            color: #758377;
            font-size: 0.84rem;
            line-height: 1.8;
        }

        .pa-adopter-create__guide-list {
            display: grid;
            gap: 24px;
            margin-top: 30px;
        }

        .pa-adopter-create__guide-item {
            display: flex;
            align-items: flex-start;
            gap: 11px;
        }

        .pa-adopter-create__guide-check {
            display: grid;
            width: 25px;
            height: 25px;
            flex-shrink: 0;
            place-items: center;
            border-radius: 50%;
            background: #e1eddf;
            color: #245847;
            font-size: 0.84rem;
            font-weight: 800;
        }

        .pa-adopter-create__guide-item strong {
            display: block;
            margin-bottom: 5px;
            color: #284735;
            font-size: 0.83rem;
        }

        .pa-adopter-create__guide-item p {
            margin: 0;
            color: #7a887d;
            font-size: 0.78rem;
            line-height: 1.7;
        }

        .pa-adopter-create__notice {
            display: flex;
            align-items: flex-start;
            gap: 13px;
            padding: 23px;
            border: 1px solid #dfe9de;
            border-radius: 20px;
            background: #eff5ed;
        }

        .pa-adopter-create__notice-icon {
            display: grid;
            width: 37px;
            height: 37px;
            flex-shrink: 0;
            place-items: center;
            border-radius: 12px;
            background: #deebdb;
            color: #245847;
        }

            .pa-adopter-create__notice-icon svg {
                width: 20px;
                height: 20px;
            }

        .pa-adopter-create__notice h3 {
            margin: 0 0 7px;
            color: #244d35;
            font-size: 0.9rem;
            font-weight: 800;
        }

        .pa-adopter-create__notice p {
            margin: 0;
            color: #667b69;
            font-size: 0.79rem;
            line-height: 1.75;
        }

        @@keyframes pa-create-enter {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes pa-create-float {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        @@media (max-width: 1199.98px) {
            .pa-adopter-create__layout {
                grid-template-columns: minmax(0, 1fr) 280px;
            }

            .pa-adopter-create__guide {
                padding: 23px;
            }

            .pa-adopter-create__hero-art {
                margin-right: 0;
            }
        }

        @@media (max-width: 991.98px) {
            .pa-adopter-create__layout {
                grid-template-columns: 1fr;
            }

            .pa-adopter-create__sidebar {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                align-items: start;
            }

            .pa-adopter-create__hero-art {
                width: 205px;
                height: 205px;
            }

            .pa-adopter-create__art-center {
                width: 95px;
                height: 95px;
                border-radius: 27px;
            }

                .pa-adopter-create__art-center svg {
                    width: 48px;
                    height: 48px;
                }
        }

        @@media (max-width: 767.98px) {
            .pa-adopter-create {
                margin-bottom: 28px;
            }

            .pa-adopter-create__hero {
                min-height: auto;
                padding: 32px;
                border-radius: 22px;
            }

            .pa-adopter-create__hero-art {
                position: absolute;
                right: -85px;
                opacity: 0.23;
                pointer-events: none;
            }

            .pa-adopter-create__hero-description {
                max-width: 460px;
            }

            .pa-adopter-create__card {
                padding: 25px;
                border-radius: 21px;
            }

            .pa-adopter-create__sidebar {
                grid-template-columns: 1fr;
            }
